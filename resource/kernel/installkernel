echo "deb [arch=amd64 signed-by=/etc/apt/keyrings/liquorix.gpg] https://liquorix.net/debian $(kernelCodename) main" >/etc/apt/sources.list.d/liquorix-kernel.list

kernelAptInstall liquorix linux-image-liquorix-amd64 linux-headers-liquorix-amd64

if [[ -n $(dpkg --list | grep linux-image | grep liquorix) ]]; then
  cleanOldKernels "liquorix"
  verifyGrubAndReboot "Liquorix kernel"
else
  echo -e "${WHITE}[ ${RED}✕ ${WHITE}]\c" && echo -e "\t${WHITE}Liquorix kernel ${RED}Install Failed${cRES}"

  dpkg --list | awk '{print $2}' | grep liquorix | while read line; do
  apt autoremove --purge -y $line
  done

  rm -rf /etc/apt/sources.list.d/liquorix-kernel.list
  rm -rf /etc/apt/keyrings/liquorix.gpg
  echo -e "${WHITE}[ ${YELLOW}! ${WHITE}]\c" && echo -e "\t${YELLOW}Clear up & Exit${cRES}"
  exit 1
fi
fi
}



ensureBackportsRepo(){
local codename mirror
codename=$(kernelCodename)
if ! grep -rEq "[[:space:]]${codename}-backports([[:space:]]|$)" /etc/apt/sources.list /etc/apt/sources.list.d/ 2>/dev/null; then
  # Support deb [option=val] http://... format by stripping brackets before extracting URL
  mirror=$(awk '
    /^deb / && /debian/ && !/security/ && !/backports/ {
      line = $0
      sub(/^deb +(\[[^]]+\] +)?/, "", line)
      split(line, parts, " ")
      if (parts[1] ~ /^https?:\/\//) {
        print parts[1]
        exit
      }
    }
  ' /etc/apt/sources.list /etc/apt/sources.list.d/*.list 2>/dev/null)
  [[ -z $mirror ]] && mirror="https://deb.debian.org/debian"
  if [[ $codename = "bookworm" || $codename = "trixie" ]]; then
    echo "deb $mirror ${codename}-backports main contrib non-free non-free-firmware" >/etc/apt/sources.list.d/debian-backports.list
  else
    echo "deb $mirror ${codename}-backports main contrib non-free" >/etc/apt/sources.list.d/debian-backports.list
  fi
fi
}

installBackports(){
echo -e "${WHITE}[...]\c" && echo -e "\t${WHITE}Debian Backports kernel${cRES}\r\c"
if [[ $architecture != "amd64" ]]; then
  echo -e "${RED}only work on x86_64${cRES}"
elif [[ $architecture == "amd64" ]]; then
local codename
codename=$(kernelCodename)
ensureBackportsRepo
kernelDropForeignRepos "backports"
apt-get update || true
apt-get install -y -t "${codename}-backports" linux-image-amd64 linux-headers-amd64 || \
  apt-get install -y -t "${codename}-backports" linux-image-amd64

if dpkg --list | awk '$2 ~ /^linux-image/ {print $0}' | grep -Eq 'bpo|backports'; then
  cleanOldKernels "bpo"
  verifyGrubAndReboot "Debian Backports kernel"
else
  echo -e "${WHITE}[ ${RED}✕ ${WHITE}]\c" && echo -e "\t${WHITE}Debian Backports kernel ${RED}Install Failed${cRES}"
  echo -e "${WHITE}[ ${YELLOW}! ${WHITE}]\c" && echo -e "\t${YELLOW}Clear up & Exit${cRES}"
  exit 1
fi
fi
}



get_cpu_arch_level
while true; do
echo -e "${BLUE}-------------------------------------------------- ${cRES}"
echo -e "${GREEN}Current Kernel:     ${YELLOW}$(uname -r)${cRES}"
echo -e "${GREEN}Debian Codename:    ${YELLOW}$(kernelCodename)${cRES}"
echo -e "${GREEN}CPU Arch / Level:   ${YELLOW}${architecture} (${CPU_LEVEL})${cRES}"
echo -e "${BLUE}-------------------------------------------------- ${cRES}"
echo -e "${GREEN}======================================== ${cRES}"
echo -e "${GREEN}[1]: Install Zabbly kernel and reboot ${cRES}"
echo -e "${GREEN}[2]: Install XanMod kernel ($CPU_LEVEL) and reboot ${cRES}"
echo -e "${GREEN}[3]: Install Liquorix kernel and reboot ${cRES}"
echo -e "${GREEN}[4]: Install Debian Backports kernel and reboot ${cRES}"
echo -e "${GREEN}[0]: Back / Cancel ${cRES}"
echo -e "${GREEN}======================================== ${cRES}"
read -s -n 1 kernelSwitch
echo

case $kernelSwitch in
  0|"")
      echo -e "${YELLOW}Cancelled${cRES}"
      exit 0
    ;;
  "1")
      installZabbly
      break
    ;;
  "2")
      installXanMod
      break
    ;;
  "3")
      installLiquorix
      break
    ;;
  "4")
      installBackports
      break
    ;;
  *)
      echo -e "${RED}Wrong number${cRES}"
    ;;
esac
done
