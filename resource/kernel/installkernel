#!/bin/bash
RED='\E[1;31m'
GREEN='\E[1;32m'
YELLOW='\E[1;33m'
BLUE='\E[1;34m'
PURPLE='\E[1;35m'
CYAN='\E[1;36m'
WHITE='\E[1;37m'
cRES='\E[0m'
architecture=$(dpkg --print-architecture)
export DEBIAN_FRONTEND=noninteractive

if [[ $architecture != "amd64" ]]; then
  echo -e "${RED}only work on x86_64${cRES}"
  exit 1
fi
cat << EOF >/etc/apt/apt.conf.d/01InstallLess
APT::Get::Assume-Yes "true";
APT::Install-Recommends "false";
APT::Install-Suggests "false";
EOF
cat << EOF >/etc/apt/apt.conf.d/71debconf
Dpkg::Options {
   "--force-confdef";
   "--force-confold";
};
EOF

wait_for_dpkg_lock(){
  local waited=0
  if ! command -v fuser >/dev/null 2>&1; then
    echo -e "${RED}Error: fuser is required to inspect apt/dpkg locks; refusing to continue.${cRES}" >&2
    return 1
  fi
  while fuser /var/lib/dpkg/lock /var/lib/dpkg/lock-frontend /var/lib/apt/lists/lock /var/cache/apt/archives/lock >/dev/null 2>&1; do
    if [[ $waited -ge 120 ]]; then
      echo -e "${RED}Error: apt/dpkg lock held for > 120s, aborting to prevent database corruption.${cRES}" >&2
      return 1
    fi
    sleep 2
    waited=$((waited + 2))
  done
  return 0
}

wait_for_dpkg_lock || exit 1


apt-key del 2FB2CD80 >/dev/null 2>&1
apt-key del 33F8024D >/dev/null 2>&1
apt-key del E734E623 >/dev/null 2>&1
# Safely clean leftover third-party kernel entries line-by-line without deleting official source lists.
for src in /etc/apt/sources.list /etc/apt/sources.list.d/*; do
  [[ -f $src ]] || continue
  if grep -Eq 'xanmod\.org|liquorix\.net|pkgs\.zabbly\.com' "$src" 2>/dev/null; then
    sed -i -E '/xanmod\.org|liquorix\.net|pkgs\.zabbly\.com/d' "$src" 2>/dev/null || true
    [[ $src != "/etc/apt/sources.list" && ! -s $src ]] && rm -f -- "$src"
  fi
done
rm -f /etc/apt/keyrings/xanmod* \
      /etc/apt/keyrings/liquorix* \
      /etc/apt/keyrings/zabbly* \
      /usr/share/keyrings/xanmod* \
      /etc/apt/trusted.gpg.d/liquorix* \
      /etc/apt/trusted.gpg.d/xanmod*

[[ -n $(dpkg -l | awk '{print$2}' | grep '^os-prober') ]] && {
  wait_for_dpkg_lock || exit 1
  apt remove --purge os-prober || exit 1
}

mkdir -p /boot/grub /etc/apt/keyrings
wait_for_dpkg_lock || exit 1
dpkg --configure -a

unset aptPKG
command -v gpg >/dev/null || aptPKG+=(gnupg)
command -v curl >/dev/null || aptPKG+=(curl)
command -v wget >/dev/null || aptPKG+=(wget)
command -v python3 >/dev/null || aptPKG+=(python3)
command -v crontab >/dev/null || aptPKG+=(cron)
dpkg -l ca-certificates 2>/dev/null | grep -q '^ii' || aptPKG+=(ca-certificates)
[[ -z $(which 'update-grub') ]] && [[ -d "/sys/firmware/efi" ]] && aptPKG+=(grub-efi)
[[ -z $(which 'update-grub') ]] && [[ ! -d "/sys/firmware/efi" ]] && aptPKG+=(grub2-common)
if [[ -n $aptPKG ]]; then
  wait_for_dpkg_lock || exit 1
  apt-get update || apt-get update -o Dir::Etc::sourceparts=/dev/null || exit 1
  wait_for_dpkg_lock || exit 1
  apt-get install -y "${aptPKG[@]}" || exit 1
fi
systemctl enable --now cron >/dev/null 2>&1 || true



mkdir -p /opt/de_GWD
cat << "EOF" >/etc/rc_kernel.local
#!/bin/bash
PATH='/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin'

sed -i '/net.ipv4.tcp_congestion_control/d' /etc/sysctl.conf
sed -i "/net.core.default_qdisc/d" /etc/sysctl.conf
echo "net.ipv4.tcp_congestion_control = bbr" >>/etc/sysctl.conf
echo "net.core.default_qdisc = cake" >>/etc/sysctl.conf
sysctl -p >/dev/null 2>&1

if ! command -v fuser >/dev/null 2>&1; then
  echo "fuser is required to inspect apt/dpkg locks" >&2
  exit 1
fi
waited=0
while fuser /var/lib/dpkg/lock /var/lib/dpkg/lock-frontend /var/lib/apt/lists/lock /var/cache/apt/archives/lock >/dev/null 2>&1; do
  if [[ $waited -ge 120 ]]; then
    echo "apt/dpkg lock held for > 120s" >&2
    exit 1
  fi
  sleep 2
  waited=$((waited + 2))
done
dpkg --configure -a

dpkg --list | grep linux-image | awk '{print $2}' | grep -Fv $(uname -r) | while read line; do
apt autoremove --purge -y $line
done

dpkg --list | grep linux-headers | awk '{print $2}' | grep -Fv $(uname -r) | while read line; do
apt autoremove --purge -y $line
done
EOF
chmod +x /etc/rc_kernel.local

if command -v crontab >/dev/null; then
  crontab -l 2>/dev/null >/tmp/now.cron || true
  sed -i '/\/opt\/de_GWD\/clearKernel/d' /tmp/now.cron
  sed -i '/\/etc\/rc_kernel.local/d' /tmp/now.cron
  echo '@reboot sleep 15 && /etc/rc_kernel.local' >>/tmp/now.cron
  crontab /tmp/now.cron
  rm -rf /tmp/now.cron
else
  printf '%s\n' '@reboot root sleep 15 && /etc/rc_kernel.local' >/etc/cron.d/de_gwd_kernel
fi




cleanOldKernels() {
  local kernel_type=$1
  
if [[ $kernel_type == "zabbly" ]]; then
  rm -f /etc/apt/sources.list.d/*xanmod* /etc/apt/keyrings/xanmod* /etc/apt/sources.list.d/*liquorix* /etc/apt/keyrings/liquorix*
elif [[ $kernel_type == "xanmod" ]]; then
  rm -f /etc/apt/sources.list.d/*zabbly* /etc/apt/keyrings/zabbly* /etc/apt/sources.list.d/*liquorix* /etc/apt/keyrings/liquorix*
elif [[ $kernel_type == "liquorix" ]]; then
  rm -f /etc/apt/sources.list.d/*zabbly* /etc/apt/keyrings/zabbly* /etc/apt/sources.list.d/*xanmod* /etc/apt/keyrings/xanmod*
elif [[ $kernel_type == "bpo" || $kernel_type == "backports" ]]; then
  rm -f /etc/apt/sources.list.d/*zabbly* /etc/apt/keyrings/zabbly* /etc/apt/sources.list.d/*xanmod* /etc/apt/keyrings/xanmod* /etc/apt/sources.list.d/*liquorix* /etc/apt/keyrings/liquorix*
fi
  
  # Keep running/old kernels until after reboot as safety fallback.
  # /etc/rc_kernel.local automatically cleans old kernels on successful boot.
  update-initramfs -u -k all 2>/dev/null || true
  update-grub 2>/dev/null || true
}

verifyGrubAndReboot(){
  local kernel_name=$1
  update-initramfs -u -k all
  if ! update-grub; then
    echo -e "${RED}Error: update-grub failed! Aborting reboot to prevent boot failure.${cRES}"
    return 1
  fi
  if [[ ! -s /boot/grub/grub.cfg ]] || ! grep -q 'menuentry' /boot/grub/grub.cfg; then
    echo -e "${RED}Error: /boot/grub/grub.cfg is missing or has no boot entries! Aborting reboot.${cRES}"
    return 1
  fi
  echo -e "${WHITE}[ ${GREEN}✓ ${WHITE}]\c" && echo -e "\t${WHITE}$kernel_name ${GREEN}Installed${cRES}"
  echo -e "${YELLOW}System will reboot in 5 seconds (Press Ctrl+C to cancel)...${cRES}"
  sleep 5
  reboot
  exit 0
}



kernelCodename(){
. /etc/os-release
printf '%s\n' "${VERSION_CODENAME:-bookworm}"
}

# Remove any apt source entry that mentions these hosts line-by-line without deleting files.
kernelDropRepoHost(){
local host=$1 f
for f in /etc/apt/sources.list /etc/apt/sources.list.d/*; do
  [[ -f $f ]] || continue
  if grep -Fq "$host" "$f" 2>/dev/null; then
    local tmp
    tmp=$(mktemp "${f}.XXXXXX") || return 1
    if ! awk -v needle="$host" 'index($0, needle) == 0' "$f" >"$tmp"; then
      rm -f -- "$tmp"
      return 1
    fi
    chmod --reference="$f" "$tmp" 2>/dev/null || true
    chown --reference="$f" "$tmp" 2>/dev/null || true
    if ! mv -f -- "$tmp" "$f"; then
      rm -f -- "$tmp"
      return 1
    fi
    [[ $f != "/etc/apt/sources.list" && ! -s $f ]] && rm -f -- "$f"
  fi
done
}

kernelDropForeignRepos(){
local keep=${1-}
[[ $keep = xanmod ]] || kernelDropRepoHost xanmod.org
[[ $keep = liquorix ]] || kernelDropRepoHost liquorix.net
[[ $keep = zabbly ]] || kernelDropRepoHost pkgs.zabbly.com
}

# Unsigned leftover kernel repos must not abort installing the selected kernel.
kernelAptInstall(){
local keep=$1
shift
kernelDropForeignRepos "$keep" || return 1
wait_for_dpkg_lock || return 1
apt-get update || return 1
wait_for_dpkg_lock || return 1
apt-get install -y "$@"
}

# ASCII-armored keys are dearmored; binary keyrings are copied as-is.
kernelInstallKeyring(){
local src=$1 dest=$2
[[ -s $src ]] || return 1
command -v gpg >/dev/null || return 1
mkdir -p -- "$(dirname -- "$dest")"
if grep -q 'BEGIN PGP' "$src" 2>/dev/null; then
  gpg --batch --yes --dearmor -o "$dest" "$src" || return 1
else
  cp -- "$src" "$dest" || return 1
fi
chmod 0644 -- "$dest"
}

