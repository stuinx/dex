get_cpu_arch_level() {
    local flags_line
    flags_line=$(awk -F: '/^flags/{print $2; exit}' /proc/cpuinfo)

    local has_all
    has_all() {
        local -n req=$1
        local r
        for r in "${req[@]}"; do
            [[ " $flags_line " == *" $r "* ]]
        done
    }

    local -a v3=(avx avx2 bmi1 bmi2 f16c fma abm movbe xsave)

    CPU_LEVEL="v2"

    if has_all v3; then
        CPU_LEVEL="v3"
    fi
}



