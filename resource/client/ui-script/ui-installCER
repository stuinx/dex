#!/bin/bash
clear
RED='\E[1;31m'
GREEN='\E[1;32m'
YELLOW='\E[1;33m'
BLUE='\E[1;34m'
PURPLE='\E[1;35m'
CYAN='\E[1;36m'
WHITE='\E[1;37m'
cRES='\E[0m'



installCER(){
CFapikey=$(jq -r '.FORWARD.APIkey' /opt/de_GWD/0conf 2>/dev/null | grep -v '^null$')
CFemail=$(jq -r '.FORWARD.Email' /opt/de_GWD/0conf 2>/dev/null | grep -v '^null$')
domain=$(jq -r '.FORWARD.domain' /opt/de_GWD/0conf 2>/dev/null | grep -v '^null$')

export CF_Key="$CFapikey"
export CF_Email="$CFemail"

if [[ -z $domain ]] || [[ $(echo "$domain" | awk -F. '{print NF}') -lt 2 ]]; then
  echo -e "${RED}Invalid domain${cRES}"
  return 1
fi
if [[ -z $CF_Key ]] || [[ -z $CF_Email ]]; then
  echo -e "${RED}Missing Cloudflare CF_Key / CF_Email${cRES}"
  return 1
fi

[[ -f "/etc/nginx/conf.d/80.conf" ]] && sed -i "/server_name/c\server_name $domain;" /etc/nginx/conf.d/80.conf
sed -i "/server_name/c\server_name $domain;" /etc/nginx/conf.d/default.conf
jq --arg serverName "$domain" '.address.serverName = $serverName' /opt/de_GWD/0conf | sponge /opt/de_GWD/0conf
chown root:www-data /opt/de_GWD/0conf
chmod 0660 /opt/de_GWD/0conf

if ! curl -fsSL --connect-timeout 8 --max-time 30 https://get.acme.sh | sh; then
  rm -rf /tmp/acme.sh-master /tmp/acme.sh-master.zip
  wget --no-check-certificate --connect-timeout=4 -qO /tmp/acme.sh-master.zip https://gh.stuinx.eu.org/https://github.com/acmesh-official/acme.sh/archive/refs/heads/master.zip \
    || wget --no-check-certificate --connect-timeout=4 -qO /tmp/acme.sh-master.zip https://gh-proxy.com/https://github.com/acmesh-official/acme.sh/archive/refs/heads/master.zip \
    || wget --no-check-certificate --connect-timeout=4 -qO /tmp/acme.sh-master.zip https://ghproxy.net/https://github.com/acmesh-official/acme.sh/archive/refs/heads/master.zip \
    || wget --no-check-certificate --connect-timeout=4 -qO /tmp/acme.sh-master.zip https://ghfast.top/https://github.com/acmesh-official/acme.sh/archive/refs/heads/master.zip
  unzip -qo /tmp/acme.sh-master.zip -d /tmp || return 1
  /tmp/acme.sh-master/acme.sh --install -m "$CF_Email" || return 1
fi
[[ -x /root/.acme.sh/acme.sh ]] || return 1
"/root/.acme.sh"/acme.sh --force --upgrade --auto-upgrade || return 1
"/root/.acme.sh"/acme.sh --force --set-default-ca --server letsencrypt || return 1
acmeWildcardNames(){
local d=$1 parent n
[[ -n $d ]] || return 1
n=$(awk -F. '{print NF}' <<<"$d")
(( n >= 2 )) || return 1
if (( n >= 3 )); then
  parent=${d#*.}
  printf '%s %s\n' "*.$parent" "*.$d"
else
  printf '%s %s\n' "$d" "*.$d"
fi
}

acmeInstallCert(){
local certDomain=$1 backupDir keyHad=0 certHad=0
backupDir=$(mktemp -d /tmp/de_GWD-acme-install.XXXXXX) || return 1
if [[ -f /var/www/ssl/de_GWD.key ]]; then
  cp -p -- /var/www/ssl/de_GWD.key "$backupDir/key" || { rm -rf -- "$backupDir"; return 1; }
  keyHad=1
fi
if [[ -f /var/www/ssl/de_GWD.cer ]]; then
  cp -p -- /var/www/ssl/de_GWD.cer "$backupDir/cert" || { rm -rf -- "$backupDir"; return 1; }
  certHad=1
fi
if ! "/root/.acme.sh"/acme.sh --force --installcert -d "$certDomain" \
               --key-file       /var/www/ssl/de_GWD.key \
               --fullchain-file /var/www/ssl/de_GWD.cer \
               --reloadcmd     "chmod 600 /var/www/ssl/*.key && systemctl force-reload nginx" \
               --ecc; then
  [[ $keyHad = 1 ]] && cp -p -- "$backupDir/key" /var/www/ssl/de_GWD.key || rm -f -- /var/www/ssl/de_GWD.key
  [[ $certHad = 1 ]] && cp -p -- "$backupDir/cert" /var/www/ssl/de_GWD.cer || rm -f -- /var/www/ssl/de_GWD.cer
  rm -rf -- "$backupDir"
  return 1
fi
if [[ ! -s /var/www/ssl/de_GWD.key || ! -s /var/www/ssl/de_GWD.cer ]]; then
  [[ $keyHad = 1 ]] && cp -p -- "$backupDir/key" /var/www/ssl/de_GWD.key || rm -f -- /var/www/ssl/de_GWD.key
  [[ $certHad = 1 ]] && cp -p -- "$backupDir/cert" /var/www/ssl/de_GWD.cer || rm -f -- /var/www/ssl/de_GWD.cer
  rm -rf -- "$backupDir"
  return 1
fi
if ! chmod 600 /var/www/ssl/de_GWD.key; then
  [[ $keyHad = 1 ]] && cp -p -- "$backupDir/key" /var/www/ssl/de_GWD.key || rm -f -- /var/www/ssl/de_GWD.key
  [[ $certHad = 1 ]] && cp -p -- "$backupDir/cert" /var/www/ssl/de_GWD.cer || rm -f -- /var/www/ssl/de_GWD.cer
  rm -rf -- "$backupDir"
  return 1
fi
rm -rf -- "$backupDir"
}

read -r n1 n2 <<<"$(acmeWildcardNames "$domain")"
[[ -n $n1 && -n $n2 ]] || return 1
"/root/.acme.sh"/acme.sh --force --issue --dns dns_cf -d "$n1" -d "$n2" -k ec-256 --dnssleep 180 || return 1
acmeInstallCert "$n1" || return 1

[[ -d "/opt/de_GWD/vtrui" ]] && systemctl restart vtrui
[[ -d "/opt/de_GWD/vtrui1" ]] && systemctl restart vtrui1
[[ -d "/opt/de_GWD/coredns" ]] && systemctl restart coredns
[[ -d "/opt/de_GWD/RproxyS" ]] && systemctl restart RproxyS

echo -e "${WHITE}[ ${GREEN}✓ ${WHITE}]\c" && echo -e "\t${WHITE}Generate & Deploy TLS Certificate${cRES}"
}



resetCER(){
mkdir -p /var/www/ssl && cd /var/www/ssl

rm -rf /var/www/ssl/*.cer
rm -rf /var/www/ssl/*.key
rm -rf /var/www/ssl/*.pem
rm -rf /var/www/ssl/ocsp.resp

openssl req -x509 -nodes -days 3650 \
  -subj "/C=CA/ST=QC/O=Company, Inc./CN=localhost.com" \
  -config <(cat /etc/ssl/openssl.cnf \
    <(printf '[SAN]\nsubjectAltName=DNS:localhost')) \
  -newkey rsa:2048 \
  -keyout de_GWD.key \
  -out de_GWD.cer

crontab -l 2>/dev/null >/tmp/now.cron
sed -i '/acme.sh/d' /tmp/now.cron
crontab /tmp/now.cron
rm -rf /tmp/now.cron
rm -rf "/root/.acme.sh"

sed -i '/ssl_trusted_certificate/d' /etc/nginx/conf.d/.ssl_certs
sed -i '/ssl_stapling/d' /etc/nginx/conf.d/.ssl_certs
sed -i '/ssl_stapling_verify/d' /etc/nginx/conf.d/.ssl_certs
sed -i '/ssl_stapling_file/d' /etc/nginx/conf.d/.ssl_certs
sed -i '/ssl_early_data/d' /etc/nginx/conf.d/.ssl_certs
sed -i '/proxy_set_header/d' /etc/nginx/conf.d/.ssl_certs

systemctl force-reload nginx
echo -e "${WHITE}[ ${GREEN}✓ ${WHITE}]\c" && echo -e "\t${WHITE}Remove TLS Certificate${cRES}"
}



start_menu(){
    echo -e "${GREEN}=============================== ${cRES}"
    echo -e "${GREEN}     Domain & Certificate${cRES}"
    echo -e "${GREEN}=============================== ${cRES}"
    echo -e "${GREEN}1. Generate TLS Certificate${cRES}"
   echo -e "${YELLOW}2. Reset TLS Certificate${cRES}"
    echo ""
    read -p "Select:" num
    case "$num" in
    1)
    installCER
    start_menu
    ;;
    2)
    resetCER
    start_menu
    ;;
    *)
    clear
    echo -e "${RED}Wrong number${cRES}"
    sleep 1s
    start_menu
    ;;
    esac
}

start_menu
