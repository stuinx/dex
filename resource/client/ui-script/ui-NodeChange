#!/bin/bash
[[ ${1:-} =~ ^[0-9]+$ ]] || exit 1
node=$(jq -ce --arg index "$1" '.v2node[$index | tonumber] | select(.protocol == "vless")' /opt/de_GWD/0conf) || exit 1
address=$(jq -r '.domain' <<<"$node")
tls=$(jq -r '.tls // ""' <<<"$node")
uuid=$(jq -r '.uuid' <<<"$node")
path=$(jq -r '.path // ""' <<<"$node")
[[ $address == *:* ]] || address="$address:443"
[[ $address =~ ^([A-Za-z0-9.-]+):([0-9]{1,5})$ ]] || exit 1
domain=${BASH_REMATCH[1]}
port=$((10#${BASH_REMATCH[2]}))
(( port >= 1 && port <= 65535 )) || exit 1
[[ -n $tls ]] || tls=$domain

/opt/de_GWD/ui-V2outbound default "$address" "$tls" "$uuid" "$path" vless || exit 1
confTemp=$(mktemp /opt/de_GWD/0conf.XXXXXX) || exit 1
trap 'rm -f "$confTemp"' EXIT
cp -p /opt/de_GWD/0conf "$confTemp" || exit 1
jq -e --arg domain "$domain" --arg port "$port" --arg tls "$tls" --arg uuid "$uuid" --arg path "$path" \
  '.update.v2node={protocol:"vless",domain:$domain,port:$port,tls:$tls,uuid:$uuid,path:$path}' \
  /opt/de_GWD/0conf >"$confTemp" || exit 1
mv -f "$confTemp" /opt/de_GWD/0conf || exit 1
systemctl restart vtrui
