#!/bin/bash
RED='\E[1;31m'
GREEN='\E[1;32m'
YELLOW='\E[1;33m'
BLUE='\E[1;34m'
PURPLE='\E[1;35m'
CYAN='\E[1;36m'
WHITE='\E[1;37m'
cRES='\E[0m'



echo -e "${WHITE}[...]\c" && echo -e "\t${WHITE}Collect V2 node${cRES}\r\c"

mkdir -p /opt/de_GWD/mosdns /opt/de_GWD/nftables
tmp_domains=$(mktemp /tmp/de-gwd-domains.XXXXXX)
tmp_nodes=$(mktemp /tmp/de-gwd-nodes.XXXXXX)
tmp_nft=$(mktemp /tmp/de-gwd-v2node.XXXXXX)

node_domains=$(jq -r '.v2node[].domain' /opt/de_GWD/0conf 2>/dev/null | grep -v '^null$' | cut -d: -f1 | sort -u | sed '/^\s*$/d')

if [[ -n "$node_domains" ]]; then
  while read -r line; do
    [[ -z "$line" ]] && continue
    echo "$line" >>"$tmp_domains"
    if [[ "$line" =~ ^((25[0-5]|2[0-4][0-9]|[01]?[0-9]{0,2})\.){3}(25[0-5]|2[0-4][0-9]|[01]?[0-9]{0,2})$ ]]; then
      [[ "$line" != "127.0.0.1" ]] && echo "$line" >>"$tmp_nodes"
    else
      dig @127.0.0.1 "$line" -4p 5332 +short 2>/dev/null | grep -Eo '([0-9]{1,3}\.){3}[0-9]{1,3}' | grep -v "127.0.0.1" >>"$tmp_nodes"
    fi
  done <<< "$node_domains"
fi

if [[ -s "$tmp_nodes" ]]; then
  sort -u "$tmp_nodes" | sed '/^\s*$/d' >"${tmp_nodes}.clean"
  elements_list=$(awk '{printf "%s, ", $1}' "${tmp_nodes}.clean" | sed 's/, $//')
  cat << EOF >"$tmp_nft"
flush set ip de_GWD V2NODE
table ip de_GWD {
        set V2NODE {
                type ipv4_addr
                flags interval
                auto-merge
                elements = { $elements_list }
        }
}
EOF
  if nft -c -f "$tmp_nft" 2>/dev/null && nft -f "$tmp_nft"; then
    mv -f "$tmp_domains" /opt/de_GWD/mosdns/domains_nodes
    awk '{print $1","}' "${tmp_nodes}.clean" >/opt/de_GWD/nftables/IP_V2NODE
    cp -f "$tmp_nft" /opt/de_GWD/nftables/SET_V2NODE.nft
    chmod +x /opt/de_GWD/nftables/SET_V2NODE.nft
  else
    echo -e "${WHITE}[ ${YELLOW}! ${WHITE}]\c" && echo -e "\t${YELLOW}V2 node nft verification failed, keeping existing rules${cRES}" >&2
  fi
  rm -f "${tmp_nodes}.clean"
elif [[ -n "$node_domains" ]]; then
  echo -e "${WHITE}[ ${YELLOW}! ${WHITE}]\c" && echo -e "\t${YELLOW}DNS resolution for nodes returned empty, keeping previous node set${cRES}" >&2
else
  cat << EOF >"$tmp_nft"
flush set ip de_GWD V2NODE
table ip de_GWD {
        set V2NODE {
                type ipv4_addr
                flags interval
                auto-merge
        }
}
EOF
  nft -c -f "$tmp_nft" 2>/dev/null && nft -f "$tmp_nft" 2>/dev/null || true
  >/opt/de_GWD/mosdns/domains_nodes
  >/opt/de_GWD/nftables/IP_V2NODE
  cp -f "$tmp_nft" /opt/de_GWD/nftables/SET_V2NODE.nft
  chmod +x /opt/de_GWD/nftables/SET_V2NODE.nft
fi

rm -f "$tmp_domains" "$tmp_nodes" "$tmp_nft"

[[ $1 = "r" ]] && systemctl restart mosdns

echo -e "${WHITE}[ ${GREEN}✓ ${WHITE}]\c" && echo -e "\t${WHITE}Collect V2 node${cRES}"
