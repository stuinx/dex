#!/bin/bash

config=/opt/de_GWD/0conf
xrayConfig=/opt/de_GWD/vtrui/config.json

nodeSMcheck(){
  local tag=$1 domain port nodecheck checkNum checkName
  domain=$(jq -r --arg tag "$tag" '.outbounds[]? | select(.tag == $tag) | .settings.vnext[0].address // empty' "$xrayConfig" 2>/dev/null)
  port=$(jq -r --arg tag "$tag" '.outbounds[]? | select(.tag == $tag) | .settings.vnext[0].port // empty' "$xrayConfig" 2>/dev/null)
  [[ $port = 443 || -z $port ]] && nodecheck=$domain || nodecheck="$domain:$port"

  checkNum=$(jq -r --arg nodecheck "$nodecheck" --arg tag "$tag" --slurpfile xray "$xrayConfig" '
    ($xray[0].outbounds[]? | select(.tag == $tag)) as $out
    | [ .v2node | to_entries[]
        | select(
            (.value.domain == $nodecheck or .value.domain == ($nodecheck + ":443"))
            and .value.uuid == $out.settings.vnext[0].users[0].id
            and (.value.path // "") == ($out.streamSettings.wsSettings.path // "")
            and (.value.protocol // "vmess") == ($out.protocol // "vmess")
          )
        | .key
      ][0] // empty
  ' "$config" 2>/dev/null)
  checkName=$(jq -r --arg nodecheck "$nodecheck" --arg tag "$tag" --slurpfile xray "$xrayConfig" '
    ($xray[0].outbounds[]? | select(.tag == $tag)) as $out
    | [ .v2node[]?
        | select(
            (.domain == $nodecheck or .domain == ($nodecheck + ":443"))
            and .uuid == $out.settings.vnext[0].users[0].id
            and (.path // "") == ($out.streamSettings.wsSettings.path // "")
            and (.protocol // "vmess") == ($out.protocol // "vmess")
          )
        | .name
      ][0] // empty
  ' "$config" 2>/dev/null)

  [[ -n $checkNum ]] && echo $((checkNum + 1)) || echo 0
  [[ -n $checkName ]] && echo "$checkName" || echo '-none-'
}

for tag in nodeSMyoutube nodeSMclaude nodeSMgemini nodeSMgrok nodeSMwikipedia nodeSMreddit nodeSMgithub nodeSMdiscord nodeSMtelegram nodeSMx nodeSMopenai nodeSMapple; do
  nodeSMcheck "$tag"
done

if [[ $(jq -r '.v2nodeDIV.nodeSM.steam // empty' "$config" 2>/dev/null) = proxy ]]; then
  echo 1
  echo '默认代理'
else
  echo 0
  echo '-none-'
fi
