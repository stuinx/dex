#!/bin/bash

config=/opt/de_GWD/0conf
xrayConfig=/opt/de_GWD/vtrui/config.json

nodeSMcheck(){
  jq -r --arg tag "$1" --slurpfile xray "$xrayConfig" '
    [$xray[0].outbounds[]? | select(.tag == $tag)][0] as $out |
    ($out.settings.vnext[0].address // "") as $address |
    ($out.settings.vnext[0].port // 443 | tostring) as $port |
    [.v2node | to_entries[] | select(
      (.value.domain == ($address + ":" + $port) or ($port == "443" and .value.domain == $address))
      and .value.uuid == $out.settings.vnext[0].users[0].id
      and (.value.path // "") == ($out.streamSettings.wsSettings.path // "")
      and .value.protocol == "vless" and $out.protocol == "vless"
      and (if (.value.path // "") == "" then "" else
        (.value.tls // "" | if . == "" then $address else . end) end) == ($out.streamSettings.tlsSettings.serverName // "")
    )] |
    if length > 0 then (.[0].key + 1), (.[0].value.name // "-none-") else 0, "-none-" end
  ' "$config" 2>/dev/null
}

for tag in nodeSMyoutube nodeSMclaude nodeSMgemini nodeSMgrok nodeSMwikipedia nodeSMreddit nodeSMgithub nodeSMdiscord nodeSMtelegram nodeSMx nodeSMopenai nodeSMmetaai nodeSMapple; do
  nodeSMcheck "$tag"
done

if [[ $(jq -r '.v2nodeDIV.nodeSM.steam // empty' "$config" 2>/dev/null) = proxy ]]; then
  echo 1
  echo '默认代理'
else
  echo 0
  echo '-none-'
fi
