#!/bin/bash
set -euo pipefail

src=/opt/jellyfin/config
dest=/var/www/html/restore/Jellyfin_bak.zip
[[ -d $src ]] || exit 1
install -d -o www-data -g www-data -m 0750 "$(dirname -- "$dest")"
tmp=$(mktemp "${dest}.XXXXXX")
trap 'rm -f -- "$tmp"' EXIT
zip -r -q "$tmp" "$src" -x '/opt/jellyfin/config/transcodes/*'
chown www-data:www-data "$tmp"
chmod 0600 "$tmp"
mv -f -- "$tmp" "$dest"
trap - EXIT
