#!/bin/bash
RED='\E[1;31m'
GREEN='\E[1;32m'
YELLOW='\E[1;33m'
BLUE='\E[1;34m'
PURPLE='\E[1;35m'
CYAN='\E[1;36m'
WHITE='\E[1;37m'
cRES='\E[0m'



/opt/de_GWD/tcpTime

copy_runtime_from_repo(){
[[ -f /opt/de_GWD/.repo/geosite.dat ]] && mkdir -p /opt/de_GWD/vtrui && cp -f /opt/de_GWD/.repo/geosite.dat /opt/de_GWD/vtrui/geosite.dat
[[ -f /opt/de_GWD/.repo/geoip.dat ]] && mkdir -p /opt/de_GWD/vtrui && cp -f /opt/de_GWD/.repo/geoip.dat /opt/de_GWD/vtrui/geoip.dat
[[ -f /opt/de_GWD/.repo/99-bogus-nxdomain.china.conf ]] && mkdir -p /etc/dnsmasq.d && cp -f /opt/de_GWD/.repo/99-bogus-nxdomain.china.conf /etc/dnsmasq.d/
}

serverConnect1=$(curl -Is -m 5 google.com | grep 'HTTP')
serverConnect2=$(curl -Is -m 5 youtube.com | grep 'HTTP')
if [[ -z $serverConnect1 ]] && [[ -z $serverConnect2 ]]; then
  copy_runtime_from_repo
  echo -e "${YELLOW}public HTTPS probe failed; skipped rule download, kept existing files${cRES}" >&2
  exit 0
fi

[[ $1 = "u" ]] && service cron stop

echo -e "${WHITE}[...]\c" && echo -e "\t${WHITE}Update CHN Domain & IP rules${cRES}\r\c"
checkSum(){
if [[ -z $2 || ! -f $1 ]]; then
  echo "false"
  return
fi
sha256sumL=$(sha256sum $1 2>/dev/null | awk '{print$1}')
if [[ $sha256sumL = $2 ]]; then 
  echo "true"
else
  echo "false"
fi
}

gh_candidates(){
local url="$1"
case "$url" in
  https://github.com/*|https://raw.githubusercontent.com/*|https://api.github.com/*) ;;
  *) echo "$url"; return ;;
esac
if [[ ${GH_PROXY:-} = off || ${GH_PROXY:-} = OFF || ${GH_PROXY:-} = direct ]]; then
  echo "$url"; return
fi
if [[ -n ${GH_PROXY:-} ]]; then
  echo "${GH_PROXY%/}/$url"; echo "$url"; return
fi
echo "https://gh.stuinx.eu.org/$url"
echo "https://gh-proxy.com/$url"
echo "https://ghproxy.net/$url"
echo "https://ghfast.top/$url"
echo "$url"
}
curl_gh(){
local url="$1" u
for u in $(gh_candidates "$url"); do
  curl -fsSL --connect-timeout 4 --speed-limit 200000 --speed-time 8 --max-time 60 --retry 0 "$u" && return 0
done
return 1
}
wget_gh(){
local dest="$1" url="$2" u tmp="${1}.part"
rm -f "$tmp"
for u in $(gh_candidates "$url"); do
  if curl -fL --connect-timeout 4 --speed-limit 200000 --speed-time 8 --progress-bar -o "$tmp" "$u" && [[ -s $tmp ]]; then
    mv -f "$tmp" "$dest"; return 0
  fi
  rm -f "$tmp"
  if command -v wget >/dev/null 2>&1; then
    if wget --no-check-certificate --show-progress -c --timeout=20 --tries=1 --connect-timeout=4 -O "$tmp" "$u" && [[ -s $tmp ]]; then
      mv -f "$tmp" "$dest"; return 0
    fi
  fi
  rm -f "$tmp"
done
return 1
}

geosite_sha256sum=$(curl_gh https://raw.githubusercontent.com/Loyalsoldier/v2ray-rules-dat/release/geosite.dat.sha256sum | awk '{print$1}')
geoip_sha256sum=$(curl_gh https://raw.githubusercontent.com/Loyalsoldier/geoip/release/geoip.dat.sha256sum | awk '{print$1}')
IPchnroute_sha256sum=$(curl_gh https://raw.githubusercontent.com/jacyl4/chnroute/main/IPchnroute.sha256sum)
DomainsChn_sha256sum=$(curl_gh https://raw.githubusercontent.com/jacyl4/chnroute/main/mosdns_chnlist/Domains.chn.txt.sha256sum)
DomainsApple_sha256sum=$(curl_gh https://raw.githubusercontent.com/jacyl4/chnroute/main/mosdns_chnlist/Domains.apple.txt.sha256sum)
DomainsGames_sha256sum=$(curl_gh https://raw.githubusercontent.com/jacyl4/chnroute/main/mosdns_chnlist/Domains.games.txt.sha256sum)
bogusNxdomain_sha256sum=$(curl_gh https://raw.githubusercontent.com/jacyl4/chnroute/main/mosdns_chnlist/99-bogus-nxdomain.china.conf.sha256sum)

if [[ $(checkSum /opt/de_GWD/.repo/geosite.dat $geosite_sha256sum) = "false" ]]; then
rm -rf /tmp/geosite.dat
wget_gh /tmp/geosite.dat https://raw.githubusercontent.com/Loyalsoldier/v2ray-rules-dat/release/geosite.dat
  if [[ $(checkSum /tmp/geosite.dat $geosite_sha256sum) = "true" ]]; then
    mv -f /tmp/geosite.dat /opt/de_GWD/.repo/geosite.dat
  else
    echo -e "${WHITE}[ ${RED}✕ ${WHITE}]\c" && echo -e "\t${WHITE}geosite.dat${RED} Download Failed${cRES}"
  fi
fi

if [[ $(checkSum /opt/de_GWD/.repo/geoip.dat $geoip_sha256sum) = "false" ]]; then
rm -rf /tmp/geoip.dat
wget_gh /tmp/geoip.dat https://raw.githubusercontent.com/Loyalsoldier/geoip/release/geoip.dat
  if [[ $(checkSum /tmp/geoip.dat $geoip_sha256sum) = "true" ]]; then
    mv -f /tmp/geoip.dat /opt/de_GWD/.repo/geoip.dat
  else
    echo -e "${WHITE}[ ${RED}✕ ${WHITE}]\c" && echo -e "\t${WHITE}geoip.dat${RED} Download Failed${cRES}"
  fi
fi

if [[ $(checkSum /opt/de_GWD/.repo/IPchnroute $IPchnroute_sha256sum) = "false" ]]; then
rm -rf /tmp/IPchnroute
wget_gh /tmp/IPchnroute https://raw.githubusercontent.com/jacyl4/chnroute/main/IPchnroute
  if [[ $(checkSum /tmp/IPchnroute $IPchnroute_sha256sum) = "true" ]]; then
    mv -f /tmp/IPchnroute /opt/de_GWD/.repo/IPchnroute
  else
    echo -e "${WHITE}[ ${RED}✕ ${WHITE}]\c" && echo -e "\t${WHITE}IPchnroute${RED} Download Failed${cRES}"
  fi
fi

if [[ $(checkSum /opt/de_GWD/.repo/Domains.chn.txt $DomainsChn_sha256sum) = "false" ]]; then
rm -rf /tmp/Domains.chn.txt
wget_gh /tmp/Domains.chn.txt https://raw.githubusercontent.com/jacyl4/chnroute/main/mosdns_chnlist/Domains.chn.txt
  if [[ $(checkSum /tmp/Domains.chn.txt $DomainsChn_sha256sum) = "true" ]]; then
    mv -f /tmp/Domains.chn.txt /opt/de_GWD/.repo/Domains.chn.txt
  else
    echo -e "${WHITE}[ ${RED}✕ ${WHITE}]\c" && echo -e "\t${WHITE}Domains.chn.txt${RED} Download Failed${cRES}"
  fi
fi

if [[ $(checkSum /opt/de_GWD/.repo/Domains.apple.txt $DomainsApple_sha256sum) = "false" ]]; then
rm -rf /tmp/Domains.apple.txt
wget_gh /tmp/Domains.apple.txt https://raw.githubusercontent.com/jacyl4/chnroute/main/mosdns_chnlist/Domains.apple.txt
  if [[ $(checkSum /tmp/Domains.apple.txt $DomainsApple_sha256sum) = "true" ]]; then
    mv -f /tmp/Domains.apple.txt /opt/de_GWD/.repo/Domains.apple.txt
  else
    echo -e "${WHITE}[ ${RED}✕ ${WHITE}]\c" && echo -e "\t${WHITE}Domains.apple.txt${RED} Download Failed${cRES}"
