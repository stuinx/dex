#!/bin/bash
set -o pipefail

rawProxyBase="${DE_GWD_GH_RAW_BASE:-https://ghfast.top/https://raw.githubusercontent.com}"
chnrouteBase="${DE_GWD_CHNROUTE_BASE:-$rawProxyBase/stuinx/chnroute/main}"

exec 9>/opt/de_GWD/.repo/.rules-update.lock || exit 1
flock -n 9 || exit 0
workdir=$(mktemp -d /opt/de_GWD/.repo/.rules-update.XXXXXX) || exit 1
trap 'rm -rf -- "$workdir"' EXIT
timeout --signal=TERM --kill-after=5s 30s /opt/de_GWD/tcpTime || true

fetchRules(){
    local maxTime=$1 target=$2 url=$3
    curl --connect-timeout 10 --max-time "$maxTime" --retry 2 --retry-delay 2 \
        --retry-max-time "$maxTime" -fsSL -o "$target" "$url"
}

files=(geosite.dat geoip.dat IPchnroute Domains.chn.txt Domains.apple.txt Domains.games.txt 99-bogus-nxdomain.china.conf)
urls=(
    "$rawProxyBase/Loyalsoldier/v2ray-rules-dat/release/geosite.dat"
    "$rawProxyBase/Loyalsoldier/geoip/release/geoip.dat"
    "$chnrouteBase/IPchnroute"
    "$chnrouteBase/mosdns_chnlist/Domains.chn.txt"
    "$chnrouteBase/mosdns_chnlist/Domains.apple.txt"
    "$chnrouteBase/mosdns_chnlist/Domains.games.txt"
    "$chnrouteBase/mosdns_chnlist/99-bogus-nxdomain.china.conf"
)
for ((i=0; i<${#files[@]}; i++)); do
    file=${files[$i]}
    fetchRules 60 "$workdir/$file.sha256sum" "${urls[$i]}.sha256sum" || { echo "Checksum download failed: $file" >&2; exit 1; }
    expected=$(awk 'NR == 1 {print $1}' "$workdir/$file.sha256sum")
    [[ $expected =~ ^[[:xdigit:]]{64}$ ]] || { echo "Invalid checksum: $file" >&2; exit 1; }
    actual=$(sha256sum "/opt/de_GWD/.repo/$file" 2>/dev/null | awk '{print $1}')
    if [[ $actual != "$expected" ]]; then
        fetchRules 300 "$workdir/$file" "${urls[$i]}" || { echo "Download failed: $file" >&2; exit 1; }
        actual=$(sha256sum "$workdir/$file" | awk '{print $1}')
        [[ $actual = "$expected" ]] || { echo "Checksum mismatch: $file" >&2; exit 1; }
    fi
done

for file in "${files[@]}"; do
    if [[ -f $workdir/$file ]]; then
        mv -f "$workdir/$file" "/opt/de_GWD/.repo/$file" || exit 1
    fi
done
cp -f /opt/de_GWD/.repo/99-bogus-nxdomain.china.conf /etc/dnsmasq.d/ || exit 1
cp -f /opt/de_GWD/.repo/geosite.dat /opt/de_GWD/vtrui/geosite.dat || exit 1
cp -f /opt/de_GWD/.repo/geoip.dat /opt/de_GWD/vtrui/geoip.dat || exit 1
sed '/^[[:space:]]*$/d; s/$/,/' /opt/de_GWD/.repo/IPchnroute > "$workdir/IP_CHNROUTE" || exit 1
if nft list set ip de_GWD CHNROUTE >/dev/null 2>&1; then
    if [[ -f /opt/de_GWD/nftables/SET_CHNROUTE.nft ]]; then
        cp -p /opt/de_GWD/nftables/SET_CHNROUTE.nft "$workdir/SET_CHNROUTE.nft" || exit 1
    else
        touch "$workdir/SET_CHNROUTE.nft" && chmod 755 "$workdir/SET_CHNROUTE.nft" || exit 1
    fi
    cat > "$workdir/SET_CHNROUTE.nft" << EOF
#!/usr/sbin/nft -f
flush set ip de_GWD CHNROUTE
table ip de_GWD {
    set CHNROUTE {
        type ipv4_addr
        flags interval
        auto-merge
        elements = { $(cat "$workdir/IP_CHNROUTE") }
    }
}
EOF
    nft -c -f "$workdir/SET_CHNROUTE.nft" && nft -f "$workdir/SET_CHNROUTE.nft" || exit 1
    chmod +x "$workdir/SET_CHNROUTE.nft"
    mv -f "$workdir/SET_CHNROUTE.nft" /opt/de_GWD/nftables/SET_CHNROUTE.nft || exit 1
fi
mv -f "$workdir/IP_CHNROUTE" /opt/de_GWD/nftables/IP_CHNROUTE || exit 1

if [[ -n $(openssl x509 -enddate -noout -in /var/www/ssl/de_GWD.cer -checkend 259200 | grep "Certificate will expire") ]] && [[ -d /root/.acme.sh ]]; then
    /root/.acme.sh/acme.sh --force --set-default-ca --server letsencrypt || exit 1
    /root/.acme.sh/acme.sh --force --cron --home /root/.acme.sh || exit 1
fi
printf '%s\n' 'Update CHN Domain & IP rules completed'
