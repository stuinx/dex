#!/bin/bash
tag="custom"

if [[ -n $2 ]]; then
node=$(jq -ce --argjson index "$2" '.v2node[$index] | select(.protocol == "vless")' /opt/de_GWD/0conf) || exit 1
else
address=$(jq -r '.v2nodeDIV.nodeCU.address // empty' /opt/de_GWD/0conf) || exit 1
if [[ -n $address ]]; then
node=$(jq -ce --arg address "$address" --arg tag "$tag" '
  .v2nodeDIV.outboundNodes[$tag] as $saved |
  [.v2node[]? | select(.domain == $address and .protocol == "vless") |
    select($saved == null or (.uuid == $saved.uuid and (.path // "") == $saved.path and .protocol == $saved.protocol
      and (($saved | has("tls") | not) or (if (.path // "") == "" then "" else (.tls // "" | if . == "" then ($address | split(":")[0]) else . end) end) == $saved.tls)))] |
  if length == 1 then .[0] else empty end' /opt/de_GWD/0conf) || { echo 'Ambiguous or missing custom node; select the node again.' >&2; exit 1; }
fi
fi

jq 'del(.outbounds[] | select(.tag == "custom")) | del(.routing.rules[] | select(.outboundTag == "custom"))' /opt/de_GWD/vtrui/config.json | sponge /opt/de_GWD/vtrui/config.json

if [[ -n $node ]]; then
address=$(jq -r '.domain' <<< "$node")
tls=$(jq -r '.tls // empty' <<< "$node")
uuid=$(jq -r '.uuid' <<< "$node")
path=$(jq -r '.path // empty' <<< "$node")
/opt/de_GWD/ui-V2outbound "$tag" "$address" "$tls" "$uuid" "$path" vless || exit 1
jq --arg address "$address" '.v2nodeDIV.nodeCU.address=$address' /opt/de_GWD/0conf | sponge /opt/de_GWD/0conf
fi

jq -r '.v2nodeDIV.nodeCU.rulesDomain[]' /opt/de_GWD/0conf 2>/dev/null | grep -v '^null$' >/tmp/routingDomain
jq -r '.v2nodeDIV.nodeCU.rulesIP[]' /opt/de_GWD/0conf 2>/dev/null | grep -v '^null$' >/tmp/routingIP
routingDomain=$(echo $(jq -R -s -c 'split("\n")' < /tmp/routingDomain) | jq -c '.[:-1]')
routingIP=$(echo $(jq -R -s -c 'split("\n")' < /tmp/routingIP) | jq -c '.[:-1]')

[[ -n $(cat /tmp/routingDomain) ]] && /opt/de_GWD/ui-V2routingDomain $tag $routingDomain
[[ -n $(cat /tmp/routingIP) ]] && /opt/de_GWD/ui-V2routingIP $tag $routingIP

jq '.v2nodeDIV.nodeCU.status="on"' /opt/de_GWD/0conf | sponge /opt/de_GWD/0conf

[[ $1 = "r" ]] && systemctl restart vtrui >/dev/null
chmod 666 /opt/de_GWD/0conf
rm -rf /tmp/routingDomain
rm -rf /tmp/routingIP
