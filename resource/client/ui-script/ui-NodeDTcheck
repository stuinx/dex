#!/bin/bash
jq -nr --arg tag "divert" --slurpfile nodes /opt/de_GWD/0conf --slurpfile config /opt/de_GWD/vtrui/config.json '
  $config[0].outbounds[]? | select(.tag == $tag and .protocol == "vless") as $out |
  $out.settings.vnext[0] as $next |
  ($next.address + (if $next.port == 443 then "" else ":" + ($next.port | tostring) end)) as $address |
  $nodes[0].v2node[]? |
  select((.domain == $address or .domain == ($address + ":443"))
    and .uuid == $next.users[0].id and .protocol == "vless"
    and (.path // "") == ($out.streamSettings.wsSettings.path // "")
    and (if (.path // "") == "" then "" elif (.tls // "") == "" then $next.address else .tls end)
      == ($out.streamSettings.tlsSettings.serverName // "")) | .name'
