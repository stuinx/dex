#!/bin/bash
jq 'del(.outbounds[] | select(.tag | startswith("nodeSM")))' /opt/de_GWD/vtrui/config.json |\
jq 'del(.routing.rules[] | select(.outboundTag | startswith("nodeSM")))' |\
jq 'del(.routing.rules[] | select(.domain == ["geosite:apple","geosite:apple-ads","geosite:apple-dev","geosite:apple-update","geosite:icloud","geosite:apple@cn","geosite:apple-cn"]))' |\
jq 'del(.routing.rules[] | select(.domain == ["domain:steamserver.net","geosite:steam@cn","geosite:category-games@cn"]))' | sponge /opt/de_GWD/vtrui/config.json

nodeSM_sites=(openai claude gemini grok wikipedia reddit github discord telegram twitter)

nodeSM_domains=(
'["geosite:openai"]'
'["domain:claude.ai","domain:anthropic.com"]'
'["domain:gemini.google.com","domain:generativelanguage.googleapis.com","domain:bard.google.com"]'
'["domain:grok.com","domain:x.ai"]'
'["domain:wikipedia.org","domain:wikimedia.org"]'
'["geosite:reddit"]'
'["geosite:github"]'
'["domain:discord.com","domain:discord.gg","domain:discordapp.com","domain:discordapp.net"]'
'["geosite:telegram"]'
'["geosite:twitter"]'
)

args=("$@")

for i in ${!nodeSM_sites[@]}; do
site=${nodeSM_sites[$i]}
argpos=$((i+2))
sel="${args[$((argpos-1))]}"
routingDomain=${nodeSM_domains[$i]}
tag="nodeSM$site"

if [[ -n $sel ]] && [[ $sel != "0" ]]; then
nodeSMnum=$[$sel-1]
address=$(jq -r --argjson nodecheck $nodeSMnum '.v2node | to_entries[] | select(.key == $nodecheck) | .value.domain' /opt/de_GWD/0conf)
tls=$(jq -r --argjson nodecheck $nodeSMnum '.v2node | to_entries[] | select(.key == $nodecheck) | .value.tls' /opt/de_GWD/0conf)
uuid=$(jq -r --argjson nodecheck $nodeSMnum '.v2node | to_entries[] | select(.key == $nodecheck) | .value.uuid' /opt/de_GWD/0conf)
path=$(jq -r --argjson nodecheck $nodeSMnum '.v2node | to_entries[] | select(.key == $nodecheck) | .value.path' /opt/de_GWD/0conf)
jq --arg address $address ".v2nodeDIV.nodeSM.$site=\$address" /opt/de_GWD/0conf | sponge /opt/de_GWD/0conf
/opt/de_GWD/ui-V2routingDomain $tag $routingDomain
if [[ $site == "telegram" ]]; then
jq --argjson ipadd '["geoip:telegram"]' '.routing.rules+=[{"type":"field","ip":$ipadd,"network":"tcp,udp","outboundTag":"nodeSMtelegram"}]' /opt/de_GWD/vtrui/config.json | sponge /opt/de_GWD/vtrui/config.json
fi
/opt/de_GWD/ui-V2outbound $tag $address $tls $uuid $path
elif [[ $sel = "0" ]]; then
jq "del(.v2nodeDIV.nodeSM.$site)" /opt/de_GWD/0conf | sponge /opt/de_GWD/0conf
else
address=$(jq -r ".v2nodeDIV.nodeSM.$site" /opt/de_GWD/0conf 2>/dev/null | grep -v '^null$')
if [[ -n $address ]]; then
tls=$(jq -r --arg nodecheck $address '.v2node | to_entries[] | select(.value.domain == $nodecheck) | .value.tls' /opt/de_GWD/0conf)
uuid=$(jq -r --arg nodecheck $address '.v2node | to_entries[] | select(.value.domain == $nodecheck) | .value.uuid' /opt/de_GWD/0conf)
path=$(jq -r --arg nodecheck $address '.v2node | to_entries[] | select(.value.domain == $nodecheck) | .value.path' /opt/de_GWD/0conf)
/opt/de_GWD/ui-V2routingDomain $tag $routingDomain
if [[ $site == "telegram" ]]; then
jq --argjson ipadd '["geoip:telegram"]' '.routing.rules+=[{"type":"field","ip":$ipadd,"network":"tcp,udp","outboundTag":"nodeSMtelegram"}]' /opt/de_GWD/vtrui/config.json | sponge /opt/de_GWD/vtrui/config.json
fi
/opt/de_GWD/ui-V2outbound $tag $address $tls $uuid $path
fi
fi
done

alloff=1
for i in ${!nodeSM_sites[@]}; do
argpos=$((i+2))
sel="${args[$((argpos-1))]}"
if [[ $sel != "0" ]]; then
alloff=0
fi
done

if [[ $alloff = "1" ]]; then
jq '.v2nodeDIV.nodeSM.status="off"' /opt/de_GWD/0conf | sponge /opt/de_GWD/0conf
else
jq '.v2nodeDIV.nodeSM.status="on"' /opt/de_GWD/0conf | sponge /opt/de_GWD/0conf
fi

if [[ $1 = "r" ]]; then
systemctl restart mosdns
systemctl restart vtrui
fi

chmod 666 /opt/de_GWD/0conf
