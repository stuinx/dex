#!/bin/bash

config=/opt/de_GWD/0conf
xrayConfig=/opt/de_GWD/vtrui/config.json

nodeSMKeys=(youtube claude gemini grok wikipedia reddit github discord telegram x openai apple)
nodeSMTags=(
  nodeSMyoutube
  nodeSMclaude
  nodeSMgemini
  nodeSMgrok
  nodeSMwikipedia
  nodeSMreddit
  nodeSMgithub
  nodeSMdiscord
  nodeSMtelegram
  nodeSMx
  nodeSMopenai
  nodeSMapple
)
nodeSMDomains=(
  '["geosite:youtube"]'
  '["domain:claude.ai","domain:anthropic.com","domain:claudeusercontent.com"]'
  '["domain:gemini.google.com","domain:generativelanguage.googleapis.com","domain:ai.google.dev"]'
  '["domain:grok.com","domain:x.ai"]'
  '["domain:wikipedia.org","domain:wikimedia.org","domain:mediawiki.org"]'
  '["domain:reddit.com","domain:redditmedia.com","domain:redd.it"]'
  '["domain:github.com","domain:githubusercontent.com","domain:githubassets.com"]'
  '["domain:discord.com","domain:discordapp.com","domain:discordapp.net"]'
  '["domain:telegram.org","domain:t.me","domain:telegra.ph"]'
  '["domain:x.com","domain:twitter.com","domain:twimg.com"]'
  '["geosite:openai"]'
  '["geosite:apple","geosite:apple-dev","geosite:apple-update","geosite:icloud","geosite:apple@cn","geosite:apple-cn"]'
)
managedTags='["nodeSMyoutube","nodeSMclaude","nodeSMgemini","nodeSMgrok","nodeSMwikipedia","nodeSMreddit","nodeSMgithub","nodeSMdiscord","nodeSMtelegram","nodeSMx","nodeSMopenai","nodeSMapple","nodeSMsteam","nodeSMnetflix","nodeSMhdh","nodeSMtvb","nodeSMbahamut"]'
managedKeys='["youtube","claude","gemini","grok","wikipedia","reddit","github","discord","telegram","x","openai","apple","steam","netflix","hdh","tvb","bahamut"]'
appleDomains='["geosite:apple","geosite:apple-dev","geosite:apple-update","geosite:icloud","geosite:apple@cn","geosite:apple-cn"]'
steamDomains='["domain:steamserver.net","geosite:steam@cn","geosite:category-games@cn"]'

savedNodeSM=()
for ((i=0; i<${#nodeSMKeys[@]}; i++)); do
  key=${nodeSMKeys[$i]}
  savedNodeSM[$i]=$(jq -r --arg key "$key" '.v2nodeDIV.nodeSM[$key] // empty' "$config" 2>/dev/null)
done
savedSteam=$(jq -r '.v2nodeDIV.nodeSM.steam // empty' "$config" 2>/dev/null)

nodeCount=$(jq -r '.v2node | length' "$config" 2>/dev/null)
[[ $nodeCount =~ ^[0-9]+$ ]] || nodeCount=0

if (( $# > 1 )); then
  for ((i=0; i<${#nodeSMKeys[@]}; i++)); do
    argIndex=$((i + 2))
    if (( $# >= argIndex )); then
      selection=${!argIndex}
      [[ $selection =~ ^[0-9]+$ ]] || { echo "Invalid node selection for ${nodeSMKeys[$i]}" >&2; exit 1; }
      (( selection <= nodeCount )) || { echo "Node selection out of range for ${nodeSMKeys[$i]}" >&2; exit 1; }
    fi
  done
  if (( $# >= 14 )); then
    [[ ${14} = 0 || ${14} = 1 ]] || { echo 'Invalid Steam selection' >&2; exit 1; }
  fi
fi

jq --argjson managedTags "$managedTags" \
   --argjson managedKeys "$managedKeys" \
   --argjson appleDomains "$appleDomains" \
   --argjson steamDomains "$steamDomains" '
  .outbounds = [(.outbounds // [])[] | select(((.tag // "") as $tag | ($managedTags | index($tag))) == null)]
  | .routing.rules = [(.routing.rules // [])[] | select(
      (((.outboundTag // "") as $tag | ($managedTags | index($tag))) == null)
      and .domain != $appleDomains
      and .domain != $steamDomains
    )]
  | .v2nodeDIV = (.v2nodeDIV // {})
  | .v2nodeDIV.nodeSM = ((.v2nodeDIV.nodeSM // {}) | del(.youtube,.claude,.gemini,.grok,.wikipedia,.reddit,.github,.discord,.telegram,.x,.openai,.apple,.steam,.netflix,.hdh,.tvb,.bahamut))
  | .v2nodeDIV.outboundNodes = ((.v2nodeDIV.outboundNodes // {}) | del(.nodeSMyoutube,.nodeSMclaude,.nodeSMgemini,.nodeSMgrok,.nodeSMwikipedia,.nodeSMreddit,.nodeSMgithub,.nodeSMdiscord,.nodeSMtelegram,.nodeSMx,.nodeSMopenai,.nodeSMapple,.nodeSMsteam,.nodeSMnetflix,.nodeSMhdh,.nodeSMtvb,.nodeSMbahamut))
' "$xrayConfig" | sponge "$xrayConfig"

jq --argjson managedTags "$managedTags" --argjson managedKeys "$managedKeys" '
  .v2nodeDIV = (.v2nodeDIV // {})
  | .v2nodeDIV.nodeSM = ((.v2nodeDIV.nodeSM // {}) | with_entries(select((.key as $key | ($managedKeys | index($key))) == null)))
  | .v2nodeDIV.outboundNodes = ((.v2nodeDIV.outboundNodes // {}) | with_entries(select((.key as $tag | ($managedTags | index($tag))) == null)))
' "$config" | sponge "$config"

nodeSMEnabled=0
for ((i=0; i<${#nodeSMKeys[@]}; i++)); do
  key=${nodeSMKeys[$i]}
  tag=${nodeSMTags[$i]}
  routingDomain=${nodeSMDomains[$i]}
  argIndex=$((i + 2))
  selection=''
  address=''

  if (( $# >= argIndex )); then
    selection=${!argIndex}
    if [[ $selection != 0 ]]; then
      nodeIndex=$((selection - 1))
      node=$(jq -ce --argjson nodeIndex "$nodeIndex" '.v2node[$nodeIndex] // empty' "$config" 2>/dev/null) || exit 1
      address=$(jq -r '.domain // empty' <<< "$node")
    fi
  elif [[ -n ${savedNodeSM[$i]} ]]; then
    address=${savedNodeSM[$i]}
    node=$(jq -ce --arg address "$address" '[.v2node[]? | select(.domain == $address)][0] // empty' "$config" 2>/dev/null) || continue
  fi

  if [[ -n $address ]]; then
    tls=$(jq -r '.tls // empty' <<< "$node")
    uuid=$(jq -r '.uuid // empty' <<< "$node")
    path=$(jq -r '.path // empty' <<< "$node")
    protocol=$(jq -r '.protocol // "vmess"' <<< "$node")
    jq --arg key "$key" --arg address "$address" '.v2nodeDIV.nodeSM[$key]=$address' "$config" | sponge "$config"
    if [[ $key = apple ]]; then
      sed -i '/apple.china.conf/d' /opt/de_GWD/smartdns/smartdns.conf && systemctl restart smartdns
    fi
    /opt/de_GWD/ui-V2routingDomain "$tag" "$routingDomain"
    /opt/de_GWD/ui-V2outbound "$tag" "$address" "$tls" "$uuid" "$path" "$protocol" || exit 1
    nodeSMEnabled=1
  elif [[ $key = apple ]]; then
    /opt/de_GWD/ui-V2routingDomain 'direct' "$routingDomain"
  fi
done

steamSelection=''
if (( $# >= 14 )); then
  steamSelection=${14}
elif [[ $savedSteam = proxy ]]; then
  steamSelection=1
else
  steamSelection=0
fi

if [[ $steamSelection = 1 ]]; then
  jq '.v2nodeDIV.nodeSM.steam="proxy"' "$config" | sponge "$config"
  nodeSMEnabled=1
else
  jq 'del(.v2nodeDIV.nodeSM.steam)' "$config" | sponge "$config"
  /opt/de_GWD/ui-V2routingDomain 'direct' "$steamDomains"
fi

/opt/de_GWD/ui-submitListBWsm

if (( nodeSMEnabled == 0 )); then
  jq '.v2nodeDIV.nodeSM.status="off"' "$config" | sponge "$config"
else
  jq '.v2nodeDIV.nodeSM.status="on"' "$config" | sponge "$config"
fi

if [[ $1 = r ]]; then
  systemctl restart mosdns
  systemctl restart vtrui
fi

chmod 666 "$config"
