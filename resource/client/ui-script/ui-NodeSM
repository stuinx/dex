#!/bin/bash

config=/opt/de_GWD/0conf
xrayConfig=/opt/de_GWD/vtrui/config.json

nodeSMKeys=(youtube claude gemini grok wikipedia reddit github discord telegram x openai metaai apple)
nodeSMTags=(
  nodeSMyoutube
  nodeSMclaude
  nodeSMgemini
  nodeSMgrok
  nodeSMwikipedia
  nodeSMreddit
  nodeSMgithub
  nodeSMdiscord
  nodeSMtelegram
  nodeSMx
  nodeSMopenai
  nodeSMmetaai
  nodeSMapple
)
nodeSMDomains=(
  '["geosite:youtube"]'
  '["domain:claude.ai","domain:anthropic.com","domain:claudeusercontent.com"]'
  '["domain:gemini.google.com","domain:generativelanguage.googleapis.com","domain:ai.google.dev"]'
  '["domain:grok.com","domain:x.ai"]'
  '["domain:wikipedia.org","domain:wikimedia.org","domain:mediawiki.org"]'
  '["domain:reddit.com","domain:redditmedia.com","domain:redd.it"]'
  '["domain:github.com","domain:githubusercontent.com","domain:githubassets.com"]'
  '["domain:discord.com","domain:discordapp.com","domain:discordapp.net"]'
  '["domain:telegram.org","domain:t.me","domain:telegra.ph"]'
  '["domain:x.com","domain:twitter.com","domain:twimg.com"]'
  '["geosite:openai"]'
  '["geosite:facebook","geosite:instagram","geosite:messenger","geosite:whatsapp","geosite:threads","geosite:oculus","domain:meta.ai","domain:muse.ai"]'
  '["geosite:apple","geosite:apple-dev","geosite:apple-update","geosite:icloud","geosite:apple@cn","geosite:apple-cn"]'
)
managedTags='["nodeSMyoutube","nodeSMclaude","nodeSMgemini","nodeSMgrok","nodeSMwikipedia","nodeSMreddit","nodeSMgithub","nodeSMdiscord","nodeSMtelegram","nodeSMx","nodeSMopenai","nodeSMmetaai","nodeSMapple","nodeSMsteam","nodeSMnetflix","nodeSMhdh","nodeSMtvb","nodeSMbahamut"]'
managedKeys='["youtube","claude","gemini","grok","wikipedia","reddit","github","discord","telegram","x","openai","metaai","apple","steam","netflix","hdh","tvb","bahamut"]'
appleDomains='["geosite:apple","geosite:apple-dev","geosite:apple-update","geosite:icloud","geosite:apple@cn","geosite:apple-cn"]'
steamDomains='["domain:steamserver.net","geosite:steam@cn","geosite:category-games@cn"]'

savedIdentities=$(jq -c '.v2nodeDIV.outboundNodes // {}' "$config") || exit 1
savedSteam=$(jq -r '.v2nodeDIV.nodeSM.steam // empty' "$config" 2>/dev/null)

nodeCount=$(jq -r '.v2node | length' "$config" 2>/dev/null)
[[ $nodeCount =~ ^[0-9]+$ ]] || nodeCount=0
steamArgIndex=$((${#nodeSMKeys[@]} + 2))

if (( $# > 1 )); then
  for ((i=0; i<${#nodeSMKeys[@]}; i++)); do
    argIndex=$((i + 2))
    if (( $# >= argIndex )); then
      selection=${!argIndex}
      [[ $selection =~ ^[0-9]+$ ]] || { echo "Invalid node selection for ${nodeSMKeys[$i]}" >&2; exit 1; }
      (( selection <= nodeCount )) || { echo "Node selection out of range for ${nodeSMKeys[$i]}" >&2; exit 1; }
      if (( selection > 0 )); then
        jq -e --argjson index "$((selection - 1))" '.v2node[$index].protocol == "vless"' "$config" >/dev/null || { echo 'Only VLESS nodes are supported' >&2; exit 1; }
      fi
    fi
  done
  if (( $# >= steamArgIndex )); then
    steamSelection=${!steamArgIndex}
    [[ $steamSelection = 0 || $steamSelection = 1 ]] || { echo 'Invalid Steam selection' >&2; exit 1; }
  fi
fi

selectedNodes=()
for ((i=0; i<${#nodeSMKeys[@]}; i++)); do
  key=${nodeSMKeys[$i]}
  tag=${nodeSMTags[$i]}
  argIndex=$((i + 2))
  selectedNodes[$i]=''
  if (( $# >= argIndex )); then
    selection=${!argIndex}
    if [[ $selection != 0 ]]; then
      selectedNodes[$i]=$(jq -ce --argjson index "$((selection - 1))" '.v2node[$index]' "$config") || exit 1
    fi
  else
    selectedNodes[$i]=$(jq -cr --arg key "$key" --arg tag "$tag" --argjson identities "$savedIdentities" '
      .v2nodeDIV.nodeSM[$key] as $address | $identities[$tag] as $saved |
      [.v2node[]? | select(.domain == $address and .protocol == "vless") |
        select($saved == null or
          (.uuid == $saved.uuid and (.path // "") == ($saved.path // "") and .protocol == $saved.protocol
            and (($saved | has("tls") | not) or
              (if (.path // "") == "" then "" else (.tls // "" | if . == "" then ($address | split(":")[0]) else . end) end) == $saved.tls)))] |
      if length > 1 then error("Ambiguous saved node; select the routing node again")
      elif length == 1 then .[0] else empty end
    ' "$config") || exit 1
  fi
done

jq --argjson managedTags "$managedTags" \
   --argjson managedKeys "$managedKeys" \
   --argjson appleDomains "$appleDomains" \
   --argjson steamDomains "$steamDomains" '
  .outbounds = [(.outbounds // [])[] | select(((.tag // "") as $tag | ($managedTags | index($tag))) == null)]
  | .routing.rules = [(.routing.rules // [])[] | select(
      (((.outboundTag // "") as $tag | ($managedTags | index($tag))) == null)
      and .domain != $appleDomains
      and .domain != $steamDomains
    )]
  | .v2nodeDIV = (.v2nodeDIV // {})
  | .v2nodeDIV.nodeSM = ((.v2nodeDIV.nodeSM // {}) | del(.youtube,.claude,.gemini,.grok,.wikipedia,.reddit,.github,.discord,.telegram,.x,.openai,.metaai,.apple,.steam,.netflix,.hdh,.tvb,.bahamut))
  | .v2nodeDIV.outboundNodes = ((.v2nodeDIV.outboundNodes // {}) | del(.nodeSMyoutube,.nodeSMclaude,.nodeSMgemini,.nodeSMgrok,.nodeSMwikipedia,.nodeSMreddit,.nodeSMgithub,.nodeSMdiscord,.nodeSMtelegram,.nodeSMx,.nodeSMopenai,.nodeSMmetaai,.nodeSMapple,.nodeSMsteam,.nodeSMnetflix,.nodeSMhdh,.nodeSMtvb,.nodeSMbahamut))
' "$xrayConfig" | sponge "$xrayConfig"

jq --argjson managedTags "$managedTags" --argjson managedKeys "$managedKeys" '
  .v2nodeDIV = (.v2nodeDIV // {})
  | .v2nodeDIV.nodeSM = ((.v2nodeDIV.nodeSM // {}) | with_entries(select((.key as $key | ($managedKeys | index($key))) == null)))
  | .v2nodeDIV.outboundNodes = ((.v2nodeDIV.outboundNodes // {}) | with_entries(select((.key as $tag | ($managedTags | index($tag))) == null)))
' "$config" | sponge "$config"

nodeSMEnabled=0
for ((i=0; i<${#nodeSMKeys[@]}; i++)); do
  key=${nodeSMKeys[$i]}
  tag=${nodeSMTags[$i]}
  routingDomain=${nodeSMDomains[$i]}
  node=${selectedNodes[$i]}
  address=''
  if [[ -n $node ]]; then
    address=$(jq -r '.domain // empty' <<< "$node")
  fi

  if [[ -n $address ]]; then
    tls=$(jq -r '.tls // empty' <<< "$node")
    uuid=$(jq -r '.uuid // empty' <<< "$node")
    path=$(jq -r '.path // empty' <<< "$node")
    protocol=$(jq -r '.protocol // ""' <<< "$node")
    jq --arg key "$key" --arg address "$address" '.v2nodeDIV.nodeSM[$key]=$address' "$config" | sponge "$config"
    if [[ $key = apple ]]; then
      sed -i '/apple.china.conf/d' /opt/de_GWD/smartdns/smartdns.conf && systemctl restart smartdns
    fi
    /opt/de_GWD/ui-V2routingDomain "$tag" "$routingDomain"
    /opt/de_GWD/ui-V2outbound "$tag" "$address" "$tls" "$uuid" "$path" "$protocol" || exit 1
    nodeSMEnabled=1
  elif [[ $key = apple ]]; then
    /opt/de_GWD/ui-V2routingDomain 'direct' "$routingDomain"
  fi
done

steamSelection=''
if (( $# >= steamArgIndex )); then
  steamSelection=${!steamArgIndex}
elif [[ $savedSteam = proxy ]]; then
  steamSelection=1
else
  steamSelection=0
fi

if [[ $steamSelection = 1 ]]; then
  jq '.v2nodeDIV.nodeSM.steam="proxy"' "$config" | sponge "$config"
  nodeSMEnabled=1
else
  jq 'del(.v2nodeDIV.nodeSM.steam)' "$config" | sponge "$config"
  /opt/de_GWD/ui-V2routingDomain 'direct' "$steamDomains"
fi

/opt/de_GWD/ui-submitListBWsm

if (( nodeSMEnabled == 0 )); then
  jq '.v2nodeDIV.nodeSM.status="off"' "$config" | sponge "$config"
else
  jq '.v2nodeDIV.nodeSM.status="on"' "$config" | sponge "$config"
fi

if [[ $1 = r ]]; then
  systemctl restart mosdns
  systemctl restart vtrui
fi

chmod 666 "$config"
