#!/bin/bash
if [[ $1 = "off" ]]; then
crontab -l 2>/dev/null > /tmp/now.cron
sed -i '/autoUpdate/d' /tmp/now.cron
crontab /tmp/now.cron
rm -rf /tmp/now.cron
rm -rf /opt/de_GWD/autoUpdate
else
cat << "EOF" >/opt/de_GWD/autoUpdate
#!/bin/bash
localVer=$(awk 'NR==1' /var/www/html/act/version.php)
# This checkout is dex/dev. version.php's first line is the version on released branches,
# so it cannot be used to infer the source branch.
branch="dev"
remoteVer=$(curl -fsSL --connect-timeout 4 --speed-limit 200000 --speed-time 8 "https://gh.stuinx.eu.org/https://raw.githubusercontent.com/stuinx/dex/$branch/version.php" | head -n 1)
[[ -z $remoteVer ]] && remoteVer=$(curl -fsSL --connect-timeout 4 --speed-limit 200000 --speed-time 8 "https://gh-proxy.com/https://raw.githubusercontent.com/stuinx/dex/$branch/version.php" | head -n 1)
[[ -z $remoteVer ]] && remoteVer=$(curl -fsSL --connect-timeout 4 --speed-limit 200000 --speed-time 8 "https://ghproxy.net/https://raw.githubusercontent.com/stuinx/dex/$branch/version.php" | head -n 1)
[[ -z $remoteVer ]] && remoteVer=$(curl -fsSL --connect-timeout 4 --speed-limit 200000 --speed-time 8 "https://ghfast.top/https://raw.githubusercontent.com/stuinx/dex/$branch/version.php" | head -n 1)
[[ -z $remoteVer ]] && remoteVer=$(curl -fsSL --connect-timeout 4 --speed-limit 200000 --speed-time 8 "https://raw.githubusercontent.com/stuinx/dex/$branch/version.php" | head -n 1)

echo $localVer >/tmp/de_GWD_Ver
echo $remoteVer >>/tmp/de_GWD_Ver

VerCP=$(cat /tmp/de_GWD_Ver | sort -rV | uniq | awk NR==2)

if [[ $VerCP = $localVer ]]; then
systemctl stop php7.4-fpm

rm -rf /tmp/autoUpdate
curl -fL --connect-timeout 4 --speed-limit 200000 --speed-time 8 -o /tmp/autoUpdate "https://gh.stuinx.eu.org/https://raw.githubusercontent.com/stuinx/dex/$branch/client" \
  || curl -fL --connect-timeout 4 --speed-limit 200000 --speed-time 8 -o /tmp/autoUpdate "https://gh-proxy.com/https://raw.githubusercontent.com/stuinx/dex/$branch/client" \
  || curl -fL --connect-timeout 4 --speed-limit 200000 --speed-time 8 -o /tmp/autoUpdate "https://ghproxy.net/https://raw.githubusercontent.com/stuinx/dex/$branch/client" \
  || curl -fL --connect-timeout 4 --speed-limit 200000 --speed-time 8 -o /tmp/autoUpdate "https://ghfast.top/https://raw.githubusercontent.com/stuinx/dex/$branch/client" \
  || wget --no-check-certificate --connect-timeout=4 -cqO /tmp/autoUpdate "https://raw.githubusercontent.com/stuinx/dex/$branch/client"

if [[ $(du -sk /tmp/autoUpdate 2>/dev/null | awk '{print$1}') -gt 70 ]]; then
sed -i '$d' /tmp/autoUpdate
echo "updateGWD auto" >>/tmp/autoUpdate
chmod +x /tmp/autoUpdate
/tmp/autoUpdate
rm -rf /tmp/autoUpdate
fi

systemctl restart php7.4-fpm
fi

rm -rf /tmp/de_GWD_Ver
rm -rf /tmp/autoUpdate
EOF
chmod +x /opt/de_GWD/autoUpdate

crontab -l 2>/dev/null > /tmp/now.cron
sed -i '/autoUpdate/d' /tmp/now.cron
echo "0 $1 * * *  /opt/de_GWD/autoUpdate" >> /tmp/now.cron
crontab /tmp/now.cron
rm -rf /tmp/now.cron
fi
