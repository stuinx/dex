#!/bin/bash
if [[ $1 = "off" ]]; then
crontab -l 2>/dev/null > /tmp/now.cron
sed -i '/autoUpdate/d' /tmp/now.cron
crontab /tmp/now.cron
rm -rf /tmp/now.cron
rm -rf /opt/de_GWD/autoUpdate
else
cat << "EOF" >/opt/de_GWD/autoUpdate
#!/bin/bash
repoBase="https://gh.stuinx.eu.org/https://raw.githubusercontent.com/stuinx/dex/dev"
localVer=$(awk 'NR==1' /var/www/html/act/version.php)
remoteVer=$(curl --connect-timeout 10 --max-time 60 --retry 3 --retry-delay 2 --retry-max-time 180 -fsSLo- "$repoBase/version.php" | head -n 1)
[[ -n $localVer && -n $remoteVer ]] || exit 1

VerCP=$(printf '%s\n' "$localVer" "$remoteVer" | sort -rV | uniq | awk NR==2)

if [[ $VerCP = $localVer ]]; then
autoUpdateTmp=$(mktemp /tmp/de_GWD-autoUpdate.XXXXXX) || exit 1
phpStopped=0
trap 'updateStatus=$?; rm -f "$autoUpdateTmp"; if [[ $phpStopped = 1 ]]; then systemctl restart php7.4-fpm || updateStatus=1; fi; exit "$updateStatus"' EXIT
if ! timeout --signal=TERM --kill-after=5s 300s wget --connect-timeout=10 --read-timeout=30 --tries=4 --waitretry=2 -qO "$autoUpdateTmp" "$repoBase/client" || [[ ! -s $autoUpdateTmp ]] || ! bash -n "$autoUpdateTmp"; then
  echo 'Automatic update script download or validation failed' >&2
  exit 1
fi
sed -i '$d' "$autoUpdateTmp" || exit 1
echo "updateGWD auto" >> "$autoUpdateTmp"
chmod +x "$autoUpdateTmp" || exit 1
systemctl stop php7.4-fpm || exit 1
phpStopped=1
"$autoUpdateTmp"
fi
EOF
chmod +x /opt/de_GWD/autoUpdate

crontab -l 2>/dev/null > /tmp/now.cron
sed -i '/autoUpdate/d' /tmp/now.cron
echo "0 $1 * * *  /opt/de_GWD/autoUpdate" >> /tmp/now.cron
crontab /tmp/now.cron
rm -rf /tmp/now.cron
fi
