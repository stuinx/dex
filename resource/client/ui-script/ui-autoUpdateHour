#!/bin/bash
if [[ $1 = "off" ]]; then
crontab -l 2>/dev/null > /tmp/now.cron
sed -i '/autoUpdate/d' /tmp/now.cron
crontab /tmp/now.cron
rm -rf /tmp/now.cron
rm -rf /opt/de_GWD/autoUpdate
else
cat << "EOF" >/opt/de_GWD/autoUpdate
#!/bin/bash
repoBase="https://ghfast.top/https://raw.githubusercontent.com/stuinx/dex/dev"
getPhpFpmService() {
  local service
  service=$(sed -nE 's#^[[:space:]]*fastcgi_pass[[:space:]]+unix:/run/php/(php[0-9]+(\.[0-9]+)+-fpm)\.sock;.*#\1#p' /etc/nginx/conf.d/default.conf 2>/dev/null | head -n 1)
  [[ $service =~ ^php[0-9]+(\.[0-9]+)+-fpm$ ]] || service=$(cat /opt/de_GWD/php-fpm-service 2>/dev/null)
  if [[ $service =~ ^php[0-9]+(\.[0-9]+)+-fpm$ ]]; then
    printf '%s\n' "$service"
    return 0
  fi
  for service in php8.5-fpm php7.4-fpm; do
    if systemctl is-active --quiet "$service"; then
      printf '%s\n' "$service"
      return 0
    fi
  done
  return 1
}
localVer=$(awk 'NR==1' /var/www/html/act/version.php)
remoteVer=$(curl --connect-timeout 10 --max-time 60 --retry 3 --retry-delay 2 --retry-max-time 180 -fsSLo- "$repoBase/version.php" | head -n 1)
[[ -n $localVer && -n $remoteVer ]] || exit 1

VerCP=$(printf '%s\n' "$localVer" "$remoteVer" | sort -rV | uniq | awk NR==2)

if [[ $VerCP = $localVer ]]; then
phpServiceToRestore=$(getPhpFpmService) || exit 1
autoUpdateTmp=$(mktemp /tmp/de_GWD-autoUpdate.XXXXXX) || exit 1
phpStopped=0
trap 'updateStatus=$?; rm -f "$autoUpdateTmp"; if [[ $phpStopped = 1 ]]; then phpServiceToRestore=$(getPhpFpmService) || :; [[ -n $phpServiceToRestore ]] || phpServiceToRestore=$phpServiceBeforeUpdate; systemctl restart "$phpServiceToRestore" || updateStatus=1; fi; exit "$updateStatus"' EXIT
if ! timeout --signal=TERM --kill-after=5s 300s wget --connect-timeout=10 --read-timeout=30 --tries=4 --waitretry=2 -qO "$autoUpdateTmp" "$repoBase/client" || [[ ! -s $autoUpdateTmp ]] || ! bash -n "$autoUpdateTmp"; then
  echo 'Automatic update script download or validation failed' >&2
  exit 1
fi
sed -i '$d' "$autoUpdateTmp" || exit 1
echo "updateGWD auto" >> "$autoUpdateTmp"
chmod +x "$autoUpdateTmp" || exit 1
phpServiceBeforeUpdate=$phpServiceToRestore
phpStopped=1
systemctl stop "$phpServiceBeforeUpdate" || exit 1
"$autoUpdateTmp"
fi
EOF
chmod +x /opt/de_GWD/autoUpdate

crontab -l 2>/dev/null > /tmp/now.cron
sed -i '/autoUpdate/d' /tmp/now.cron
echo "0 $1 * * *  /opt/de_GWD/autoUpdate" >> /tmp/now.cron
crontab /tmp/now.cron
rm -rf /tmp/now.cron
fi
