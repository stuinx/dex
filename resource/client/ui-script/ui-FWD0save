#!/bin/bash
FWD0port=$(jq -r '.FORWARD.FWD0.port' /opt/de_GWD/0conf 2>/dev/null | grep -v '^null$')
FWD0uuid=$(jq -r '.FORWARD.FWD0.uuid[].FWD0uuid' /opt/de_GWD/0conf 2>/dev/null | grep -v '^null$')
FWD0firstUUID=${FWD0uuid%%$'\n'*}
FWD0path="/${FWD0firstUUID: -6}"
[[ $FWD0port =~ ^[0-9]{1,5}$ ]] || { echo "FWD0 requires a valid port, UUID, and installed TLS certificate" >&2; exit 1; }
FWD0port=$((10#$FWD0port))
(( FWD0port >= 1 && FWD0port <= 65535 )) && [[ -s /var/www/ssl/de_GWD.cer && -s /var/www/ssl/de_GWD.key && -n $FWD0uuid ]] || { echo "FWD0 requires a valid port, UUID, and installed TLS certificate" >&2; exit 1; }

FWD0in=`cat << EOF
    {
      "tag": "forward0",
      "port": $FWD0port,
      "protocol": "vless",
      "settings":{
        "decryption": "none",
        "clients":[]
      },
      "streamSettings": {
        "network": "ws",
        "security": "tls",
        "wsSettings": {
          "path": "$FWD0path"
        },
        "tlsSettings": {
          "certificates": [
            {
              "certificateFile": "/var/www/ssl/de_GWD.cer",
              "keyFile": "/var/www/ssl/de_GWD.key"
            }
          ]
        }
      }
    }
EOF
`
jq --argjson FWD0in "$FWD0in" '.inbounds[1]=$FWD0in' /opt/de_GWD/vtrui/config.json | sponge /opt/de_GWD/vtrui/config.json

for uuid in $FWD0uuid; do
uuidStr='{"id":"'$uuid'"}'
jq --argjson uuidStr1 "$uuidStr" '.inbounds[1].settings.clients+=[$uuidStr1]' /opt/de_GWD/vtrui/config.json | sponge /opt/de_GWD/vtrui/config.json
done
chmod 644 /var/www/ssl/*.key

[[ $1 = "r" ]] && systemctl restart vtrui >/dev/null
