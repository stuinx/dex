#!/bin/bash
set -euo pipefail

updateCMD=$(jq -er '.update.updateCMD // empty' /opt/de_GWD/0conf 2>/dev/null)
updateCMDaddr=$(printf '%s\n' "$updateCMD" | grep -oE "https://[^[:space:]'\"\\)]+" | head -n 1) || {
  echo "update command does not contain an HTTPS download URL" >&2
  exit 1
}
updatePort=$(jq -er '.update.updatePort // empty' /opt/de_GWD/0conf 2>/dev/null)
[[ $updatePort =~ ^[1-9][0-9]{0,4}$ ]] && (( updatePort <= 65535 )) || {
  echo "invalid update port" >&2
  exit 1
}

tmp=$(mktemp /opt/de_GWD/.update.XXXXXX)
trap 'rm -f -- "$tmp"' EXIT
if ! wget -qO "$tmp" "$updateCMDaddr" || [[ ! -s $tmp ]]; then
  echo "update download failed" >&2
  exit 1
fi
chmod 0700 "$tmp"
mv -f -- "$tmp" /opt/de_GWD/update
trap - EXIT

systemctl stop nftables >/dev/null 2>&1 || true

rm -rf /etc/resolv.conf
cat << EOF >/etc/resolv.conf
nameserver 119.29.29.29
nameserver 180.76.76.76
nameserver 114.114.114.114
nameserver 223.5.5.5
EOF

pkill -x ttyd >/dev/null 2>&1 || true
tmux kill-session -t updateGWD >/dev/null 2>&1
sed -i "/ExecStart=/c\ExecStart=/usr/bin/tmux new -ds 'updateGWD' /usr/bin/ttyd -p $updatePort -o /opt/de_GWD/update" /etc/systemd/system/updateGWD.service
systemctl daemon-reload >/dev/null
