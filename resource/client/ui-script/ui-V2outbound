#!/bin/bash
tag=$1
address=$2
tls=$3
uuid=$4
path=$5
protocol=${6:-}
[[ $tls != null ]] || tls=""
[[ $path != null ]] || path=""
if [[ $uuid == *$'\n'* || $path == *$'\n'* || $tls == *$'\n'* ]]; then
  node=$(jq -ce --arg tag "$tag" --arg address "$address" '
    .v2nodeDIV.outboundNodes[$tag] as $saved |
    [.v2node[]? | select(.domain == $address and .uuid == $saved.uuid
      and (.path // "") == $saved.path and (.protocol // "vmess") == $saved.protocol)] |
    if length == 1 then .[0] else empty end' /opt/de_GWD/0conf) || { echo 'Ambiguous node; select the routing node again.' >&2; exit 1; }
  tls=$(jq -r '.tls // empty' <<< "$node")
  uuid=$(jq -r '.uuid' <<< "$node")
  path=$(jq -r '.path // empty' <<< "$node")
  protocol=$(jq -r '.protocol // "vmess"' <<< "$node")
fi
if [[ -z $protocol ]]; then
  protocol=$(jq -r --arg address "$address" --arg uuid "$uuid" --arg path "${path:-}" '
    [.v2node[]? | select((.domain == $address or (.domain + ":443") == $address) and .uuid == $uuid and (.path // "") == $path) | (.protocol // "vmess")] | unique |
    if length == 0 then "vmess" elif length == 1 then .[0] else "ambiguous" end' /opt/de_GWD/0conf) || exit 1
fi
[[ $protocol = vmess || $protocol = vless ]] || exit 1

if [[ -z $tag ]] || [[ -z $address ]] || [[ -z $uuid ]]; then
exit
fi

domain=$(echo $address | cut -d: -f1)
port=$(echo $address | cut -d: -f2 | grep '^[[:digit:]]*$')
[[ -z $port ]] && port="443"
[[ -z $tls ]] && tls=$domain

if [[ $tag = "default" ]]; then
muxSet='"enabled":true,"concurrency":1,"xudpConcurrency":1,"xudpProxyUDP443":"skip"'
else
muxSet='"enabled":true,"concurrency":1,"xudpConcurrency":1,"xudpProxyUDP443":"reject"'
fi

if [[ -z $path ]]; then
OBadd=`cat << EOF
    {
      "tag": "$tag",
      "protocol": "vmess",
      "settings": {
        "vnext": [
          {
            "address": "$domain",
            "port": $port,
            "users": [
              {
                "id": "$uuid",
                "alterId": 0,
                "security": "auto"
              }
            ]
          }
        ]
      },
      "streamSettings": {
        "network": "tcp",
        "sockopt": {
          "mark": 255,
          "tcpFastOpen": true,
          "tcpNoDelay": true
        }
      },
      "mux": {
        $muxSet
      }
    }
EOF
`
else
OBadd=`cat << EOF
    {
      "tag": "$tag",
      "protocol": "vmess",
      "settings": {
        "vnext": [
          {
            "address": "$domain",
            "port": $port,
            "users": [
              {
                "id": "$uuid",
                "alterId": 0,
                "security": "auto"
              }
            ]
          }
        ]
      },
      "streamSettings": {
        "network": "ws",
        "wsSettings": {
          "path": "$path",
          "headers": {
            "Host": "$tls"
          }
        },
        "security": "tls",
        "tlsSettings": {
          "serverName": "$tls",
          "allowInsecure": false
        },
        "sockopt": {
          "mark": 255,
          "tcpFastOpen": true,
          "tcpNoDelay": true
        }
      },
      "mux": {
        $muxSet
      }
    }
EOF
`
fi

if [[ $protocol = vless ]]; then
  OBadd=$(jq '.protocol="vless" | .settings.vnext[].users |= map(del(.alterId,.security) | .encryption="none")' <<< "$OBadd") || exit 1
fi
jq --argjson OBadd "$OBadd" '.outbounds+=[$OBadd]' /opt/de_GWD/vtrui/config.json | sponge /opt/de_GWD/vtrui/config.json
jq --arg tag "$tag" --arg uuid "$uuid" --arg path "${path:-}" --arg protocol "$protocol" \
  '.v2nodeDIV.outboundNodes[$tag]={uuid:$uuid,path:$path,protocol:$protocol}' /opt/de_GWD/0conf | sponge /opt/de_GWD/0conf
