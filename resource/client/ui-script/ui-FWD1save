#!/bin/bash
FWD1port=$(jq -r '.FORWARD.FWD1.port' /opt/de_GWD/0conf 2>/dev/null | grep -v '^null$')
FWD1uuid=$(jq -r '.FORWARD.FWD1.uuid[].FWD1uuid' /opt/de_GWD/0conf 2>/dev/null | grep -v '^null$')
FWD1upstream=$(jq -r '.FORWARD.FWD1.upstream' /opt/de_GWD/0conf 2>/dev/null | grep -v '^null$')
FWD1firstUUID=${FWD1uuid%%$'\n'*}
FWD1path="/${FWD1firstUUID: -6}"
[[ $FWD1port =~ ^[0-9]{1,5}$ ]] || { echo "FWD1 requires a valid port, UUID, and installed TLS certificate" >&2; exit 1; }
FWD1port=$((10#$FWD1port))
(( FWD1port >= 1 && FWD1port <= 65535 )) && [[ -s /var/www/ssl/de_GWD.cer && -s /var/www/ssl/de_GWD.key && -n $FWD1uuid ]] || { echo "FWD1 requires a valid port, UUID, and installed TLS certificate" >&2; exit 1; }

v2nodeID=$(jq -r --arg upstream "$FWD1upstream" '
  .v2node as $nodes |
  (if ($upstream | startswith("{")) then
    (try ($upstream | fromjson) catch {}) as $selected |
    [$nodes | to_entries[] | select(.value.domain == $selected.domain and .value.uuid == $selected.uuid and .value.path == $selected.path and .value.protocol == $selected.protocol and .value.tls == ($selected.tls // "") and .value.protocol == "vless")]
  else
    [$nodes | to_entries[] | select(.value.domain == $upstream and .value.protocol == "vless" and ((.value.path // "") | startswith("/")))]
  end) |
  if length == 1 then .[0].key else empty end
' /opt/de_GWD/0conf 2>/dev/null)
[[ $v2nodeID =~ ^[0-9]+$ ]] || { echo "FWD1 upstream must uniquely identify a VLESS WebSocket TLS node" >&2; exit 1; }

address=$(jq -r --arg v2nodeID "$v2nodeID" ".v2node[$v2nodeID].domain" /opt/de_GWD/0conf 2>/dev/null | grep -v '^null$')
domain=$(echo $address | cut -d: -f1)
port=$(echo $address | cut -d: -f2 | grep '^[[:digit:]]*$')
[[ -z $port ]] && port="443"
tls=$(jq -r --arg v2nodeID "$v2nodeID" ".v2node[$v2nodeID].tls" /opt/de_GWD/0conf 2>/dev/null | grep -v '^null$')
uuid=$(jq -r --arg v2nodeID "$v2nodeID" ".v2node[$v2nodeID].uuid" /opt/de_GWD/0conf 2>/dev/null | grep -v '^null$')
path=$(jq -r --arg v2nodeID "$v2nodeID" ".v2node[$v2nodeID].path" /opt/de_GWD/0conf 2>/dev/null | grep -v '^null$')
[[ -n $tls ]] || tls=$domain
[[ -n $domain && -n $uuid && $path == /* ]] || { echo "FWD1 upstream must be a VLESS WebSocket TLS node" >&2; exit 1; }

[[ $port =~ ^[0-9]{1,5}$ ]] || exit 1
port=$((10#$port))
(( port >= 1 && port <= 65535 )) || exit 1
[[ $uuid =~ ^[0-9a-fA-F]{8}(-[0-9a-fA-F]{4}){3}-[0-9a-fA-F]{12}$ ]] || exit 1
clients=$(jq -ce '.FORWARD.FWD1.uuid | if type == "array" and length > 0 and all(.[]; .FWD1uuid | type == "string" and test("^[0-9a-fA-F]{8}(-[0-9a-fA-F]{4}){3}-[0-9a-fA-F]{12}$")) then map({id:.FWD1uuid}) else error("Invalid FWD1 UUID list") end' /opt/de_GWD/0conf) || exit 1
mkdir -p /opt/de_GWD/vtrui1 || exit 1
configTemp=$(mktemp /opt/de_GWD/vtrui1/config.json.XXXXXX) || exit 1
binaryTemp=$(mktemp /opt/de_GWD/vtrui1/vtrui1.XXXXXX) || { rm -f "$configTemp"; exit 1; }
trap 'rm -f "$configTemp" "$binaryTemp"' EXIT
if [[ -f /opt/de_GWD/vtrui1/config.json ]]; then
  cp -p /opt/de_GWD/vtrui1/config.json "$configTemp" || exit 1
else
  chmod 666 "$configTemp" || exit 1
fi
jq -n --argjson inboundPort "$FWD1port" --arg inboundPath "$FWD1path" --argjson clients "$clients" \
  --arg domain "$domain" --argjson port "$port" --arg tls "$tls" --arg uuid "$uuid" --arg path "$path" '
  {log:{access:"none",error:"none",loglevel:"none"},
   dns:{tag:"dnsflow",queryStrategy:"UseIP",disableCache:true,servers:["tcp+local://127.0.0.1:53"]},
   routing:{rules:[]},
   inbounds:[{port:$inboundPort,"protocol": "vless",settings:{decryption:"none",clients:$clients},
     streamSettings:{"network": "ws", "security": "tls",wsSettings:{path:$inboundPath},
       tlsSettings:{certificates:[{certificateFile:"/var/www/ssl/de_GWD.cer",keyFile:"/var/www/ssl/de_GWD.key"}]}}}],
   outbounds:[{"protocol": "vless",settings:{vnext:[{address:$domain,port:$port,users:[{id:$uuid,encryption:"none"}]}]},
     streamSettings:{"network": "ws",wsSettings:{path:$path,headers:{Host:$tls}},"security": "tls",
       tlsSettings:{serverName:$tls,allowInsecure:false},sockopt:{mark:255,tcpFastOpen:true,tcpNoDelay:true}}},
     {tag:"direct",protocol:"freedom",streamSettings:{sockopt:{mark:255,tcpFastOpen:true}}}]}' >"$configTemp" || exit 1
cp -p /opt/de_GWD/vtrui/vtrui "$binaryTemp" && chmod +x "$binaryTemp" || exit 1
mv -f "$binaryTemp" /opt/de_GWD/vtrui1/vtrui1 && mv -f "$configTemp" /opt/de_GWD/vtrui1/config.json || exit 1
chmod 644 /var/www/ssl/*.key

rm -rf /lib/systemd/system/vtrui1.service
cat << "EOF" >/etc/systemd/system/vtrui1.service
[Unit]
Description=vtrui1
After=network.target nss-lookup.target

[Service]
User=root
Type=simple
ExecStart=/opt/de_GWD/vtrui1/vtrui1 run -config /opt/de_GWD/vtrui1/config.json
Restart=always
RestartSec=2
TimeoutStopSec=5

Nice=-9
AmbientCapabilities=CAP_NET_RAW CAP_NET_ADMIN CAP_NET_BIND_SERVICE
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
EOF
systemctl daemon-reload >/dev/null
systemctl restart vtrui1
if [[ $? -ne 0 ]]; then
sed -i '/Nice=/d' /etc/systemd/system/vtrui1.service
systemctl daemon-reload >/dev/null
systemctl restart vtrui1
fi
systemctl enable vtrui1 >/dev/null 2>&1
