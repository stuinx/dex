#!/bin/bash
clear
RED='\E[1;31m'
GREEN='\E[1;32m'
YELLOW='\E[1;33m'
BLUE='\E[1;34m'
PURPLE='\E[1;35m'
CYAN='\E[1;36m'
WHITE='\E[1;37m'
cRES='\E[0m'
dockerComposeVer_default="v5.5.1"
dockerComposeSha256_x86_64="db1889184726840f75c4f9c001048430d4f25b3be3cb084d3ddd762bc0aed576"
dockerComposeSha256_aarch64="732e3a84c1a0f67256ce80bc2598a24546b10ca05f9faa97efceb1171ece2ef7"



installDocker(){
local debianCodename
debianCodename=$( . /etc/os-release && printf '%s' "$VERSION_CODENAME" )
install -m 0644 -D /dev/null /etc/apt/keyrings/docker.asc
curl -fsSL https://mirrors.ustc.edu.cn/docker-ce/linux/debian/gpg -o /etc/apt/keyrings/docker.asc || return 1
rm -f /etc/apt/sources.list.d/docker.list
cat << EOF >/etc/apt/sources.list.d/docker.sources
Types: deb
URIs: https://mirrors.ustc.edu.cn/docker-ce/linux/debian
Suites: $debianCodename
Components: stable
Architectures: $(dpkg --print-architecture)
Signed-By: /etc/apt/keyrings/docker.asc
EOF

unset aptPKG
[[ -z $(dpkg -l | awk '{print$2}' | grep '^docker-ce$') ]] && aptPKG+=(docker-ce)
[[ -z $(dpkg -l | awk '{print$2}' | grep '^docker-ce-cli$') ]] && aptPKG+=(docker-ce-cli)
[[ -z $(dpkg -l | awk '{print$2}' | grep '^containerd.io$') ]] && aptPKG+=(containerd.io)
if [[ -n $aptPKG ]]; then
apt-get -o Acquire::Retries=2 -o Acquire::ForceIPv4=true -o Acquire::http::Timeout=30 -o Acquire::https::Timeout=30 -o Acquire::http::Pipeline-Depth=0 -o Acquire::https::Pipeline-Depth=0 update -o APT::Update::Error-Mode=any || return 1
apt-get -o Acquire::Retries=2 -o Acquire::ForceIPv4=true -o Acquire::http::Timeout=30 -o Acquire::https::Timeout=30 -o Acquire::http::Pipeline-Depth=0 -o Acquire::https::Pipeline-Depth=0 install -y $(echo ${aptPKG[@]}) || return 1
fi

if [[ -n $(dpkg -l | awk '{print$2}' | grep '^docker-ce$') ]] && [[ -n $(dpkg -l | awk '{print$2}' | grep '^containerd.io$') ]]; then
mkdir -p /etc/docker/
systemctl stop docker containerd
cat << EOF >/etc/docker/daemon.json
{
  "iptables": false
}
EOF
systemctl restart docker
fi

dockerComposeVer="${DE_GWD_DOCKER_COMPOSE_VERSION:-$dockerComposeVer_default}"
dockerComposeOS=$(uname -s | tr '[:upper:]' '[:lower:]')
dockerComposeArch=$(uname -m)
[[ $dockerComposeOS = "linux" ]] || { echo -e "${WHITE}Docker Compose${RED} Unsupported OS${cRES}"; return 1; }
[[ $dockerComposeArch = "x86_64" || $dockerComposeArch = "aarch64" ]] || { echo -e "${WHITE}Docker Compose${RED} Unsupported architecture${cRES}"; return 1; }
dockerComposeExpectedSha256=""
if [[ -z ${DE_GWD_DOCKER_COMPOSE_VERSION:-} ]]; then
  case "$dockerComposeArch" in
    x86_64) dockerComposeExpectedSha256=$dockerComposeSha256_x86_64 ;;
    aarch64) dockerComposeExpectedSha256=$dockerComposeSha256_aarch64 ;;
  esac
fi

curl -fsSL -L "https://github.com/docker/compose/releases/download/$dockerComposeVer/docker-compose-$dockerComposeOS-$dockerComposeArch" -o /tmp/docker-compose || {
  echo -e "${WHITE}Docker Compose${RED} Download Failed${cRES}"
  return 1
}
if [[ -n $dockerComposeExpectedSha256 ]] && [[ $(sha256sum /tmp/docker-compose 2>/dev/null | awk '{print$1}') != "$dockerComposeExpectedSha256" ]]; then
  echo -e "${WHITE}Docker Compose${RED} Checksum Failed${cRES}"
  return 1
fi
mv -f /tmp/docker-compose /usr/local/bin/docker-compose
chmod +x /usr/local/bin/docker-compose

echo -e "${WHITE}[ ${GREEN}✓ ${WHITE}]\c" && echo -e "\t${WHITE}Install Docker${cRES}"
}



uninstallDocker(){
rm -f /etc/apt/sources.list.d/docker.list /etc/apt/sources.list.d/docker.sources
apt remove --purge docker-ce docker-ce-cli containerd.io
rm -rf /usr/local/bin/docker-compose

echo -e "${WHITE}[ ${GREEN}✓ ${WHITE}]\c" && echo -e "\t${WHITE}Uninstall Docker${cRES}"
}



start_menu(){
    echo -e "${GREEN}=============================== ${cRES}"
    echo -e "${GREEN}         Docker${cRES}"
    echo -e "${GREEN}=============================== ${cRES}"
    echo -e "${GREEN}1. Install Docker${cRES}"
   echo -e "${YELLOW}2. Uninstall Docker${cRES}"
    echo ""
    read -p "Select:" num
    case "$num" in
    1)
    installDocker
    start_menu
    ;;
    2)
    uninstallDocker
    start_menu
    ;;
    *)
    clear
    echo -e "${RED}Wrong number${cRES}"
    sleep 1s
    start_menu
    ;;
    esac
}

start_menu
