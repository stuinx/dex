#!/bin/bash
rm -rf /opt/de_GWD/__MACOSX /var/www/html/__MACOSX

if jq -e 'type == "object"' /opt/de_GWD/0conf >/dev/null 2>&1; then
    cp -f /opt/de_GWD/0conf /opt/de_GWD/0conf_bak
elif jq -e 'type == "object"' /opt/de_GWD/0conf_bak >/dev/null 2>&1; then
    cp -f /opt/de_GWD/0conf_bak /opt/de_GWD/0conf || exit 1
    chmod 666 /opt/de_GWD/0conf
else
    echo 'Cannot back up or restore invalid configuration' >&2
    exit 1
fi
