domain=$(awk '/server_name/ {print$2;exit}' /etc/nginx/conf.d/default.conf 2>/dev/null | sed 's/.$//')

enabled=$(jq -c '[.extra.inbounds[] | select(.status == "on" and .type == "vless-ws")]' /opt/de_GWD/0conf 2>/dev/null)
