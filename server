while true; do
echo -e "${BLUE}-------------------------------------------------- ${cRES}"
echo -e "${GREEN}dokodemo-door rules${cRES}"
if [[ -f $settings ]] && [[ $(jq -r '.rules | length' "$settings" 2>/dev/null || echo 0) -gt 0 ]]; then
  extraDokodemoJqTarget "$settings"
else
  echo -e "${YELLOW}No dokodemo-door rules${cRES}"
fi
echo -e "${BLUE}-------------------------------------------------- ${cRES}"
echo -e "${GREEN}================================ ${cRES}"
echo -e "${GREEN} dokodemo-door${cRES}"
echo -e "${GREEN}[1]: Add${cRES}"
echo -e "${GREEN}[2]: Delete${cRES}"
echo -e "${GREEN}[3]: Disable all${cRES}"
echo -e "${GREEN}[0]: Back${cRES}"
echo -e "${GREEN}================================ ${cRES}"
read -s -n 1 sw
echo
[[ $sw = "0" || -z $sw ]] && return
extraSettingsBegin "$settings" || return 1
if [[ $sw = "3" ]]; then
  curCount=$(jq -r '.rules | length' "$settings" 2>/dev/null || echo 0)
  if [[ ! $curCount =~ ^[0-9]+$ ]] || (( curCount == 0 )); then
    echo -e "${YELLOW}No dokodemo-door rules to disable${cRES}"
    extraSettingsRollback
    continue
  fi
  printf '%s\n' '{"enabled":false,"rules":[]}' >"$settings" || { extraSettingsRollback; return 1; }
  if ! extraXrayApply || ! extraNginxApply; then
    extraSettingsRollback
    return 1
  fi
  extraSettingsCommit
  echo -e "${WHITE}[ ${GREEN}✓ ${WHITE}]\c" && echo -e "\t${WHITE}dokodemo-door ${RED}Disabled${cRES}"
  continue
fi
if [[ ! -f $settings ]]; then
  printf '%s\n' '{"enabled":true,"rules":[]}' >"$settings" || { extraSettingsRollback; return 1; }
fi
if [[ $sw = "2" ]]; then
  curCount=$(jq -r '.rules | length' "$settings" 2>/dev/null || echo 0)
  if [[ ! $curCount =~ ^[0-9]+$ ]] || (( curCount == 0 )); then
    echo -e "${YELLOW}No dokodemo-door rules to delete${cRES}"
    extraSettingsRollback
    continue
  fi
  echo -e "${GREEN}Listen port to delete, or all${cRES}"
  read delID
  if [[ -z $delID ]]; then
    extraSettingsRollback
    continue
  fi
  if [[ $delID = all ]]; then
    printf '%s\n' '{"enabled":false,"rules":[]}' >"$settings" || { extraSettingsRollback; return 1; }
  elif [[ $delID =~ ^[0-9]+$ ]]; then
    if ! jq -e --argjson p "$delID" '.rules[] | select(.port == $p)' "$settings" >/dev/null 2>&1; then
      echo -e "${RED}Port $delID not found in rules${cRES}"
      extraSettingsRollback
      continue
    fi
    extraXrayJqUpdate "$settings" --argjson p "$delID" '.rules |= map(select(.port != $p))' || { extraSettingsRollback; return 1; }
    if [[ $(jq -r '.rules | length' "$settings" 2>/dev/null || echo 0) -eq 0 ]]; then
      extraXrayJqUpdate "$settings" '.enabled=false' || { extraSettingsRollback; return 1; }
    fi
  else
    echo -e "${RED}Invalid port${cRES}"
    extraSettingsRollback
    continue
  fi
  if ! extraXrayApply || ! extraNginxApply; then
    extraSettingsRollback
    return 1
  fi
  extraSettingsCommit
  echo -e "${WHITE}[ ${GREEN}✓ ${WHITE}]\c" && echo -e "\t${WHITE}dokodemo-door ${GREEN}Deleted${cRES}"
  continue
fi
if [[ $sw != "1" ]]; then
  extraSettingsRollback
  continue
fi
echo -e "${GREEN} Listen port${cRES}"
read listenPort
[[ $listenPort =~ ^[1-9][0-9]{0,4}$ ]] || { extraSettingsRollback; echo -e "${RED}Invalid port${cRES}"; continue; }
extraXPortFree "$listenPort" || { extraSettingsRollback; continue; }
echo -e "${GREEN} Target host:port${cRES}"
read targetInput
parsed=$(parseDomainPort "$targetInput" 2>/dev/null) || { extraSettingsRollback; echo -e "${RED}Invalid target${cRES}"; continue; }
read -r target targetPort <<<"$parsed"
echo -e "${GREEN} Network tcp / udp / tcp,udp (empty = tcp,udp)${cRES}"
read network
network=$(extraDokodemoNormalizeNetwork "$network") || { extraSettingsRollback; echo -e "${RED}Invalid network${cRES}"; continue; }
extraXrayJqUpdate "$settings" --argjson port "$listenPort" --arg target "$target" --argjson targetPort "$targetPort" --arg network "$network" \
  '.enabled=true | .rules += [{port:$port,target:$target,targetPort:$targetPort,network:$network}]' || { extraSettingsRollback; return 1; }
if ! extraXrayApply || ! extraNginxApply; then
  extraSettingsRollback
  return 1
fi
extraSettingsCommit
echo -e "${BLUE}Listen:  ${YELLOW}$listenPort${cRES}"
echo -e "${BLUE}Target:  ${YELLOW}$(formatDomainPort "$target" "$targetPort")${cRES}"
echo -e "${BLUE}Network: ${YELLOW}$network${cRES}"
echo -e "${WHITE}[ ${GREEN}✓ ${WHITE}]\c" && echo -e "\t${WHITE}dokodemo-door ${GREEN}Added${cRES}"
done
}

