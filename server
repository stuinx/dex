extraXPortFree(){
p=$1
allowmain=$2
if [[ -z $(echo $p | grep '^[[:digit:]]*$') ]]; then
echo -e "${RED}Invalid port: $p${cRES}"
return 1
fi
if [[ $p = "80" ]]; then
echo -e "${RED}Port 80 is used for HTTP redirect${cRES}"
return 1
fi
mainport=$(awk '/ssl .* reuseport/ {print$2}' /etc/nginx/conf.d/default.conf 2>/dev/null | grep '^[[:digit:]]*$')
[[ -z $mainport ]] && mainport="443"
if [[ $p = "$mainport" ]] && [[ $allowmain != "allowmain" ]]; then
echo -e "${RED}Port $p is the main Xray/Nginx port${cRES}"
return 1
fi
if [[ $(jq -r --argjson p $p '[.inbounds[] | select(.port == $p)] | length' /opt/de_GWD/vtrui/config.json 2>/dev/null) != "0" ]]; then
echo -e "${RED}Port $p already in use by Xray${cRES}"
return 1
fi
if [[ $(jq -r --argjson p $p '[(.extra // {}).inbounds[]? | select(.port == $p)] | length' /opt/de_GWD/0conf 2>/dev/null) != "0" ]]; then
echo -e "${RED}Port $p already in use by an extra inbound${cRES}"
return 1
fi
return 0
}



