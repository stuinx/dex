extraXrayInbounds(){
[[ -s $extraSettings ]] || return 0
extra_validateSettings "$extraSettings" || return 1

local config=/opt/de_GWD/vtrui/config.json
local enabled vlessPort vlessUUID vlessPath realityPort realityUUID realityFlow realityDest realityServerName realityPrivateKey realityShortId socksPort socksUser socksPassword rulesJson

enabled=$(jq -r '.vless_ws.enabled // false' "$extraSettings")
if [[ $enabled = "true" ]]; then
  vlessPort=$(jq -r '.vless_ws.port' "$extraSettings")
  vlessUUID=$(jq -r '.vless_ws.uuid' "$extraSettings")
  vlessPath=$(jq -r '.vless_ws.path' "$extraSettings")
  jq --arg uuid "$vlessUUID" --arg path "$vlessPath" '
    .inbounds += [{
      "tag":"extra-vless-ws",
      "listen":"127.0.0.1",
      "port":9891,
      "protocol":"vless",
      "settings":{"clients":[{"id":$uuid}],"decryption":"none"},
      "streamSettings":{
        "network":"ws",
        "security":"none",
        "wsSettings":{"path":$path},
        "sockopt":{"tcpFastOpen":true,"tcpMptcp":true}
      },
      "sniffing":{"enabled":true,"destOverride":["http","tls","quic"]}
    }]
  ' "$config" | sponge "$config" || return 1
fi

enabled=$(jq -r '.reality.enabled // false' "$extraSettings")
if [[ $enabled = "true" ]]; then
  realityPort=$(jq -r '.reality.port' "$extraSettings")
  realityUUID=$(jq -r '.reality.uuid' "$extraSettings")
  realityFlow=$(jq -r '.reality.flow // empty' "$extraSettings")
  realityDest=$(jq -r '.reality.dest' "$extraSettings")
  realityServerName=$(jq -r '.reality.serverName' "$extraSettings")
  realityPrivateKey=$(jq -r '.reality.privateKey' "$extraSettings")
  realityShortId=$(jq -r '.reality.shortId' "$extraSettings")
  jq --argjson port "$realityPort" --arg uuid "$realityUUID" --arg flow "$realityFlow" --arg dest "$realityDest" --arg serverName "$realityServerName" --arg privateKey "$realityPrivateKey" --arg shortId "$realityShortId" '
    .inbounds += [{
      "tag":"extra-vless-reality",
      "listen":"0.0.0.0",
      "port":$port,
      "protocol":"vless",
      "settings":{
        "clients":[({ "id":$uuid } + (if $flow == "" then {} else {"flow":$flow} end))],
        "decryption":"none"
      },
      "streamSettings":{
        "network":"tcp",
        "security":"reality",
        "realitySettings":{
          "show":false,
          "dest":$dest,
          "xver":0,
          "serverNames":[$serverName],
          "privateKey":$privateKey,
          "shortIds":[$shortId]
        },
        "sockopt":{"tcpFastOpen":true,"tcpMptcp":true}
      }
    }]
  ' "$config" | sponge "$config" || return 1
fi

enabled=$(jq -r '.socks5.enabled // false' "$extraSettings")
if [[ $enabled = "true" ]]; then
  socksPort=$(jq -r '.socks5.port' "$extraSettings")
  socksUser=$(jq -r '.socks5.user' "$extraSettings")
  socksPassword=$(jq -r '.socks5.password' "$extraSettings")
  jq --argjson port "$socksPort" --arg user "$socksUser" --arg password "$socksPassword" '
    .inbounds += [{
      "tag":"extra-socks5",
      "listen":"0.0.0.0",
      "port":$port,
      "protocol":"socks",
      "settings":{
        "auth":"password",
        "accounts":[{"user":$user,"pass":$password}],
        "udp":true
      }
    }]
  ' "$config" | sponge "$config" || return 1
fi

enabled=$(jq -r '.dokodemo.enabled // false' "$extraSettings")
if [[ $enabled = "true" ]]; then
  rulesJson=$(jq -c '.dokodemo.rules' "$extraSettings")
  jq --argjson rules "$rulesJson" '
    .inbounds += (
      $rules | to_entries | map({
        "tag":("extra-dokodemo-" + (.key|tostring)),
        "listen":"0.0.0.0",
        "port":(.value.port|tonumber),
        "protocol":"dokodemo-door",
        "settings":{
          "address":.value.target,
          "port":(.value.targetPort|tonumber),
          "network":.value.network
        }
      })
    )
  ' "$config" | sponge "$config" || return 1
fi
}



extra_applyCandidate(){
local candidate=$1
[[ -s $candidate ]] || return 1
extra_validateSettings "$candidate" || return 1

local backupDir settingsExisted=0 configExisted=0 defaultExisted=0 vlessExisted=0 redirectExisted=0 hstsExisted=0 sslExisted=0
local wasNginx wasVtrui status=0
backupDir=$(mktemp -d /tmp/de_GWD-extra.XXXXXX) || return 1

if [[ -e $extraSettings || -L $extraSettings ]]; then cp -a "$extraSettings" "$backupDir/settings"; settingsExisted=1; fi
if [[ -e /opt/de_GWD/vtrui/config.json || -L /opt/de_GWD/vtrui/config.json ]]; then cp -a /opt/de_GWD/vtrui/config.json "$backupDir/config"; configExisted=1; fi
if [[ -e /etc/nginx/conf.d/default.conf || -L /etc/nginx/conf.d/default.conf ]]; then cp -a /etc/nginx/conf.d/default.conf "$backupDir/default"; defaultExisted=1; fi
if [[ -e $extraVlessWSConf || -L $extraVlessWSConf ]]; then cp -a "$extraVlessWSConf" "$backupDir/vless"; vlessExisted=1; fi
if [[ -e /etc/nginx/conf.d/80.conf || -L /etc/nginx/conf.d/80.conf ]]; then cp -a /etc/nginx/conf.d/80.conf "$backupDir/redirect"; redirectExisted=1; fi
if [[ -e /etc/nginx/conf.d/.HSTS || -L /etc/nginx/conf.d/.HSTS ]]; then cp -a /etc/nginx/conf.d/.HSTS "$backupDir/hsts"; hstsExisted=1; fi
if [[ -e /etc/nginx/conf.d/.ssl_certs || -L /etc/nginx/conf.d/.ssl_certs ]]; then cp -a /etc/nginx/conf.d/.ssl_certs "$backupDir/ssl"; sslExisted=1; fi

wasNginx=$(systemctl is-active nginx 2>/dev/null || true)
wasVtrui=$(systemctl is-active vtrui 2>/dev/null || true)

if [[ -e $extraSettings ]]; then
  cat "$candidate" > "$extraSettings" || status=1
else
  mv -f "$candidate" "$extraSettings" || status=1
fi

if (( status == 0 )) && ! extraNginxWebConf; then status=1; fi
if (( status == 0 )) && ! XrayInbound; then status=1; fi
if (( status == 0 )) && ! XrayOutboundDirect; then status=1; fi
if (( status == 0 )) && ! /opt/de_GWD/vtrui/vtrui run -test -confdir /opt/de_GWD/vtrui >/dev/null 2>&1; then status=1; fi
if (( status == 0 )) && ! nginx -t; then status=1; fi

if (( status == 0 )); then
  if [[ $wasNginx = "active" ]]; then
    systemctl force-reload nginx >/dev/null 2>&1 || status=1
  else
    systemctl start nginx >/dev/null 2>&1 || status=1
  fi
fi
if (( status == 0 )); then
  systemctl restart vtrui >/dev/null 2>&1 || status=1
  systemctl is-active --quiet vtrui || status=1
fi

if (( status != 0 )); then
  if (( settingsExisted )); then rm -f "$extraSettings"; cp -a "$backupDir/settings" "$extraSettings"; else rm -f "$extraSettings"; fi
  if (( configExisted )); then rm -f /opt/de_GWD/vtrui/config.json; cp -a "$backupDir/config" /opt/de_GWD/vtrui/config.json; else rm -f /opt/de_GWD/vtrui/config.json; fi
  if (( defaultExisted )); then rm -f /etc/nginx/conf.d/default.conf; cp -a "$backupDir/default" /etc/nginx/conf.d/default.conf; else rm -f /etc/nginx/conf.d/default.conf; fi
  if (( vlessExisted )); then rm -f "$extraVlessWSConf"; cp -a "$backupDir/vless" "$extraVlessWSConf"; else rm -f "$extraVlessWSConf"; fi
  if (( redirectExisted )); then rm -f /etc/nginx/conf.d/80.conf; cp -a "$backupDir/redirect" /etc/nginx/conf.d/80.conf; else rm -f /etc/nginx/conf.d/80.conf; fi
  if (( hstsExisted )); then rm -f /etc/nginx/conf.d/.HSTS; cp -a "$backupDir/hsts" /etc/nginx/conf.d/.HSTS; else rm -f /etc/nginx/conf.d/.HSTS; fi
  if (( sslExisted )); then rm -f /etc/nginx/conf.d/.ssl_certs; cp -a "$backupDir/ssl" /etc/nginx/conf.d/.ssl_certs; else rm -f /etc/nginx/conf.d/.ssl_certs; fi
  if [[ $wasVtrui = "active" ]]; then systemctl restart vtrui >/dev/null 2>&1; else systemctl stop vtrui >/dev/null 2>&1; fi
  if [[ $wasNginx = "active" ]]; then systemctl force-reload nginx >/dev/null 2>&1; else systemctl stop nginx >/dev/null 2>&1; fi
  rm -rf "$backupDir"
  return 1
fi

rm -f "$candidate" "$backupDir"/*
rm -rf "$backupDir"
return 0
}



