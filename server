rproxyS_init(){
local settings="/opt/de_GWD/RproxyS/settings.json"
local config="/opt/de_GWD/RproxyS/config.json"
mkdir -p /opt/de_GWD/RproxyS

if [[ ! -s $settings ]] && [[ -s $config ]]; then
  local tunnelPort tunnelUUID inUUID mapping
  tunnelPort=$(jq -r '.inbounds[0].port // empty' "$config" 2>/dev/null)
  tunnelUUID=$(jq -r '.inbounds[0].settings.clients[0].id // empty' "$config" 2>/dev/null)
  inUUID=$(jq -c '[.inbounds[0].settings.clients[1:][]? | {RproxyS0uuid:.id,RproxyS0mark:""}]' "$config" 2>/dev/null)
  mapping=$(jq -c '[.inbounds[]? | select((.tag // "") | startswith("mapping")) | {port:.port,protocol:(.settings.network // "tcp")}]' "$config" 2>/dev/null)
  if rproxyS_validPort "$tunnelPort" && rproxyS_validUUID "$tunnelUUID" && [[ -n $inUUID ]] && [[ -n $mapping ]]; then
    jq -n --argjson port "$tunnelPort" --arg uuid "$tunnelUUID" --argjson inUUID "$inUUID" --argjson mapping "$mapping" \
      '{tunnel:{port:$port,uuid:$uuid},inStatus:(if ($inUUID|length)>0 then "on" else "off" end),mappingStatus:(if ($mapping|length)>0 then "on" else "off" end),inUUID:$inUUID,mapping:$mapping}' > "$settings"
  fi
fi

if [[ -s $settings ]]; then
  jq empty "$settings" >/dev/null 2>&1 || return 1
fi
}



rproxyS_newSettings(){
local settings="/opt/de_GWD/RproxyS/settings.json"
rproxyS_init || return 1
if [[ ! -s $settings ]]; then
  jq -n '{tunnel:{},inStatus:"off",mappingStatus:"off",inUUID:[],mapping:[]}' > "$settings" || return 1
fi
}



rproxyS_requireTunnel(){
local settings="/opt/de_GWD/RproxyS/settings.json"
rproxyS_init || { echo -e "${WHITE}RproxyS${RED} Settings are invalid${cRES}"; return 1; }
if [[ ! -s $settings ]]; then
  echo -e "${WHITE}RproxyS${YELLOW} Configure the tunnel first${cRES}"
  return 1
fi
local tunnelPort tunnelUUID
tunnelPort=$(jq -r '.tunnel.port // empty' "$settings")
tunnelUUID=$(jq -r '.tunnel.uuid // empty' "$settings")
if ! rproxyS_validPort "$tunnelPort" || ! rproxyS_validUUID "$tunnelUUID"; then
  echo -e "${WHITE}RproxyS${YELLOW} Configure a valid tunnel first${cRES}"
  return 1
fi
}



rproxyS_validateSettings(){
local settings=${1:-/opt/de_GWD/RproxyS/settings.json}
local tunnelPort tunnelUUID inStatus mappingStatus mappingPort mappingProtocol
[[ -s $settings ]] || return 1
jq -e '
  type == "object" and
  (.tunnel | type == "object") and
  (.inUUID | type == "array") and
  (.mapping | type == "array") and
  all(.inUUID[]; type == "object" and (.RproxyS0uuid | type == "string") and (.RproxyS0uuid | test("^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"))) and
  all(.mapping[]; type == "object" and (.port | type == "number") and (.protocol | type == "string")) and
  ([.inUUID[]?.RproxyS0uuid] | length == (unique | length)) and
  ([.mapping[]?.port] | length == (unique | length)) and
  ([.tunnel.port] + [.mapping[]?.port] | length == (unique | length))
' "$settings" >/dev/null 2>&1 || return 1

tunnelPort=$(jq -r '.tunnel.port // empty' "$settings")
tunnelUUID=$(jq -r '.tunnel.uuid // empty' "$settings")
inStatus=$(jq -r '.inStatus // "off"' "$settings")
mappingStatus=$(jq -r '.mappingStatus // "off"' "$settings")
rproxyS_validPort "$tunnelPort" || return 1
rproxyS_validUUID "$tunnelUUID" || return 1
[[ $inStatus = "on" || $inStatus = "off" ]] || return 1
[[ $mappingStatus = "on" || $mappingStatus = "off" ]] || return 1
while IFS=$'\t' read -r mappingPort mappingProtocol; do
  [[ -n $mappingPort ]] || continue
  rproxyS_validPort "$mappingPort" || return 1
  rproxyS_validProtocol "$mappingProtocol" || return 1
  [[ $mappingPort != "$tunnelPort" ]] || return 1
done < <(jq -r '.mapping[]? | [.port,.protocol] | @tsv' "$settings")
return 0
}



rproxyS_replaceFile(){
local source=$1 target=$2
[[ -f $source ]] || return 1
if [[ -e $target || -L $target ]]; then
  [[ -f $target && ! -L $target ]] || return 1
  cat "$source" > "$target" || return 1
else
  mv -f "$source" "$target" || return 1
fi
}



rproxyS_pendingSettingsBackup(){
printf '/tmp/de_GWD_RproxyS_settings.%s.pending\n' "$$"
}



rproxyS_updateSettings(){
local settings="/opt/de_GWD/RproxyS/settings.json"
local tempFile backupFile backupCreated=0
rproxyS_init || return 1
[[ -s $settings ]] || return 1
tempFile=$(mktemp /tmp/de_GWD_RproxyS_settings.XXXXXX) || return 1
jq "$@" "$settings" > "$tempFile" || { rm -f "$tempFile"; return 1; }
rproxyS_validateSettings "$tempFile" || { rm -f "$tempFile"; echo -e "${WHITE}RproxyS${RED} Invalid settings${cRES}"; return 1; }
backupFile=$(rproxyS_pendingSettingsBackup)
if [[ ! -e $backupFile ]]; then
  cp -a "$settings" "$backupFile" || { rm -f "$tempFile"; return 1; }
  backupCreated=1
fi
if ! rproxyS_replaceFile "$tempFile" "$settings"; then
  (( backupCreated )) && rm -f "$backupFile"
  rm -f "$tempFile"
  return 1
fi
rm -f "$tempFile"
}



rproxyS_portAvailable(){
deGWD_featurePortAvailable "$@"
}



rproxyS_portInSettings(){
local checkPort="$1"
local settings="/opt/de_GWD/RproxyS/settings.json"
jq -e --argjson port "$checkPort" '(.tunnel.port == $port) or any(.mapping[]?; .port == $port)' "$settings" >/dev/null 2>&1
}



rproxyS_writeConfig(){
local settings="/opt/de_GWD/RproxyS/settings.json"
local config="/opt/de_GWD/RproxyS/config.json"
local tempDir tempFile tempNext
local tunnelPort tunnelUUID
rproxyS_requireTunnel || return 1
rproxyS_validateSettings "$settings" || { echo -e "${WHITE}RproxyS${RED} Settings are invalid${cRES}"; return 1; }

tunnelPort=$(jq -r '.tunnel.port' "$settings")
tunnelUUID=$(jq -r '.tunnel.uuid' "$settings")
tempDir=$(mktemp -d /tmp/de_GWD_RproxyS_config.XXXXXX) || return 1
tempFile="$tempDir/config.json"
tempNext="$tempDir/config.next.json"
jq -n --argjson port "$tunnelPort" --arg uuid "$tunnelUUID" '
{
  "log":{"access":"none","error":"none","loglevel":"none"},
  "dns":{"queryStrategy":"UseIP","disableCache":true,"servers":["tcp+local://127.0.0.1:53"]},
  "routing":{"rules":[
    {"type":"field","inboundTag":["reverseTunnel"],"domain":["full:reverse.localhost"],"outboundTag":"portal"},
    {"type":"field","inboundTag":["reverseTunnel"],"outboundTag":"portal"}
  ]},
  "reverse":{"portals":[{"tag":"portal","domain":"reverse.localhost"}]},
  "inbounds":[{
    "tag":"reverseTunnel",
    "port":$port,
    "protocol":"vmess",
    "settings":{"clients":[{"id":$uuid,"alterId":0}]},
    "streamSettings":{"network":"tcp"}
  }]
}' > "$tempFile" || { rm -rf "$tempDir"; return 1; }

if [[ $(jq -r '.mappingStatus // "off"' "$settings") = "on" ]]; then
  local mappingNum=0 mappingPort mappingProtocol routingMapping
  while IFS=$'\t' read -r mappingPort mappingProtocol; do
    [[ -z $mappingPort ]] && continue
    rproxyS_validPort "$mappingPort" || { echo -e "${WHITE}RproxyS${RED} Invalid mapping port${cRES}"; rm -rf "$tempDir"; return 1; }
    rproxyS_validProtocol "$mappingProtocol" || { echo -e "${WHITE}RproxyS${RED} Invalid mapping protocol${cRES}"; rm -rf "$tempDir"; return 1; }
    routingMapping="mapping$mappingNum"
    jq --arg tag "$routingMapping" --argjson port "$mappingPort" --arg protocol "$mappingProtocol" '
      .routing.rules += [{"type":"field","inboundTag":[$tag],"outboundTag":"portal"}] |
      .inbounds += [{"tag":$tag,"port":$port,"protocol":"dokodemo-door","settings":{"address":"127.0.0.1","port":$port,"network":$protocol}}]
    ' "$tempFile" > "$tempNext" || { rm -rf "$tempDir"; return 1; }
    mv -f "$tempNext" "$tempFile"
    mappingNum=$((mappingNum + 1))
  done < <(jq -r '.mapping[]? | [.port,.protocol] | @tsv' "$settings")
fi

jq empty "$tempFile" >/dev/null 2>&1 || { rm -rf "$tempDir"; return 1; }
/opt/de_GWD/vtrui/vtrui run -test -confdir "$tempDir" >/dev/null 2>&1 || {
  echo -e "${WHITE}RproxyS${RED} Generated config is invalid${cRES}"
  rm -rf "$tempDir"
  return 1
}
rproxyS_replaceFile "$tempFile" "$config" || { rm -rf "$tempDir"; return 1; }
rm -rf "$tempDir"
}



rproxyS_installService(){
cat << "EOF" >/etc/systemd/system/RproxyS.service
[Unit]
Description=Rproxy Service
After=network.target nss-lookup.target

[Service]
User=root
Type=simple
ExecStart=/opt/de_GWD/vtrui/vtrui run -config /opt/de_GWD/RproxyS/config.json
Restart=always
RestartSec=2
TimeoutStopSec=5

AmbientCapabilities=CAP_NET_RAW CAP_NET_ADMIN CAP_NET_BIND_SERVICE
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
EOF
systemctl daemon-reload >/dev/null
systemctl enable RproxyS >/dev/null 2>&1
}



rproxyS_apply(){
[[ -x /opt/de_GWD/vtrui/vtrui ]] || { echo -e "${WHITE}RproxyS${RED} Xray is not installed${cRES}"; return 1; }
local config="/opt/de_GWD/RproxyS/config.json"
local serviceFile="/etc/systemd/system/RproxyS.service"
local settings="/opt/de_GWD/RproxyS/settings.json"
local settingsBackup backupDir configExisted=0 serviceExisted=0 settingsPending=0 wasActive wasEnabled status=0
settingsBackup=$(rproxyS_pendingSettingsBackup)
backupDir=$(mktemp -d /tmp/de_GWD-RproxyS.XXXXXX) || return 1

if [[ -e $config || -L $config ]]; then
  [[ -f $config && ! -L $config ]] || { rm -rf "$backupDir"; return 1; }
  cp -a "$config" "$backupDir/config" || { rm -rf "$backupDir"; return 1; }
  configExisted=1
fi
if [[ -e $serviceFile || -L $serviceFile ]]; then
  [[ -f $serviceFile && ! -L $serviceFile ]] || { rm -rf "$backupDir"; return 1; }
  cp -a "$serviceFile" "$backupDir/service" || { rm -rf "$backupDir"; return 1; }
  serviceExisted=1
fi
if [[ -e $settingsBackup ]]; then
  [[ -f $settingsBackup && ! -L $settingsBackup ]] || { rm -rf "$backupDir"; return 1; }
  settingsPending=1
fi
wasActive=$(systemctl is-active RproxyS 2>/dev/null || true)
wasEnabled=$(systemctl is-enabled RproxyS 2>/dev/null || true)

rproxyS_writeConfig || status=1
if (( status == 0 )) && ! rproxyS_installService; then status=1; fi
if (( status == 0 )) && ! systemctl restart RproxyS >/dev/null 2>&1; then status=1; fi
if (( status == 0 )) && ! systemctl is-active --quiet RproxyS; then status=1; fi

if (( status != 0 )); then
  if (( configExisted )); then rm -f "$config"; cp -a "$backupDir/config" "$config"; else rm -f "$config"; fi
  if (( serviceExisted )); then rm -f "$serviceFile"; cp -a "$backupDir/service" "$serviceFile"; else rm -f "$serviceFile"; fi
  if (( settingsPending )); then rm -f "$settings"; cp -a "$settingsBackup" "$settings"; fi
  systemctl daemon-reload >/dev/null 2>&1 || true
  if [[ $wasEnabled = "enabled" ]]; then systemctl enable RproxyS >/dev/null 2>&1; else systemctl disable RproxyS >/dev/null 2>&1; fi
  if [[ $wasActive = "active" ]]; then systemctl restart RproxyS >/dev/null 2>&1; else systemctl stop RproxyS >/dev/null 2>&1; fi
  rm -rf "$backupDir"
  (( settingsPending )) && rm -f "$settingsBackup"
  echo -e "${WHITE}RproxyS${RED} Failed to start${cRES}"
  systemctl --no-pager --full status RproxyS
  return 1
fi
rm -rf "$backupDir"
(( settingsPending )) && rm -f "$settingsBackup"
echo -e "${WHITE}[ ${GREEN}✓ ${WHITE}]\c" && echo -e "\t${WHITE}RproxyS ${GREEN}Deployed${cRES}"
}



rproxyS_stop(){
if systemctl disable --now RproxyS >/dev/null 2>&1; then
  echo -e "${WHITE}[ ${GREEN}✓ ${WHITE}]\c" && echo -e "\t${WHITE}RproxyS ${RED}Stopped${cRES}"
else
  echo -e "${WHITE}RproxyS${RED} Failed to stop${cRES}"
  return 1
fi
}



