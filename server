echo -e "${GREEN}[0]: Back${cRES}"
echo -e "${GREEN}================================ ${cRES}"
read -s -n 1 rps
echo
case "$rps" in
  0|"") return ;;
  1) continue ;;
  2)
    rproxySsetTunnel || continue
    domain=$(extraGetDomain)
    [[ -z $domain ]] && domain="${RPROXY_HOST:-localhost}"
    echo -e "${WHITE}[ ${GREEN}✓ ${WHITE}]\c" && echo -e "\t${WHITE}RproxyS ${GREEN}Tunnel${cRES}"
    echo -e "${GREEN} Client RproxyC: ${YELLOW}${domain}:$(jq -r '.FORWARD.Rproxy.server.tunnel.port' "$(rproxySconf)")${cRES}"
    echo -e "${GREEN} UUID: ${YELLOW}$(jq -r '.FORWARD.Rproxy.server.tunnel.uuid' "$(rproxySconf)")${cRES}"
    ;;
  3)
    rproxySmapMenu || continue
    ;;
  4)
    rproxySuuidMenu || continue
    ;;
  5) rproxySstop ;;
  *) echo -e "${RED}Wrong number${cRES}" ;;
esac
done
}

extraXGenUUID(){
uuidgen 2>/dev/null || cat /proc/sys/kernel/random/uuid 2>/dev/null
}

extraJsonEnabled(){
local f=$1
[[ -s $f ]] || return 1
[[ $(jq -r '.enabled // false' "$f" 2>/dev/null) = "true" ]]
}

extraGetDomain(){
awk '/server_name/ {gsub(/;/, "", $2); print $2; exit}' "${DE_GWD_NGINX_CONF_DIR:-/etc/nginx/conf.d}/default.conf" 2>/dev/null
}

extraGetPort(){
local p
p=$(awk '/ssl .* reuseport/ {print $2}' "${DE_GWD_NGINX_CONF_DIR:-/etc/nginx/conf.d}/default.conf" 2>/dev/null | grep '^[[:digit:]]*$')
[[ -n $p ]] && { echo "$p"; return 0; }
echo "443"
}

extraMainPath(){
jq -r '.inbounds[0].streamSettings.wsSettings.path // empty' "$DE_GWD_XRAY_DIR/config.json" 2>/dev/null | grep -v '^null$'
}

extraNginxPathInUse(){
local p=$1
awk '/^[[:space:]]*location/{print $2}' "${DE_GWD_NGINX_CONF_DIR:-/etc/nginx/conf.d}"/*.conf 2>/dev/null | grep -qxF "$p"
}

parseDomainPort(){
local input=$1 host port
[[ -n $input ]] || return 1
if [[ $input == \[*\]:* ]]; then
  host=${input#\[}
  host=${host%%\]*}
  port=${input##*:}
else
  [[ $input == *:* ]] || return 1
  host=${input%:*}
  port=${input##*:}
  [[ $host == *:* ]] && return 1
fi
host=${host#\[}
host=${host%\]}
[[ -n $host && $port =~ ^[1-9][0-9]{0,4}$ ]] && (( port <= 65535 )) || return 1
printf '%s %s\n' "$host" "$port"
}

formatDomainPort(){
local host=$1 port=$2
host=${host#\[}
host=${host%\]}
if [[ $host == *:* ]]; then
  printf '[%s]:%s\n' "$host" "$port"
else
  printf '%s:%s\n' "$host" "$port"
fi
}

extraDokodemoNormalizeNetwork(){
local n=${1-}
n=$(printf '%s' "$n" | tr '[:upper:]' '[:lower:]' | tr -d '[:space:]')
[[ -z $n ]] && n=tcp,udp
case $n in
  1|tcp) printf 'tcp\n' ;;
  2|udp) printf 'udp\n' ;;
  3|tcp,udp|udp,tcp|tcp+udp|tcp/udp|tcpudp|both|all) printf 'tcp,udp\n' ;;
  *) return 1 ;;
esac
}

extraDokodemoJqTarget(){
jq -r '.rules[]? | "  "+(.port|tostring)+" -> "+(if (.target|contains(":")) then "["+.target+"]:" else .target+":" end)+(.targetPort|tostring)+" "+(.network // "tcp,udp")' "$1" 2>/dev/null
}

extraSettingsBegin(){
EXTRA_SETTINGS_PATH=$1
EXTRA_SETTINGS_DIR=$(mktemp -d /tmp/de_GWD-extra-settings.XXXXXX) || return 1
EXTRA_SETTINGS_HAD=0
if [[ -e $EXTRA_SETTINGS_PATH ]]; then
  cp -p -- "$EXTRA_SETTINGS_PATH" "$EXTRA_SETTINGS_DIR/settings" || { rm -rf -- "$EXTRA_SETTINGS_DIR"; return 1; }
  EXTRA_SETTINGS_HAD=1
fi
}

extraSettingsRollback(){
local status=0
if [[ $EXTRA_SETTINGS_HAD = 1 ]]; then
  cp -p -- "$EXTRA_SETTINGS_DIR/settings" "$EXTRA_SETTINGS_PATH" || status=1
else
  rm -f -- "$EXTRA_SETTINGS_PATH" || status=1
fi
rm -rf -- "$EXTRA_SETTINGS_DIR"
unset EXTRA_SETTINGS_PATH EXTRA_SETTINGS_DIR EXTRA_SETTINGS_HAD
return "$status"
}

extraSettingsCommit(){
rm -rf -- "$EXTRA_SETTINGS_DIR"
unset EXTRA_SETTINGS_PATH EXTRA_SETTINGS_DIR EXTRA_SETTINGS_HAD
}

extraXrayJqUpdate(){
local f=$1; shift
local t
t=$(mktemp "${f}.XXXXXX") || return 1
if jq "$@" "$f" >"$t" 2>/dev/null; then
  chmod --reference="$f" "$t" 2>/dev/null || true
  mv -f -- "$t" "$f"
else
  rm -f -- "$t"
  return 1
fi
}

extraXPortFree(){
local p=$1 allowmain=$2 mainport used u
[[ $p =~ ^[1-9][0-9]{0,4}$ ]] || { echo -e "${RED}Invalid port: $p${cRES}"; return 1; }
(( p <= 65535 )) || { echo -e "${RED}Invalid port: $p${cRES}"; return 1; }
if [[ $p = "80" ]]; then
  echo -e "${RED}Port 80 is used for HTTP redirect${cRES}"
  return 1
fi
if [[ $p = "9890" || $p = "9891" || $p = "3000" || $p = "8053" ]]; then
  echo -e "${RED}Port $p is reserved${cRES}"
  return 1
fi
mainport=$(extraGetPort)
if [[ $p = "$mainport" ]] && [[ $allowmain != "allowmain" ]]; then
  echo -e "${RED}Port $p is the main Xray/Nginx port${cRES}"
  return 1
fi
if [[ $p = "443" || $p = "55443" ]] && [[ $allowmain != "allowmain" ]]; then
  echo -e "${RED}Port $p is nginx${cRES}"
  return 1
fi
# all nginx listen blocks (allowmain skips the main port itself)
while IFS= read -r used; do
  [[ -n $used && $p = "$used" ]] || continue
  [[ $allowmain = "allowmain" && $p = "$mainport" ]] && continue
  echo -e "${RED}Port $p conflicts with nginx${cRES}"
  return 1
done < <(awk '$1=="listen"{for(i=2;i<=NF;i++){v=$i; gsub(/;/,"",v); sub(/^.*:/,"",v); if(v~/^[0-9]+$/){print v; break}}}' "${DE_GWD_NGINX_CONF_DIR:-/etc/nginx/conf.d}"/*.conf 2>/dev/null)
# enabled extra-*.json ports
for extraf in extra-reality.json extra-vlessws.json extra-socks5.json; do
  [[ -f $DE_GWD_DATA_DIR/$extraf ]] || continue
  extraJsonEnabled "$DE_GWD_DATA_DIR/$extraf" || continue
  used=$(jq -r '.port // empty' "$DE_GWD_DATA_DIR/$extraf" 2>/dev/null)
  [[ -n $used && $p = "$used" ]] && { echo -e "${RED}Port $p is used by $extraf${cRES}"; return 1; }
done
if extraJsonEnabled "$DE_GWD_DATA_DIR/extra-dokodemo.json" 2>/dev/null; then
  while IFS= read -r u; do
    [[ -n $u && $p = "$u" ]] && { echo -e "${RED}Port $p is used by dokodemo rules${cRES}"; return 1; }
  done < <(jq -r '.rules[]?.port // empty' "$DE_GWD_DATA_DIR/extra-dokodemo.json" 2>/dev/null)
fi
# Rproxy 0conf tunnel + mapping ports
if [[ -f $DE_GWD_DATA_DIR/0conf ]]; then
  used=$(jq -r '.FORWARD.Rproxy.server.tunnel.port // empty' "$DE_GWD_DATA_DIR/0conf" 2>/dev/null)
  [[ -n $used && $p = "$used" ]] && { echo -e "${RED}Port $p is the Rproxy tunnel port${cRES}"; return 1; }
  while IFS= read -r u; do
    [[ -n $u && $p = "$u" ]] && { echo -e "${RED}Port $p is used by an Rproxy mapping${cRES}"; return 1; }
  done < <(jq -r '.FORWARD.Rproxy.server.mapping[]?.port // empty' "$DE_GWD_DATA_DIR/0conf" 2>/dev/null)
fi
# live vtrui config ports
if [[ -f $DE_GWD_XRAY_DIR/config.json ]]; then
  if [[ $(jq -r --argjson p "$p" '[.inbounds[] | select(.port == $p)] | length' "$DE_GWD_XRAY_DIR/config.json" 2>/dev/null) != "0" ]]; then
    echo -e "${RED}Port $p already in use by Xray${cRES}"
    return 1
  fi
fi
return 0
}

extraRealityInbound(){
# $1 = extra-reality.json
jq -c '
{
  tag: "extra-vless-reality",
  listen: "0.0.0.0",
  port: .port,
  protocol: "vless",
  settings: {
    clients: [ {id: .uuid} + (if (.flow // "") == "" then {} else {flow: .flow} end) ],
    decryption: "none"
  },
  streamSettings: {
    network: "tcp",
    security: "reality",
    realitySettings: {
      show: false,
      dest: .dest,
      xver: 0,
      serverNames: [.serverName],
      privateKey: .privateKey,
      shortIds: [.shortId],
      settings: { publicKey: .publicKey, fingerprint: "chrome", serverName: "", spiderX: "/" }
    }
  },
  sniffing: { enabled: true, destOverride: ["http", "tls"] }
}' "$1" 2>/dev/null
}

extraVlessWsInbound(){
# $1 = extra-vlessws.json, $2 = loop port (9891 + nth)
jq -c --argjson loopPort "$2" '
{
  tag: "extra-vless-ws",
  listen: "127.0.0.1",
  port: $loopPort,
  protocol: "vless",
  settings: { clients: [{id: .uuid}], decryption: "none" },
  streamSettings: { network: "ws", security: "none", wsSettings: { path: .path } },
  sniffing: { enabled: true, destOverride: ["http", "tls"] }
}' "$1" 2>/dev/null
}

extraSocksInbound(){
# $1 = extra-socks5.json
jq -c '
{
  tag: "extra-socks5",
  listen: "0.0.0.0",
  port: .port,
  protocol: "socks",
  settings: { auth: "password", udp: true, accounts: [{user: .user, pass: .password}] }
}' "$1" 2>/dev/null
}

extraDokodemoInbound(){
# $1 = extra-dokodemo.json
# xray >= 25 实测:settings 用数组 addresses 时 inbound 存活但不转发,
# 单数 address/port 才真实转发,因此每条 rule 生成独立 inbound。
jq -c '.rules | to_entries[] | {
  tag: ("extra-dokodemo-" + (.key|tostring)),
  listen: "0.0.0.0",
  port: .value.port,
  protocol: "dokodemo-door",
  settings: {
    followRedirect: false,
    network: (.value.network // "tcp,udp"),
    address: (.value.target | sub("^\\["; "") | sub("\\]$"; "")),
    port: .value.targetPort
  }
}' "$1" 2>/dev/null
}

extraInboundsAppend(){
# Rebuild config.json: drop previous extra-* inbounds, re-add from enabled extra-*.json.
local conf=$DE_GWD_XRAY_DIR/config.json
[[ -f $conf ]] || return 0
local candidate inbound vlessN
candidate=$(mktemp "${conf}.XXXXXX") || return 1
trap 'rm -f -- "$candidate"' RETURN
cp -p -- "$conf" "$candidate" || return 1
extraXrayJqUpdate "$candidate" '.inbounds |= map(select((.tag // "") | startswith("extra-") | not))' || return 1
vlessN=0
if extraJsonEnabled "$DE_GWD_DATA_DIR/extra-vlessws.json"; then
  inbound=$(extraVlessWsInbound "$DE_GWD_DATA_DIR/extra-vlessws.json" $((9891+vlessN)))
  vlessN=$((vlessN+1))
  [[ -n $inbound ]] && extraXrayJqUpdate "$candidate" --argjson ib "$inbound" '.inbounds += [$ib]' || return 1
fi
if extraJsonEnabled "$DE_GWD_DATA_DIR/extra-reality.json"; then
  inbound=$(extraRealityInbound "$DE_GWD_DATA_DIR/extra-reality.json")
  [[ -n $inbound ]] && extraXrayJqUpdate "$candidate" --argjson ib "$inbound" '.inbounds += [$ib]' || return 1
fi
if extraJsonEnabled "$DE_GWD_DATA_DIR/extra-socks5.json"; then
  inbound=$(extraSocksInbound "$DE_GWD_DATA_DIR/extra-socks5.json")
  [[ -n $inbound ]] && extraXrayJqUpdate "$candidate" --argjson ib "$inbound" '.inbounds += [$ib]' || return 1
fi
if extraJsonEnabled "$DE_GWD_DATA_DIR/extra-dokodemo.json"; then
  while IFS= read -r inbound; do
    [[ -z $inbound ]] && continue
    extraXrayJqUpdate "$candidate" --argjson ib "$inbound" '.inbounds += [$ib]' || return 1
  done < <(extraDokodemoInbound "$DE_GWD_DATA_DIR/extra-dokodemo.json")
fi
mv -f -- "$candidate" "$conf" || return 1
trap - RETURN
return 0
}

extraXrayApply(){
local conf=$DE_GWD_XRAY_DIR/config.json bak
bak=/tmp/vtrui-config.json.bak
[[ -f $conf ]] || return 1
if [[ ${DE_GWD_TEST_MODE:-0} = 1 ]]; then
  extraInboundsAppend || return 1
  echo -e "${WHITE}[ ${GREEN}✓ ${WHITE}]\c" && echo -e "\t${WHITE}Extra Xray inbounds ${GREEN}Applied${cRES}"
  return 0
fi
cp -p -- "$conf" "$bak" || return 1
if ! extraInboundsAppend; then
  mv -f -- "$bak" "$conf"
  echo -e "${WHITE}[ ${RED}✕ ${WHITE}]\c" && echo -e "\t${RED}Xray config rebuild failed, changes reverted${cRES}"
  return 1
fi
if ! "$DE_GWD_XRAY_BIN" run -test -c "$conf" >/dev/null 2>&1; then
  mv -f -- "$bak" "$conf"
  echo -e "${WHITE}[ ${RED}✕ ${WHITE}]\c" && echo -e "\t${RED}Invalid Xray config, changes reverted${cRES}"
  return 1
fi
if ! systemctl restart vtrui >/dev/null 2>&1; then
  mv -f -- "$bak" "$conf"
  echo -e "${WHITE}[ ${RED}✕ ${WHITE}]\c" && echo -e "\t${RED}Xray service restart failed, changes reverted${cRES}"
  return 1
fi
rm -f -- "$bak"
echo -e "${WHITE}[ ${GREEN}✓ ${WHITE}]\c" && echo -e "\t${WHITE}Extra Xray inbounds ${GREEN}Applied${cRES}"
return 0
}

extraNginxApply(){
local nginxDir mainport bakdir vport vpath loc
nginxDir=${DE_GWD_NGINX_CONF_DIR:-/etc/nginx/conf.d}
mainport=$(extraGetPort)
[[ -d $nginxDir ]] || return 0

loc=""
if [[ $(jq -r '.enabled // false' "$DE_GWD_DATA_DIR/extra-vlessws.json" 2>/dev/null) = "true" ]]; then
  vport=$(jq -r '.port' "$DE_GWD_DATA_DIR/extra-vlessws.json")
  vpath=$(jq -r '.path' "$DE_GWD_DATA_DIR/extra-vlessws.json")
  [[ -n $vport && -n $vpath ]] || { echo -e "${RED}Invalid VLESS WS settings${cRES}"; return 1; }
  loc="  location $vpath {
    if (\$http_upgrade != \"websocket\") { return 404; }
    proxy_pass                  http://127.0.0.1:9891;
    proxy_http_version          1.1;
    proxy_set_header            Host \$host;
    proxy_set_header            Upgrade \"websocket\";
    proxy_set_header            Connection \"upgrade\";
    proxy_set_header            X-Real-IP \$remote_addr;
    proxy_set_header            X-Forwarded-For \$proxy_add_x_forwarded_for;
    proxy_connect_timeout       600;
    proxy_read_timeout          600;
    proxy_send_timeout          600;
    chunked_transfer_encoding   off;
    proxy_redirect              off;
    proxy_store                 off;
    proxy_cache                 off;
    proxy_buffering             off;
    proxy_buffer_size           4k;
    proxy_busy_buffers_size     16k;
    proxy_buffers               4 16k;
    add_header Cache-Control no-cache;
  }"
fi

if [[ ${DE_GWD_TEST_MODE:-0} = 1 ]]; then
  # write-only path (no nginx -t / reload), for CI & function-level tests
  rm -f "$nginxDir"/extra-vless-ws.conf
  sed -i '' '/EXTRA_START/,/EXTRA_END/d' "$nginxDir/default.conf" 2>/dev/null
  if [[ -n $loc ]]; then
    if [[ $vport = "$mainport" ]]; then
      if [[ -f $nginxDir/default.conf ]] && [[ $(tail -1 "$nginxDir/default.conf") = "}" ]]; then
        sed -i '' '$ d' "$nginxDir/default.conf"
        {
          echo "# EXTRA_START"
          printf '%s\n' "$loc"
          echo "# EXTRA_END"
          echo "}"
        } >> "$nginxDir/default.conf"
      fi
    else
      {
        echo "server {"
        echo "  listen $vport ssl;"
        echo "  http2 on;"
        echo "  server_name _;"
        echo "  include $nginxDir/.ssl_certs;"
        echo
        printf '%s\n' "$loc"
        echo "}"
      } > "$nginxDir/extra-vless-ws.conf"
    fi
  fi
  return 0
fi

bakdir=$(mktemp -d /tmp/extra-nginx.XXXXXX) || return 1
for f in "$nginxDir"/extra-*.conf; do
  [[ -f $f ]] && mv -- "$f" "$bakdir/"
done
cp -p -- "$nginxDir/default.conf" "$bakdir/default.conf" 2>/dev/null
sed -i '' '/EXTRA_START/,/EXTRA_END/d' "$nginxDir/default.conf" 2>/dev/null

if [[ -n $loc ]]; then
  if [[ $vport = "$mainport" ]]; then
    if [[ -f $nginxDir/default.conf ]] && [[ $(tail -1 "$nginxDir/default.conf") = "}" ]]; then
      sed -i '' '$ d' "$nginxDir/default.conf"
      {
        echo "# EXTRA_START"
        printf '%s\n' "$loc"
        echo "# EXTRA_END"
        echo "}"
      } >> "$nginxDir/default.conf"
    fi
  else
    {
      echo "server {"
      echo "  listen $vport ssl;"
      echo "  http2 on;"
      echo "  server_name _;"
      echo "  include $nginxDir/.ssl_certs;"
      echo
      printf '%s\n' "$loc"
      echo "}"
    } > "$nginxDir/extra-vless-ws.conf"
  fi
fi

if /usr/sbin/nginx -t >/dev/null 2>&1; then
  systemctl force-reload nginx >/dev/null 2>&1
  rm -rf -- "$bakdir"
  echo -e "${WHITE}[ ${GREEN}✓ ${WHITE}]\c" && echo -e "\t${WHITE}Nginx Extra ${GREEN}Applied${cRES}"
  return 0
else
  rm -f "$nginxDir"/extra-*.conf
  cp -f -- "$bakdir/default.conf" "$nginxDir/default.conf" 2>/dev/null
  cp -f -- "$bakdir"/extra-*.conf "$nginxDir/" 2>/dev/null
  rm -rf -- "$bakdir"
  echo -e "${WHITE}[ ${RED}✕ ${WHITE}]\c" && echo -e "\t${RED}Invalid Nginx config, changes reverted${cRES}"
  return 1
fi
}

changeVLESSReality(){
local settings="$DE_GWD_DATA_DIR/extra-reality.json" sw domain extraPort dest destIn sni sniIn yn flow keyPair priv pub shortId uuid
echo -e "${GREEN}================================ ${cRES}"
echo -e "${GREEN} VLESS + REALITY${cRES}"
echo -e "${GREEN}[1]: Enable${cRES}"
echo -e "${GREEN}[2]: Disable${cRES}"
echo -e "${GREEN}[0]: Back${cRES}"
echo -e "${GREEN}================================ ${cRES}"
read -s -n 1 sw
echo
[[ $sw = "0" || -z $sw ]] && return
extraSettingsBegin "$settings" || return 1
if [[ $sw = "2" ]]; then
  printf '%s\n' '{"enabled":false}' >"$settings" || { extraSettingsRollback; return 1; }
  if ! extraXrayApply || ! extraNginxApply; then
    extraSettingsRollback
    return 1
  fi
  extraSettingsCommit
  echo -e "${WHITE}[ ${GREEN}✓ ${WHITE}]\c" && echo -e "\t${WHITE}VLESS REALITY ${RED}Disabled${cRES}"
  return 0
fi
if [[ $sw != "1" ]]; then
  extraSettingsRollback
  return 0
fi
domain=$(extraGetDomain)
[[ -n $domain ]] || { extraSettingsRollback; echo -e "${RED}Server domain unavailable${cRES}"; return 1; }
echo -e "${GREEN} Listen port${cRES}"
read extraPort
[[ $extraPort =~ ^[1-9][0-9]{0,4}$ ]] && (( extraPort <= 65535 )) || { extraSettingsRollback; echo -e "${RED}Invalid port${cRES}"; return 1; }
extraXPortFree "$extraPort" || { extraSettingsRollback; return 1; }
uuid=$(extraXGenUUID)
[[ -n $uuid ]] || { extraSettingsRollback; echo -e "${RED}UUID generation failed${cRES}"; return 1; }
dest="127.0.0.1:$(extraGetPort)"
echo -e "${GREEN} REALITY dest  (empty = $dest)${cRES}"
read destIn
dest=${destIn:-$dest}
if [[ $dest == *:* ]]; then
  parseDomainPort "$dest" >/dev/null || { extraSettingsRollback; echo -e "${RED}Invalid dest${cRES}"; return 1; }
else
  [[ -n $dest && $dest != *" "* ]] || { extraSettingsRollback; echo -e "${RED}Invalid dest${cRES}"; return 1; }
fi
sni=$domain
echo -e "${GREEN} serverName/SNI  (empty = $sni)${cRES}"
read sniIn
sni=${sniIn:-$sni}
[[ -n $sni ]] || { extraSettingsRollback; echo -e "${RED}Invalid SNI${cRES}"; return 1; }
echo -e "${GREEN} Vision? [y/n]  (empty = y)${cRES}"
read yn
yn=${yn:-y}
if [[ $yn = [Yy] ]]; then flow="xtls-rprx-vision"
elif [[ $yn = [Nn] ]]; then flow=""
else extraSettingsRollback; echo -e "${RED}Invalid Vision${cRES}"; return 1; fi
if [[ ${DE_GWD_TEST_MODE:-0} = 1 ]]; then
  priv=test-private; pub=test-public
else
  keyPair=$("$DE_GWD_XRAY_BIN" x25519 2>/dev/null)
  priv=$(printf '%s\n' "$keyPair" | awk -F': *' 'BEGIN{IGNORECASE=1} $1 ~ /^Private(key| key)$/{print $2; exit}')
  pub=$(printf '%s\n' "$keyPair" | awk -F': *' 'BEGIN{IGNORECASE=1} $1 ~ /^Password( \(PublicKey\))?$|^Public(key| key)$/{print $2; exit}')
fi
[[ -n $priv && -n $pub ]] || { extraSettingsRollback; echo -e "${RED}x25519 key generation failed${cRES}"; return 1; }
shortId=$(openssl rand -hex 4 2>/dev/null)
[[ -z $shortId ]] && shortId=$(head -c4 /dev/urandom | od -An -tx1 | tr -d ' \n')
jq -n --arg domain "$domain" --argjson port "$extraPort" --arg uuid "$uuid" --arg flow "$flow" --arg dest "$dest" --arg serverName "$sni" --arg privateKey "$priv" --arg publicKey "$pub" --arg shortId "$shortId" \
  '{enabled:true,domain:$domain,port:$port,uuid:$uuid,flow:$flow,dest:$dest,serverName:$serverName,privateKey:$privateKey,publicKey:$publicKey,shortId:$shortId}' >"$settings" || { extraSettingsRollback; return 1; }
if ! extraXrayApply || ! extraNginxApply; then
  extraSettingsRollback
  return 1
fi
extraSettingsCommit
echo -e "${BLUE}Address:    ${YELLOW}$domain:$extraPort${cRES}"
echo -e "${BLUE}UUID:       ${YELLOW}$uuid${cRES}"
echo -e "${BLUE}Flow:       ${YELLOW}${flow:-none}${cRES}"
echo -e "${BLUE}SNI:        ${YELLOW}$sni${cRES}"
echo -e "${BLUE}PublicKey:  ${YELLOW}$pub${cRES}"
echo -e "${BLUE}ShortId:    ${YELLOW}$shortId${cRES}"
echo -e "${WHITE}[ ${GREEN}✓ ${WHITE}]\c" && echo -e "\t${WHITE}VLESS REALITY ${GREEN}Enabled${cRES}"
return 0
}

