  echo -e "${YELLOW}$index. ${WHITE}$peerName${cRES}  ${peerAddress}  ${peerPublic}"
  echo -e "   ${BLUE}$peerFile${cRES}"
  index=$((index + 1))
done < <(jq -r '.peers[]? | [.name,.address,.publicKey,.config] | @tsv' "$wireguardNodeState")
(( index == 1 )) && echo -e "${YELLOW}Peer list is empty${cRES}"
echo -e "${BLUE}------------------------------------------------ ${cRES}"
}


wireguard_node_showPeer(){
wireguard_node_stateValid || return 1
local count number index peerName peerFile
count=$(jq -r '.peers | length' "$wireguardNodeState")
(( count > 0 )) || { echo -e "${WHITE}WireGuard node${YELLOW} Peer list is empty${cRES}"; return 0; }
wireguard_node_listPeers
read -r -p "Peer number: " number
[[ $number =~ ^[0-9]+$ ]] || return 1
index=$((10#$number - 1))
(( index >= 0 && index < count )) || return 1
peerFile=$(jq -r ".peers[$index].config" "$wireguardNodeState")
[[ -s $peerFile ]] || { echo -e "${WHITE}WireGuard node${RED} Peer config is missing${cRES}"; return 1; }
