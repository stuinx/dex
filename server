changeVLESSReality(){
local settings="$DE_GWD_DATA_DIR/extra-reality.json" sw domain extraPort uuid dest sni flow yn keyPair priv pub shortId
echo -e "${GREEN}================================ ${cRES}"
echo -e "${GREEN} VLESS + REALITY${cRES}"
echo -e "${GREEN}[1]: Enable${cRES}"
echo -e "${GREEN}[2]: Disable${cRES}"
echo -e "${GREEN}[0]: Back${cRES}"
echo -e "${GREEN}================================ ${cRES}"
read -s -n 1 sw
echo
[[ $sw = "0" || -z $sw ]] && return
if [[ $sw = "2" ]]; then
  jq '{enabled:false}' >"$settings" 2>/dev/null || printf '%s\n' '{"enabled":false}' >"$settings"
  extraXrayApply || return 1
  echo -e "${WHITE}[ ${GREEN}✓ ${WHITE}]\c" && echo -e "\t${WHITE}VLESS REALITY ${RED}Disabled${cRES}"
  return
fi
[[ $sw = "1" ]] || return
domain=$(extraGetDomain)
[[ -n $domain ]] || { echo -e "${RED}Server domain unavailable${cRES}"; return 1; }
echo -e "${GREEN} Listen port${cRES}"
read extraPort
[[ $extraPort =~ ^[1-9][0-9]{0,4}$ ]] && (( extraPort <= 65535 )) || { echo -e "${RED}Invalid port${cRES}"; return 1; }
tcppf_port_available "$extraPort" || { echo -e "${RED}Port $extraPort conflicts${cRES}"; return 1; }
uuid=$(cat /proc/sys/kernel/random/uuid)
echo -e "${GREEN} REALITY dest${cRES}"
read dest
[[ -n $dest ]] || { echo -e "${RED}Invalid dest${cRES}"; return 1; }
echo -e "${GREEN} serverName/SNI${cRES}"
read sni
[[ -n $sni ]] || { echo -e "${RED}Invalid SNI${cRES}"; return 1; }
echo -e "${GREEN} Vision? [y/n]${cRES}"
read yn
if [[ $yn = [Yy] ]]; then flow="xtls-rprx-vision"
elif [[ $yn = [Nn] ]]; then flow=""
else echo -e "${RED}Invalid Vision${cRES}"; return 1; fi
if [[ ${DE_GWD_TEST_MODE:-0} = 1 ]]; then
  priv=test-private; pub=test-public
else
  keyPair=$("$DE_GWD_XRAY_BIN" x25519 2>/dev/null)
  # Xray <=25: "Private key:" / "Public key:" or "Password:"
  # Xray 26.3+: "PrivateKey:" / "Password (PublicKey):"
  priv=$(printf '%s\n' "$keyPair" | awk -F': ' 'BEGIN{IGNORECASE=1} $1 ~ /^Private( key|Key)?$/{gsub(/^[ \t]+|[ \t]+$/,"",$2); print $2; exit}')
  pub=$(printf '%s\n' "$keyPair" | awk -F': ' 'BEGIN{IGNORECASE=1} $1 ~ /Public[[:space:]]*key|Password/{gsub(/^[ \t]+|[ \t]+$/,"",$2); print $2; exit}')
fi
[[ -n $priv && -n $pub ]] || { echo -e "${RED}x25519 key generation failed${cRES}"; return 1; }
shortId=$(od -An -N8 -tx1 /dev/urandom 2>/dev/null | tr -d ' \n')
jq -n --argjson port "$extraPort" --arg uuid "$uuid" --arg flow "$flow" --arg dest "$dest" --arg serverName "$sni" --arg privateKey "$priv" --arg publicKey "$pub" --arg shortId "$shortId" --arg domain "$domain" \
  '{enabled:true,domain:$domain,port:$port,uuid:$uuid,flow:$flow,dest:$dest,serverName:$serverName,privateKey:$privateKey,publicKey:$publicKey,shortId:$shortId}' >"$settings"
extraXrayApply || return 1
echo -e "${BLUE}Address:    ${YELLOW}$domain:$extraPort${cRES}"
echo -e "${BLUE}UUID:       ${YELLOW}$uuid${cRES}"
echo -e "${BLUE}Flow:       ${YELLOW}${flow:-none}${cRES}"
echo -e "${BLUE}SNI:        ${YELLOW}$sni${cRES}"
echo -e "${BLUE}PublicKey:  ${YELLOW}$pub${cRES}"
echo -e "${BLUE}ShortId:    ${YELLOW}$shortId${cRES}"
echo -e "${WHITE}[ ${GREEN}✓ ${WHITE}]\c" && echo -e "\t${WHITE}VLESS REALITY ${GREEN}Enabled${cRES}"
}

