vlessPath=$(jq -r '.vless_ws.path // empty' "$extraSettings")
extra_validHost "$vlessDomain" && extra_validPort "$vlessPort" || return 1
[[ $vlessPath == /* && $vlessPath != *[[:space:]]* ]] || return 1

cat << EOF >"$extraVlessWSConf"
server {
  listen $vlessPort ssl fastopen=500 reuseport;
  server_name $vlessDomain;

  include /etc/nginx/conf.d/.HSTS;
  include /etc/nginx/conf.d/.ssl_certs;

  location $vlessPath {
    if (\$http_upgrade != "websocket") { return 404; }
    proxy_pass http://127.0.0.1:9891;
    proxy_http_version 1.1;
    proxy_set_header Host \$host;
    proxy_set_header Upgrade "websocket";
    proxy_set_header Connection "upgrade";
    proxy_set_header X-Real-IP \$remote_addr;
    proxy_set_header X-Real-PORT \$remote_port;
    proxy_set_header X-Forwarded-For \$proxy_add_x_forwarded_for;
    proxy_connect_timeout 600;
    proxy_read_timeout 600;
    proxy_send_timeout 600;
    proxy_redirect off;
    proxy_buffering off;
  }
}
EOF
