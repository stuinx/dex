extraDokodemoInbound(){
# xray >= 25 实测:settings 用数组 addresses 时 inbound 存活但不转发,
# 单数 address/port 才真实转发(本分支生成每个 inbound 恰一条 mapping)。
# 多条 mapping 时以第一条为准(同一门端口无法拆分,菜单流程也只建单条)。
echo "$1" | jq '
{
  tag: ("extra-" + .tag),
  listen: "0.0.0.0",
  port: .port,
  protocol: "dokodemo-door",
  settings: {
    followRedirect: false,
    network: ([.mapping[].protocol] | unique | join(",")),
    address: .mapping[0].address,
    port: .mapping[0].port
  }
}
'
}



extraXrayApply(){
extra=$(jq -c '[.extra.inbounds[] | select(.status == "on")]' /opt/de_GWD/0conf 2>/dev/null)
[[ -z $extra ]] && extra="[]"
extras=$(echo "$extra" | jq 'length')
ib=()
vlessN=0
for ((i=0; i<$extras; i++)); do
obj=$(echo "$extra" | jq -c ".[$i]")
type=$(echo "$obj" | jq -r '.type')
case "$type" in
reality)
frag=$(extraRealityInbound "$obj") ;;
vless-ws)
frag=$(extraVlessWsInbound "$obj" $((9891+vlessN)))
vlessN=$((vlessN+1)) ;;
socks)
frag=$(extraSocksInbound "$obj") ;;
dokodemo)
frag=$(extraDokodemoInbound "$obj") ;;
esac
[[ -n $frag ]] && ib+=("$frag")
done

added=$(printf '%s\n' "${ib[@]}" | jq -s '.' 2>/dev/null)
[[ -z $added ]] && added="[]"

cp /opt/de_GWD/vtrui/config.json /tmp/vtrui-config.json.bak
jq --argjson added "$added" 'del(.inbounds[] | select((.tag // "") | startswith("extra-"))) | .inbounds += $added' /tmp/vtrui-config.json.bak | sponge /opt/de_GWD/vtrui/config.json

if /opt/de_GWD/vtrui/vtrui run -test -c /opt/de_GWD/vtrui/config.json >/dev/null 2>&1; then
systemctl restart vtrui >/dev/null 2>&1
rm -f /tmp/vtrui-config.json.bak
echo -e "${WHITE}[ ${GREEN}✓ ${WHITE}]\c" && echo -e "\t${WHITE}Extra Xray inbounds ${GREEN}Applied${cRES}"
else
mv -f /tmp/vtrui-config.json.bak /opt/de_GWD/vtrui/config.json
echo -e "${WHITE}[ ${RED}✕ ${WHITE}]\c" && echo -e "\t${RED}Invalid Xray config, changes reverted${cRES}"
fi
}



