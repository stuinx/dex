vPort=$(jq -r '.port // empty' "$DE_GWD_DATA_DIR/extra-vlessws.json")
[[ -z $vDomain ]] && vDomain=$(extraGetDomain)
[[ -z $vPort ]] && vPort=$(extraGetPort)
[[ -n $vlessPath && -n $vDomain && -n $vPort ]] || return 0
extraVlessWsNginxUpstream
cat << EOF
server {
  listen $vPort quic reuseport;
  listen $vPort ssl fastopen=500 reuseport;
  http2 on;
  server_name $vDomain;
  error_page 497 https://\$host:$vPort\$request_uri;
  include $nginxDir/.HSTS;
  include $nginxDir/.ssl_certs;
$(extraVlessWsNginxLocation "$vlessPath")
}
EOF
}

extraVlessWsWriteNginx(){
