extraInboundsAppend(){
local conf=$DE_GWD_XRAY_DIR/config.json
local inbound n i listenPort target targetPort network
[[ -f $conf ]] || return 0
# Drop previous extra-* only. Never rewrite or reorder inbounds[0] (main VMess).
jq '.inbounds |= map(select((.tag // "") | startswith("extra-") | not))' "$conf" | sponge "$conf"
if extraJsonEnabled "$DE_GWD_DATA_DIR/extra-vlessws.json"; then
  inbound=$(jq -nc --arg path "$(jq -r '.path' "$DE_GWD_DATA_DIR/extra-vlessws.json")" --arg uuid "$(jq -r '.uuid' "$DE_GWD_DATA_DIR/extra-vlessws.json")" \
    '{tag:"extra-vless-ws",listen:"127.0.0.1",port:9891,protocol:"vless",settings:{clients:[{id:$uuid}],decryption:"none"},streamSettings:{network:"ws",security:"none",wsSettings:{path:$path},sockopt:{tcpFastOpen:true,tcpMptcp:true}},sniffing:{enabled:true,destOverride:["http","tls","quic"]}}')
  jq --argjson ib "$inbound" '.inbounds += [$ib]' "$conf" | sponge "$conf"
fi
if extraJsonEnabled "$DE_GWD_DATA_DIR/extra-reality.json"; then
  inbound=$(jq -nc \
    --argjson port "$(jq -r '.port' "$DE_GWD_DATA_DIR/extra-reality.json")" \
    --arg uuid "$(jq -r '.uuid' "$DE_GWD_DATA_DIR/extra-reality.json")" \
    --arg flow "$(jq -r '.flow // empty' "$DE_GWD_DATA_DIR/extra-reality.json")" \
    --arg dest "$(jq -r '.dest' "$DE_GWD_DATA_DIR/extra-reality.json")" \
    --arg serverName "$(jq -r '.serverName' "$DE_GWD_DATA_DIR/extra-reality.json")" \
    --arg privateKey "$(jq -r '.privateKey' "$DE_GWD_DATA_DIR/extra-reality.json")" \
    --arg shortId "$(jq -r '.shortId' "$DE_GWD_DATA_DIR/extra-reality.json")" \
    '{tag:"extra-vless-reality",listen:"0.0.0.0",port:$port,protocol:"vless",settings:{clients:[{id:$uuid,flow:$flow}],decryption:"none"},streamSettings:{network:"tcp",security:"reality",realitySettings:{show:false,dest:$dest,xver:0,serverNames:[$serverName],privateKey:$privateKey,shortIds:[$shortId]},sockopt:{tcpFastOpen:true,tcpMptcp:true}}}')
  jq --argjson ib "$inbound" '.inbounds += [$ib]' "$conf" | sponge "$conf"
fi
if extraJsonEnabled "$DE_GWD_DATA_DIR/extra-socks5.json"; then
  inbound=$(jq -nc \
    --argjson port "$(jq -r '.port' "$DE_GWD_DATA_DIR/extra-socks5.json")" \
    --arg user "$(jq -r '.user' "$DE_GWD_DATA_DIR/extra-socks5.json")" \
    --arg password "$(jq -r '.password' "$DE_GWD_DATA_DIR/extra-socks5.json")" \
    '{tag:"extra-socks5",listen:"0.0.0.0",port:$port,protocol:"socks",settings:{auth:"password",udp:true,accounts:[{user:$user,pass:$password}]}}')
  jq --argjson ib "$inbound" '.inbounds += [$ib]' "$conf" | sponge "$conf"
fi
if extraJsonEnabled "$DE_GWD_DATA_DIR/extra-dokodemo.json"; then
  n=$(jq '.rules | length' "$DE_GWD_DATA_DIR/extra-dokodemo.json")
  for (( i=0; i<n; i++ )); do
    listenPort=$(jq -r --argjson i "$i" '.rules[$i].port' "$DE_GWD_DATA_DIR/extra-dokodemo.json")
    target=$(jq -r --argjson i "$i" '.rules[$i].target' "$DE_GWD_DATA_DIR/extra-dokodemo.json")
    targetPort=$(jq -r --argjson i "$i" '.rules[$i].targetPort' "$DE_GWD_DATA_DIR/extra-dokodemo.json")
    network=$(jq -r --argjson i "$i" '.rules[$i].network' "$DE_GWD_DATA_DIR/extra-dokodemo.json")
    inbound=$(jq -nc --argjson port "$listenPort" --arg target "$target" --argjson targetPort "$targetPort" --arg network "$network" --arg tag "extra-dokodemo-$i" \
      '{tag:$tag,listen:"0.0.0.0",port:$port,protocol:"dokodemo-door",settings:{address:$target,port:$targetPort,network:$network}}')
    jq --argjson ib "$inbound" '.inbounds += [$ib]' "$conf" | sponge "$conf"
  done
fi
}

