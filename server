local d=$1 parent n
[[ -n $d ]] || return 1
n=$(awk -F. '{print NF}' <<<"$d")
(( n >= 2 )) || return 1
if (( n >= 3 )); then
  parent=${d#*.}
  printf '%s %s\n' "*.$parent" "*.$d"
else
  printf '%s %s\n' "$d" "*.$d"
fi
}

