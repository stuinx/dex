# Menu 44: multi-rule HAProxy TCP forwarding (localPort -> host:port).
# Separate from Rproxy mappings. Frontend name is p<port> so one upstream
# domain can have more than one local port.
: "${DE_GWD_DATA_DIR:=/opt/de_GWD}"
: "${DE_GWD_TCPPF_SETTINGS:=$DE_GWD_DATA_DIR/tcppf.json}"
: "${DE_GWD_HAPROXY_CONFIG:=/etc/haproxy/haproxy.cfg}"
: "${DE_GWD_HAPROXY_SERVICE:=/etc/systemd/system/haproxy.service}"
: "${DE_GWD_HAPROXY_BIN:=/usr/sbin/haproxy}"
: "${DE_GWD_NGINX_CONF_DIR:=/etc/nginx/conf.d}"

parseDomainPort(){
local input=$1 host port
[[ -n $input ]] || return 1
if [[ $input == \[*\]:* ]]; then
  host=${input#\[}
  host=${host%%\]*}
  port=${input##*:}
else
  [[ $input == *:* ]] || return 1
  host=${input%:*}
  port=${input##*:}
  [[ $host == *:* ]] && return 1
fi
[[ -n $host && $port =~ ^[0-9]+$ ]] || return 1
printf '%s %s\n' "$host" "$port"
}

formatDomainPort(){
local host=$1 port=$2
if [[ $host == *:* ]]; then
  printf '[%s]:%s\n' "$host" "$port"
else
  printf '%s:%s\n' "$host" "$port"
fi
}

tcppf_write_settings(){
local content=$1 temp
mkdir -p -- "$(dirname -- "$DE_GWD_TCPPF_SETTINGS")" || return 1
temp=$(mktemp "${DE_GWD_TCPPF_SETTINGS}.XXXXXX") || return 1
if ! printf '%s\n' "$content" >"$temp" || ! chmod 0600 "$temp" || ! mv -f -- "$temp" "$DE_GWD_TCPPF_SETTINGS"; then
  rm -f -- "$temp"
  return 1
fi
}

tcppf_load(){
local rules='[]' feName bind localP up parsed host upPort
mkdir -p -- "$(dirname -- "$DE_GWD_TCPPF_SETTINGS")" || return 1
if [[ ! -f $DE_GWD_TCPPF_SETTINGS ]]; then
  if [[ -f $DE_GWD_HAPROXY_CONFIG ]]; then
    while IFS= read -r feName; do
      [[ -n $feName ]] || continue
      bind=$(awk -v name="$feName" '
        $1 == "frontend" && $2 == name {inside=1; next}
        inside && $1 == "frontend" {exit}
        inside && $1 == "bind" {print $2; exit}
      ' "$DE_GWD_HAPROXY_CONFIG" 2>/dev/null)
      localP=${bind##*:}
      up=$(awk -v name="$feName" '
        $1 == "backend" && $2 == name {inside=1; next}
        inside && $1 == "backend" {exit}
        inside && $1 == "server" && $2 == "endpoint" {print $3; exit}
      ' "$DE_GWD_HAPROXY_CONFIG" 2>/dev/null)
      [[ $localP =~ ^[0-9]+$ ]] && (( localP >= 1 && localP <= 65535 )) || continue
      parsed=$(parseDomainPort "$up" 2>/dev/null) || continue
      host=; upPort=
      read -r host upPort <<<"$parsed"
      [[ -n $host && $upPort =~ ^[0-9]+$ ]] || continue
      up=$(formatDomainPort "$host" "$upPort")
      if ! jq -e --argjson lp "$localP" '.[] | select(.localPort == $lp)' <<<"$rules" >/dev/null 2>&1; then
        rules=$(jq -c --argjson lp "$localP" --arg upstream "$up" '. + [{localPort:$lp, upstream:$upstream}]' <<<"$rules") || return 1
      fi
    done < <(awk '$1 == "frontend" {print $2}' "$DE_GWD_HAPROXY_CONFIG" 2>/dev/null)
  fi
  tcppf_write_settings "$(jq -cn --argjson rules "$rules" '{rules:$rules}')" || return 1
fi
if ! jq -e '.rules | type == "array"' "$DE_GWD_TCPPF_SETTINGS" >/dev/null 2>&1; then
  echo -e "${RED}TCP Port Forward settings are invalid${cRES}" >&2
  return 1
fi
TCPPFrules=$(jq -c '.rules' "$DE_GWD_TCPPF_SETTINGS") || return 1
}

tcppf_validate_rules(){
local n i localP upstream parsed host upPort
n=$(jq 'length' <<<"${TCPPFrules:-[]}" 2>/dev/null) || return 1
for (( i=0; i<n; i++ )); do
  localP=$(jq -r --argjson i "$i" '.[$i].localPort // empty' <<<"$TCPPFrules")
  upstream=$(jq -r --argjson i "$i" '.[$i].upstream // empty' <<<"$TCPPFrules")
  [[ $localP =~ ^[0-9]+$ ]] && (( localP >= 1 && localP <= 65535 )) || {
    echo -e "${RED}Invalid TCP forward local port${cRES}" >&2
    return 1
  }
  parsed=$(parseDomainPort "$upstream" 2>/dev/null) || {
    echo -e "${RED}Invalid TCP forward upstream${cRES}" >&2
    return 1
  }
  host=; upPort=
  read -r host upPort <<<"$parsed"
  [[ -n $host && $upPort =~ ^[0-9]+$ ]] || {
    echo -e "${RED}TCP forward upstream must be host:port${cRES}" >&2
    return 1
  }
  if jq -e --argjson lp "$localP" --argjson i "$i" '[.[:$i][] | select(.localPort == $lp)] | length > 0' <<<"$TCPPFrules" >/dev/null 2>&1; then
    echo -e "${RED}Duplicate TCP forward local port: $localP${cRES}" >&2
    return 1
  fi
done
return 0
}

tcppf_port_available(){
local candidate=$1 usedPort mappingPort
usedPort=$(awk '$1 == "listen" {gsub(/;/, "", $2); if ($2 ~ /^[0-9]+$/) print $2}' "$DE_GWD_NGINX_CONF_DIR/default.conf" 2>/dev/null | awk 'NR==1')
[[ $candidate = "$usedPort" || $candidate = "80" || $candidate = "443" || $candidate = "9890" || $candidate = "9891" || $candidate = "3000" || $candidate = "8053" ]] && return 1
for extraf in extra-reality.json extra-vlessws.json extra-socks5.json extra-dokodemo.json tcppf.json; do
  [[ -f $DE_GWD_DATA_DIR/$extraf ]] || continue
  if [[ $extraf != tcppf.json ]]; then
    extraJsonEnabled "$DE_GWD_DATA_DIR/$extraf" || continue
  fi
  usedPort=$(jq -r '.port // empty' "$DE_GWD_DATA_DIR/$extraf" 2>/dev/null)
  [[ $candidate = "$usedPort" ]] && return 1
  while IFS= read -r mappingPort; do
    [[ $candidate = "$mappingPort" ]] && return 1
  done < <(jq -r '.rules[]?.localPort // .rules[]?.port // empty' "$DE_GWD_DATA_DIR/$extraf" 2>/dev/null)
done
if [[ -f $DE_GWD_DATA_DIR/0conf ]]; then
  usedPort=$(jq -r '.FORWARD.Rproxy.server.tunnel.port // empty' "$DE_GWD_DATA_DIR/0conf" 2>/dev/null)
  [[ $candidate = "$usedPort" ]] && return 1
  while IFS= read -r mappingPort; do
    [[ $candidate = "$mappingPort" ]] && return 1
  done < <(jq -r '.FORWARD.Rproxy.server.mapping[]?.port // empty' "$DE_GWD_DATA_DIR/0conf" 2>/dev/null)
fi
return 0
}

tcppf_install_haproxy(){
[[ ${DE_GWD_TEST_MODE:-0} = 1 ]] && return 0
unset aptPKG
[[ -z $(dpkg -l 2>/dev/null | awk '{print$2}' | grep '^haproxy$') ]] && aptPKG+=(haproxy)
[[ -n ${aptPKG:-} ]] && apt update && apt install -y "${aptPKG[@]}" || true
[[ -z $(dpkg -l 2>/dev/null | awk '{print$2}' | grep '^haproxy$') && -n ${aptPKG:-} ]] && return 1
mkdir -p -- "$(dirname -- "$DE_GWD_HAPROXY_SERVICE")" || return 1
cat >"$DE_GWD_HAPROXY_SERVICE" <<EOF
[Unit]
Description=HAProxy
After=network.target rsyslog.service

[Service]
User=root
Type=notify
EnvironmentFile=-/etc/default/haproxy
Environment="CONFIG=$DE_GWD_HAPROXY_CONFIG" "PIDFILE=/run/haproxy.pid"
ExecStartPre=/usr/sbin/haproxy -f \$CONFIG -c -q \$EXTRAOPTS
ExecStart=/usr/sbin/haproxy -Ws -f \$CONFIG -p \$PIDFILE \$EXTRAOPTS
ExecReload=/usr/sbin/haproxy -f \$CONFIG -c -q \$EXTRAOPTS
ExecReload=/bin/kill -USR2 \$MAINPID
KillMode=mixed
Restart=always
RestartSec=2
TimeoutStopSec=5

[Install]
WantedBy=multi-user.target
EOF
systemctl daemon-reload >/dev/null 2>&1 || return 1
}

tcppf_render_config(){
local temp i n localP upstream name
mkdir -p -- "$(dirname -- "$DE_GWD_HAPROXY_CONFIG")" || return 1
temp=$(mktemp "${DE_GWD_HAPROXY_CONFIG}.XXXXXX") || return 1
cat >"$temp" <<'EOF'
global
  ulimit-n              500000
  maxconn               200000

defaults
  mode                  tcp
  option                dontlognull
  timeout connect       10s
  timeout client        1m
  timeout server        1m
  timeout check         10s

resolvers local
  nameserver            dns 127.0.0.1:53
  resolve_retries       3
  timeout retry         3s
  hold valid            10s
  accepted_payload_size 8192
EOF
n=$(jq 'length' <<<"$TCPPFrules") || { rm -f -- "$temp"; return 1; }
for (( i=0; i<n; i++ )); do
  localP=$(jq -r --argjson i "$i" '.[$i].localPort' <<<"$TCPPFrules")
  upstream=$(jq -r --argjson i "$i" '.[$i].upstream' <<<"$TCPPFrules")
  name="p${localP}"
  cat >>"$temp" <<EOF

frontend $name
  bind                  :$localP
  default_backend       $name

backend $name
  server endpoint $upstream check resolvers local init-addr none
EOF
done
chmod 0644 "$temp" && mv -f -- "$temp" "$DE_GWD_HAPROXY_CONFIG" || {
  rm -f -- "$temp"
  return 1
}
}

tcppf_apply_runtime(){
local n checkLog
tcppf_load || return 1
tcppf_validate_rules || return 1
n=$(jq 'length' <<<"$TCPPFrules") || return 1
if (( n == 0 )); then
  if [[ ${DE_GWD_TEST_MODE:-0} != 1 ]]; then
    systemctl stop haproxy >/dev/null 2>&1 || true
    systemctl disable haproxy >/dev/null 2>&1 || true
  fi
  rm -f -- "$DE_GWD_HAPROXY_CONFIG"
  return 0
fi
tcppf_install_haproxy || return 1
tcppf_render_config || return 1
checkLog=$(mktemp /tmp/de_GWD-haproxy-check.XXXXXX) || return 1
if ! "$DE_GWD_HAPROXY_BIN" -f "$DE_GWD_HAPROXY_CONFIG" -c -q >"$checkLog" 2>&1; then
  echo -e "${WHITE}[ ${RED}✕ ${WHITE}]\c" && echo -e "\t${WHITE}HAProxy config invalid${cRES}" >&2
  sed -n '1,15p' "$checkLog" >&2
  rm -f -- "$checkLog"
  return 1
fi
rm -f -- "$checkLog"
if [[ ${DE_GWD_TEST_MODE:-0} = 1 ]]; then
  return 0
fi
systemctl enable haproxy >/dev/null 2>&1 || return 1
systemctl restart haproxy >/dev/null 2>&1 || return 1
if ! systemctl is-active --quiet haproxy; then
  echo -e "${WHITE}[ ${RED}✕ ${WHITE}]\c" && echo -e "\t${WHITE}HAProxy failed to start${cRES}" >&2
  return 1
fi
}

tcppf_apply_transaction(){
local candidate=$1 bak_settings bak_cfg had_settings=0 had_cfg=0
bak_settings=$(mktemp /tmp/de_GWD-tcppf-bak-settings.XXXXXX) || return 1
bak_cfg=$(mktemp /tmp/de_GWD-tcppf-bak-cfg.XXXXXX) || { rm -f -- "$bak_settings"; return 1; }
if [[ -f $DE_GWD_TCPPF_SETTINGS ]]; then
  cp -f -- "$DE_GWD_TCPPF_SETTINGS" "$bak_settings" && had_settings=1
fi
if [[ -f $DE_GWD_HAPROXY_CONFIG ]]; then
  cp -f -- "$DE_GWD_HAPROXY_CONFIG" "$bak_cfg" && had_cfg=1
fi
if ! mv -f -- "$candidate" "$DE_GWD_TCPPF_SETTINGS" || ! tcppf_apply_runtime; then
  if [[ $had_settings = 1 ]]; then
    mv -f -- "$bak_settings" "$DE_GWD_TCPPF_SETTINGS"
  else
    rm -f -- "$DE_GWD_TCPPF_SETTINGS"
  fi
  if [[ $had_cfg = 1 ]]; then
    mv -f -- "$bak_cfg" "$DE_GWD_HAPROXY_CONFIG"
  else
    rm -f -- "$DE_GWD_HAPROXY_CONFIG"
  fi
  rm -f -- "$bak_settings" "$bak_cfg"
  return 1
fi
rm -f -- "$bak_settings" "$bak_cfg"
return 0
}

tcppf_list(){
local domain n i localP upstream
tcppf_load || return 1
tcppf_validate_rules || return 1
domain=$(awk '/server_name/ {gsub(/;/, "", $2); print $2; exit}' "$DE_GWD_NGINX_CONF_DIR/default.conf" 2>/dev/null)
[[ -n $domain ]] || domain="0.0.0.0"
n=$(jq 'length' <<<"$TCPPFrules") || return 1
echo -e "${GREEN}HAProxy TCP Port Forward${cRES}"
if (( n == 0 )); then
  echo -e "${YELLOW}(empty)${cRES}"
else
  for (( i=0; i<n; i++ )); do
    localP=$(jq -r --argjson i "$i" '.[$i].localPort' <<<"$TCPPFrules")
    upstream=$(jq -r --argjson i "$i" '.[$i].upstream' <<<"$TCPPFrules")
    echo -e "${BLUE}Address:       ${YELLOW}$domain:$localP${cRES}"
    echo -e "${BLUE}Upstream:      ${YELLOW}$upstream${cRES}"
    echo
  done
fi
}

tcppf_add(){
local upDomainP localP parsed host upPort candidate
tcppf_load || return 1
tcppf_validate_rules || return 1
echo -e "${GREEN}======================= ${cRES}"
echo -e "${GREEN}Upstream Domain & Port${cRES}"
echo -e "${GREEN}======================= ${cRES}"
read -r upDomainP
parsed=$(parseDomainPort "$upDomainP" 2>/dev/null) || {
  echo -e "${WHITE}[ ${RED}✕ ${WHITE}]\c" && echo -e "\t${WHITE}Upstream must be host:port${cRES}"
  return 1
}
host=; upPort=
read -r host upPort <<<"$parsed"
if [[ -z $host || ! $upPort =~ ^[0-9]+$ ]] || (( upPort < 1 || upPort > 65535 )); then
  echo -e "${WHITE}[ ${RED}✕ ${WHITE}]\c" && echo -e "\t${WHITE}Upstream must be host:port${cRES}"
  return 1
fi
upDomainP=$(formatDomainPort "$host" "$upPort")
echo -e "${GREEN}======================= ${cRES}"
echo -e "${GREEN}Local Port${cRES}"
echo -e "${GREEN}======================= ${cRES}"
read -r localP
if [[ ! $localP =~ ^[0-9]{1,5}$ ]]; then
  echo -e "${WHITE}[ ${RED}✕ ${WHITE}]\c" && echo -e "\t${WHITE}Invalid local port${cRES}"
  return 1
fi
localP=$((10#$localP))
if (( localP < 1 || localP > 65535 )); then
  echo -e "${WHITE}[ ${RED}✕ ${WHITE}]\c" && echo -e "\t${WHITE}Invalid local port${cRES}"
  return 1
fi
if ! tcppf_port_available "$localP"; then
  echo -e "${WHITE}[ ${RED}✕ ${WHITE}]\c" && echo -e "\t${WHITE}Local port $localP conflicts with nginx/RproxyS${cRES}"
  return 1
fi
if jq -e --argjson lp "$localP" '.[] | select(.localPort == $lp)' <<<"$TCPPFrules" >/dev/null 2>&1; then
  echo -e "${WHITE}[ ${RED}✕ ${WHITE}]\c" && echo -e "\t${WHITE}Local port $localP already exists${cRES}"
  return 1
fi
candidate=$(mktemp /tmp/de_GWD-tcppf-candidate.XXXXXX) || return 1
if ! jq --argjson lp "$localP" --arg upstream "$upDomainP" \
  '.rules += [{localPort:$lp, upstream:$upstream}]' "$DE_GWD_TCPPF_SETTINGS" >"$candidate"; then
  rm -f -- "$candidate"
  return 1
fi
if ! tcppf_apply_transaction "$candidate"; then
  rm -f -- "$candidate"
  return 1
fi
echo -e "${BLUE}------------------------------------------------ ${cRES}"
echo -e "${GREEN}TCP Port Forward${cRES}"
echo -e "${BLUE}Address:       ${YELLOW}$localP${cRES}"
echo -e "${BLUE}Upstream:      ${YELLOW}$upDomainP${cRES}"
echo -e "${BLUE}------------------------------------------------ ${cRES}"
echo -e "${WHITE}[ ${GREEN}✓ ${WHITE}]\c" && echo -e "\t${WHITE}TCP Port Forward ${GREEN}Added${cRES}"
}

tcppf_del(){
local n delID index i candidate
tcppf_load || return 1
tcppf_validate_rules || return 1
n=$(jq 'length' <<<"$TCPPFrules") || return 1
if (( n == 0 )); then
  echo -e "${WHITE}[ ${YELLOW}! ${WHITE}]\c" && echo -e "\t${WHITE}No TCP Port Forward rules${cRES}"
  return 1
fi
tcppf_list || return 1
echo -e "${GREEN}Input local port to delete, or all${cRES}"
read -r delID
if [[ $delID = all ]]; then
  tcppf_del_all
  return $?
fi
index=
if [[ $delID =~ ^[0-9]+$ ]]; then
  for (( i=0; i<n; i++ )); do
    if [[ $(jq -r --argjson i "$i" '.[$i].localPort' <<<"$TCPPFrules") = "$delID" ]]; then
      index=$i
      break
    fi
  done
fi
if [[ -z $index ]]; then
  echo -e "${WHITE}[ ${RED}✕ ${WHITE}]\c" && echo -e "\t${WHITE}Invalid local port${cRES}"
  return 1
fi
candidate=$(mktemp /tmp/de_GWD-tcppf-candidate.XXXXXX) || return 1
if ! jq --argjson i "$index" 'del(.rules[$i])' "$DE_GWD_TCPPF_SETTINGS" >"$candidate" || ! tcppf_apply_transaction "$candidate"; then
  rm -f -- "$candidate"
  return 1
fi
echo -e "${WHITE}[ ${GREEN}✓ ${WHITE}]\c" && echo -e "\t${WHITE}TCP Port Forward ${GREEN}Deleted${cRES}"
}

tcppf_del_all(){
local candidate
tcppf_load || return 1
candidate=$(mktemp /tmp/de_GWD-tcppf-candidate.XXXXXX) || return 1
printf '%s\n' '{"rules":[]}' >"$candidate"
if ! tcppf_apply_transaction "$candidate"; then
  rm -f -- "$candidate"
  return 1
fi
echo -e "${WHITE}[ ${GREEN}✓ ${WHITE}]\c" && echo -e "\t${WHITE}All TCP Port Forward ${GREEN}Deleted${cRES}"
}

