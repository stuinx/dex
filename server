checkSum(){
sha256sumL=$(sha256sum $1 2>/dev/null | awk '{print$1}')
if [[ $sha256sumL = $2 ]]; then 
  echo "true"
elif [[ $sha256sumL != $2 ]]; then
  echo "false"
fi
}

checkTimeStatus(){
local currentEpoch
currentEpoch=$(date +%s 2>/dev/null) || {
  echo -e "${WHITE}System time${RED} Read Failed${cRES}"
  exit 1
}
if [[ $currentEpoch -lt 1700000000 ]]; then
  echo -e "${WHITE}System time${RED} Clock is not plausible${cRES}"
  exit 1
fi
if command -v timedatectl >/dev/null 2>&1 && [[ $(timedatectl show -p NTPSynchronized --value 2>/dev/null) = "no" ]]; then
  echo -e "${WHITE}System time${YELLOW} NTP is not synchronized; TLS results require follow-up${cRES}"
fi
}

validateCertificate(){
local certificateHost
local -a certificateHosts=("$@")
[[ ${#certificateHosts[@]} -gt 0 ]] || certificateHosts=("$domain")
if [[ ! -s /var/www/ssl/de_GWD.cer ]] || [[ ! -s /var/www/ssl/de_GWD.key ]]; then
  echo -e "${WHITE}TLS certificate${RED} Certificate or key is missing${cRES}"
  exit 1
fi
openssl x509 -in /var/www/ssl/de_GWD.cer -noout >/dev/null 2>&1 || {
  echo -e "${WHITE}TLS certificate${RED} Certificate is invalid${cRES}"
  exit 1
}
for certificateHost in "${certificateHosts[@]}"; do
  [[ -n $certificateHost ]] || continue
  openssl x509 -in /var/www/ssl/de_GWD.cer -noout -checkhost "$certificateHost" >/dev/null 2>&1 || {
    echo -e "${WHITE}TLS certificate${RED} Hostname is not covered: $certificateHost${cRES}"
    exit 1
  }
done
nginx -t >/dev/null 2>&1 || {
  echo -e "${WHITE}TLS certificate${RED} Nginx validation failed${cRES}"
  exit 1
}
systemctl force-reload nginx || {
  echo -e "${WHITE}TLS certificate${RED} Nginx reload failed${cRES}"
  exit 1
}
}



repoDL(){
echo -e "${WHITE}[...]\c" && echo -e "\t${WHITE}Repository${cRES}\r\c"
sha256sum_de_GWD=$(curl -fsSLo- "$repoBase/de_GWD_${architecture}.zip.sha256sum")
sha256sum_don_server=$(curl -fsSLo- "$repoBase/resource/doh/doh_s_${architecture}.sha256sum")
sha256sum_nginx=$(curl -fsSLo- "$repoBase/resource/nginx/nginx_${architecture}.sha256sum")
sha256sum_nginxConf=$(curl -fsSLo- "$repoBase/resource/nginx/nginxConf.zip.sha256sum")
sha256sum_sample=$(curl -fsSLo- "$repoBase/resource/server/sample.zip.sha256sum")
if [[ -z $sha256sum_de_GWD ]] || [[ -z $sha256sum_don_server ]] || [[ -z $sha256sum_nginx ]] || [[ -z $sha256sum_nginxConf ]] || [[ -z $sha256sum_sample ]]; then
  echo -e "${WHITE}Repository${RED} Checksum download failed${cRES}"
  exit 1
fi

if [[ $(checkSum /opt/de_GWD/doh-server $sha256sum_don_server) = "false" ]]; then
rm -rf /tmp/doh-server
wget --show-progress -cqO /tmp/doh-server "$repoBase/resource/doh/doh_s_$architecture"
[[ $(checkSum /tmp/doh-server $sha256sum_don_server) = "false" ]] && echo -e "${RED}Download Failed${cRES}" && exit 1
[[ $(checkSum /tmp/doh-server $sha256sum_don_server) = "true" ]] && mv -f /tmp/doh-server /opt/de_GWD/doh-server && chmod +x /opt/de_GWD/doh-server
fi

if [[ $(checkSum /usr/sbin/nginx $sha256sum_nginx) = "false" ]]; then
rm -rf /tmp/nginx
wget --show-progress -cqO /tmp/nginx "$repoBase/resource/nginx/nginx_${architecture}"
[[ $(checkSum /tmp/nginx $sha256sum_nginx) = "false" ]] && echo -e "${RED}Download Failed${cRES}" && exit 1
[[ $(checkSum /tmp/nginx $sha256sum_nginx) = "true" ]] && mv -f /tmp/nginx /usr/sbin/nginx && chmod +x /usr/sbin/nginx
fi

if [[ $(checkSum /opt/de_GWD/.repo/de_GWD.zip $sha256sum_de_GWD) = "false" ]]; then
rm -rf /tmp/de_GWD.zip
wget --show-progress -cqO /tmp/de_GWD.zip "$repoBase/de_GWD_${architecture}.zip"
[[ $(checkSum /tmp/de_GWD.zip $sha256sum_de_GWD) = "false" ]] && echo -e "${RED}Download Failed${cRES}" && exit 1
[[ $(checkSum /tmp/de_GWD.zip $sha256sum_de_GWD) = "true" ]] && mv -f /tmp/de_GWD.zip /opt/de_GWD/.repo/de_GWD.zip
fi

if [[ $(checkSum /opt/de_GWD/.repo/nginxConf.zip $sha256sum_nginxConf) = "false" ]]; then
rm -rf /tmp/nginxConf.zip
wget --show-progress -cqO /tmp/nginxConf.zip "$repoBase/resource/nginx/nginxConf.zip"
[[ $(checkSum /tmp/nginxConf.zip $sha256sum_nginxConf) = "false" ]] && echo -e "${RED}Download Failed${cRES}" && exit 1
[[ $(checkSum /tmp/nginxConf.zip $sha256sum_nginxConf) = "true" ]] && mv -f /tmp/nginxConf.zip /opt/de_GWD/.repo/nginxConf.zip
fi

if [[ $(checkSum /opt/de_GWD/.repo/sample.zip $sha256sum_sample) = "false" ]]; then
rm -rf /tmp/sample.zip
wget --show-progress -cqO /tmp/sample.zip "$repoBase/resource/server/sample.zip"
[[ $(checkSum /tmp/sample.zip $sha256sum_sample) = "false" ]] && echo -e "${RED}Download Failed${cRES}" && exit 1
[[ $(checkSum /tmp/sample.zip $sha256sum_sample) = "true" ]] && mv -f /tmp/sample.zip /opt/de_GWD/.repo/sample.zip
fi

localVer=$(awk 'NR==1' /opt/de_GWD/version.php 2>/dev/null)
remoteVer=$(curl -fsSLo- "$repoBase/version.php" | head -n 1)

if [[ $localVer != $remoteVer ]]; then
rm -rf /tmp/version.php
wget --show-progress -cqO /tmp/version.php "$repoBase/version.php"
[[ $? -ne 0 ]] && echo -e "${WHITE}Version File${RED} Download Failed${cRES}" && exit 1
[[ $(du -sk /tmp/version.php 2>/dev/null | awk '{print$1}') -ge 4 ]] && mv -f /tmp/version.php /opt/de_GWD/version.php
fi

for requiredResource in /opt/de_GWD/doh-server /opt/de_GWD/.repo/de_GWD.zip /opt/de_GWD/.repo/nginxConf.zip /opt/de_GWD/.repo/sample.zip; do
  [[ -s $requiredResource ]] || { echo -e "${WHITE}Repository${RED} Missing resource: $requiredResource${cRES}"; exit 1; }
done
[[ -z $(unzip -tq /opt/de_GWD/.repo/de_GWD.zip | grep "No errors detected in compressed data") ]] && echo -e "${WHITE}de_GWD Zip${RED} Download Failed${cRES}" && exit 1
[[ -z $(unzip -tq /opt/de_GWD/.repo/nginxConf.zip | grep "No errors detected in compressed data") ]] && echo -e "${WHITE}Nginx Config${RED} Download Failed${cRES}" && exit 1
[[ -z $(unzip -tq /opt/de_GWD/.repo/sample.zip | grep "No errors detected in compressed data") ]] && echo -e "${WHITE}Sample Config${RED} Download Failed${cRES}" && exit 1

echo -e "${WHITE}[ ${GREEN}✓ ${WHITE}]\c" && echo -e "\t${WHITE}Repository${cRES}"
}



