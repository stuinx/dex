;;
3)
tcppf_delall
;;
4)
tcppf_status
;;
esac
}

rproxySgenuuid(){
uuidgen 2>/dev/null || cat /proc/sys/kernel/random/uuid 2>/dev/null
}

rproxySconf(){
printf '%s\n' "${DE_GWD_DATA_DIR:-/opt/de_GWD}/0conf"
}

extraRproxyNormalizeProtocol(){
local in=$1
case "$in" in
  ""|both|all|1|tcpudp|tcp/udp|tcp+udp) echo "tcp,udp" ;;
  tcp) echo "tcp" ;;
  udp) echo "udp" ;;
  2|3|tcp,udp|udp,tcp) echo "tcp,udp" ;;
  *) return 1 ;;
esac
}

rproxyScommit(){
# Auto-deploy after every mutation (no standalone Apply option).
# Deployer is /opt/de_GWD/rproxyS-save (the same resource installRproxyS ships).
# The old ui-RproxySsave name exists on client-side UIs, not on the server.
local f=/opt/de_GWD/rproxyS-save
local here=$(cd "$(dirname "${BASH_SOURCE[0]:-$0}")" 2>/dev/null && pwd)
local src url rc
[[ ${DE_GWD_TEST_MODE:-0} = 1 ]] && return 0
for src in "$f" "$here/rproxyS-save" "$here/resource/server/rproxyS-save" /opt/de_GWD/resource/server/rproxyS-save; do
  [[ -f $src ]] || continue
  if [[ $src != $f ]]; then
    cp -f "$src" "$f" && chmod +x "$f"
  fi
  bash "$f" >/dev/null 2>&1
  rc=$?
  [[ $rc = 0 ]] || echo -e "${RED}RproxyS deploy failed (rc=$rc)${cRES}"
  return $rc
done
url="https://raw.githubusercontent.com/stuinx/dex/${branch:-dev}/resource/server/rproxyS-save"
mkdir -p /opt/de_GWD
wget -t 5 -T 15 -cqO "$f" "$url" 2>/dev/null || curl -fsSLo "$f" "$url" 2>/dev/null || true
if [[ -s $f ]]; then
  chmod +x "$f"
  bash "$f" >/dev/null 2>&1
  rc=$?
  [[ $rc = 0 ]] || echo -e "${RED}RproxyS deploy failed (rc=$rc)${cRES}"
  return $rc
fi
echo -e "${RED}missing $f${cRES}"
return 1
}

rproxySstop(){
if [[ ${DE_GWD_TEST_MODE:-0} = 1 ]]; then
  echo -e "${WHITE}[ ${GREEN}✓ ${WHITE}]\c" && echo -e "\t${WHITE}RproxyS ${GREEN}Stopped${cRES}"
  return 0
fi
systemctl disable --now RproxyS >/dev/null 2>&1
rm -rf /lib/systemd/system/RproxyS.service
rm -rf /etc/systemd/system/RproxyS.service
rm -rf /opt/de_GWD/RproxyS
systemctl daemon-reload >/dev/null
echo -e "${WHITE}[ ${GREEN}✓ ${WHITE}]\c" && echo -e "\t${WHITE}RproxyS ${GREEN}Stopped${cRES}"
return 0
}

rproxySstatus(){
local conf domain svc tunnelPort tunnelUUID inStatus mapStatus nin
: "${DE_GWD_DATA_DIR:=/opt/de_GWD}"
conf=$DE_GWD_DATA_DIR/0conf
domain=$(extraGetDomain)
[[ -z $domain ]] && domain="${RPROXY_HOST:-}"
svc=$(systemctl is-active RproxyS 2>/dev/null || echo inactive)
echo -e "${BLUE}-------------------------------------------------- ${cRES}"
echo -e "${GREEN}RproxyS status${cRES}"
echo -e "${BLUE}Service:    ${YELLOW}$svc${cRES}"
if [[ -f $conf ]]; then
  tunnelPort=$(jq -r '.FORWARD.Rproxy.server.tunnel.port // empty' "$conf" 2>/dev/null | grep -v '^null$')
else
  tunnelPort=""
fi
if [[ -z $tunnelPort ]]; then
  echo -e "${YELLOW}No RproxyS settings${cRES}"
  echo -e "${BLUE}-------------------------------------------------- ${cRES}"
  return 0
fi
tunnelUUID=$(jq -r '.FORWARD.Rproxy.server.tunnel.uuid // empty' "$conf" 2>/dev/null | grep -v '^null$')
inStatus=$(jq -r '.FORWARD.Rproxy.server.inStatus // "off"' "$conf" 2>/dev/null)
mapStatus=$(jq -r '.FORWARD.Rproxy.server.mappingStatus // "off"' "$conf" 2>/dev/null)
echo -e "${BLUE}Address:    ${YELLOW}${domain:-?}:${tunnelPort}${cRES}"
echo -e "${BLUE}UUID:       ${YELLOW}$tunnelUUID${cRES}"
echo -e "${BLUE}inStatus:   ${YELLOW}$inStatus${cRES}"
nin=$(jq -r '.FORWARD.Rproxy.server.inUUID // empty | length' "$conf" 2>/dev/null)
if [[ $nin =~ ^[0-9]+$ ]] && (( nin > 0 )); then
  jq -r '.FORWARD.Rproxy.server.inUUID[] | "  \(.RproxyS0uuid)"' "$conf" 2>/dev/null
fi
echo -e "${BLUE}Mapping:    ${YELLOW}$mapStatus${cRES}"
jq -r '.FORWARD.Rproxy.server.mapping[]? | "  :"+(.port|tostring)+"  "+(.protocol // "tcp,udp")' "$conf" 2>/dev/null
echo -e "${BLUE}-------------------------------------------------- ${cRES}"
return 0
}

rproxySsetTunnel(){
local conf oldPort oldUUID tunnelPort tunnelUUID inCur inNew
conf=$(rproxySconf)
[[ -f $conf ]] || echo '{}' > "$conf"
oldPort=$(jq -r '.FORWARD.Rproxy.server.tunnel.port // empty' "$conf" 2>/dev/null | grep -v '^null$')
oldUUID=$(jq -r '.FORWARD.Rproxy.server.tunnel.uuid // empty' "$conf" 2>/dev/null | grep -v '^null$')
if [[ -n $oldPort ]]; then
  echo -e "${GREEN} Tunnel port  (empty = $oldPort)${cRES}"
else
  echo -e "${GREEN} Tunnel port${cRES}"
fi
read tunnelPort
[[ -z $tunnelPort ]] && tunnelPort="$oldPort"
[[ -n $tunnelPort ]] || { echo -e "${RED}Invalid port${cRES}"; return 1; }
[[ $tunnelPort =~ ^[1-9][0-9]{0,4}$ ]] && (( tunnelPort <= 65535 )) || { echo -e "${RED}Invalid port (must be 1-65535)${cRES}"; return 1; }
if [[ $tunnelPort != "$oldPort" ]]; then
  extraXPortFree "$tunnelPort" || return 1
fi
if [[ -n $oldUUID ]]; then
  echo -e "${GREEN} Tunnel UUID  (empty = $oldUUID)${cRES}"
else
  echo -e "${GREEN} Tunnel UUID  (empty = generate)${cRES}"
fi
read tunnelUUID
[[ -z $tunnelUUID ]] && tunnelUUID="${oldUUID:-$(rproxySgenuuid)}"
if [[ $tunnelUUID != "$oldUUID" ]]; then
  [[ $tunnelUUID =~ ^[0-9a-fA-F-]{36}$ ]] || { echo -e "${RED}Invalid UUID format${cRES}"; return 1; }
fi
inCur=$(jq -r '.FORWARD.Rproxy.server.inStatus // "off"' "$conf" 2>/dev/null)
echo -e "${GREEN} inStatus on/off?  (current = $inCur)${cRES}"
read inNew
if [[ -n $inNew ]]; then
  case "$inNew" in
    on) inCur=on ;;
    off) inCur=off ;;
    *) echo -e "${RED}Invalid inStatus${cRES}"; return 1 ;;
  esac
fi
jq --arg port "$tunnelPort" --arg uuid "$tunnelUUID" --arg instat "$inCur" '
  .FORWARD = (.FORWARD // {}) |
  .FORWARD.Rproxy = (.FORWARD.Rproxy // {}) |
  .FORWARD.Rproxy.server = (.FORWARD.Rproxy.server // {}) |
  .FORWARD.Rproxy.server.inStatus = $instat |
  .FORWARD.Rproxy.server.inUUID = (.FORWARD.Rproxy.server.inUUID // []) |
  .FORWARD.Rproxy.server.mapping = (.FORWARD.Rproxy.server.mapping // []) |
  .FORWARD.Rproxy.server.mappingStatus = (if (.FORWARD.Rproxy.server.mapping|length)>0 then "on" else "off" end) |
  .FORWARD.Rproxy.server.tunnel.port = ($port|tonumber) |
  .FORWARD.Rproxy.server.tunnel.uuid = $uuid
' "$conf" | sponge "$conf"
rproxyScommit
return $?
}

rproxySmapMenu(){
local conf tunnelPort op mapPort mapProto normProto del curCount
conf=$(rproxySconf)
tunnelPort=$(jq -r '.FORWARD.Rproxy.server.tunnel.port // empty' "$conf" 2>/dev/null | grep -v '^null$')
if [[ -z $tunnelPort ]]; then
  echo -e "${YELLOW}Tunnel not configured yet. Configure tunnel first:${cRES}"
  rproxySsetTunnel || return 1
  tunnelPort=$(jq -r '.FORWARD.Rproxy.server.tunnel.port // empty' "$conf" 2>/dev/null | grep -v '^null$')
  [[ -n $tunnelPort ]] || return 1
fi
echo -e "${GREEN}================================ ${cRES}"
echo -e "${GREEN} Mapping   [1]: Add   [2]: Delete   [0]: Back${cRES}"
echo -e "${GREEN}================================ ${cRES}"
read -s -n 1 op
echo
[[ $op = "0" || -z $op ]] && return 0
if [[ $op = "1" ]]; then
  echo -e "${GREEN} Mapping port${cRES}"
  read mapPort
  [[ -n $mapPort && $mapPort =~ ^[1-9][0-9]{0,4}$ ]] && (( mapPort <= 65535 )) || { echo -e "${RED}Invalid port${cRES}"; return 1; }
  extraXPortFree "$mapPort" || return 1
  echo -e "${GREEN} Protocol tcp / udp / tcp,udp (empty = tcp,udp)${cRES}"
  read mapProto
  normProto=$(extraRproxyNormalizeProtocol "$mapProto") || { echo -e "${RED}Invalid protocol${cRES}"; return 1; }
  jq --arg port "$mapPort" --arg proto "$normProto" '
    .FORWARD.Rproxy.server.mapping = ((.FORWARD.Rproxy.server.mapping // []) + [{port:($port|tonumber),protocol:$proto}] | unique_by(.port|tostring)) |
    .FORWARD.Rproxy.server.mappingStatus = (if (.FORWARD.Rproxy.server.mapping|length)>0 then "on" else "off" end)
  ' "$conf" | sponge "$conf"
  rproxyScommit || return 1
  echo -e "${WHITE}[ ${GREEN}✓ ${WHITE}]\c" && echo -e "\t${WHITE}RproxyS mapping ${GREEN}Added${cRES}"
  return 0
fi
if [[ $op = "2" ]]; then
  curCount=$(jq -r '.FORWARD.Rproxy.server.mapping // empty | length' "$conf" 2>/dev/null)
  if [[ ! $curCount =~ ^[0-9]+$ ]] || (( curCount == 0 )); then
    echo -e "${YELLOW}No mappings to delete${cRES}"
    return 1
  fi
  jq -r '.FORWARD.Rproxy.server.mapping[]? | "  :"+(.port|tostring)+"  "+(.protocol // "tcp,udp")' "$conf" 2>/dev/null
  echo -e "${GREEN} Mapping port to delete, or all${cRES}"
  read del
  [[ -n $del ]] || return 1
  if [[ $del = all ]]; then
    jq '.FORWARD.Rproxy.server.mapping=[] | .FORWARD.Rproxy.server.mappingStatus=(if (.FORWARD.Rproxy.server.mapping|length)>0 then "on" else "off" end)' "$conf" | sponge "$conf"
  elif [[ $del =~ ^[0-9]+$ ]]; then
    if ! jq -e --argjson p "$del" '.FORWARD.Rproxy.server.mapping[] | select((.port|tostring) == ($p|tostring))' "$conf" >/dev/null 2>&1; then
      echo -e "${RED}Port $del not found in mappings${cRES}"
      return 1
    fi
    jq --argjson p "$del" '
      .FORWARD.Rproxy.server.mapping = ((.FORWARD.Rproxy.server.mapping // []) | map(select((.port|tostring) != ($p|tostring)))) |
      .FORWARD.Rproxy.server.mappingStatus = (if (.FORWARD.Rproxy.server.mapping|length)>0 then "on" else "off" end)
    ' "$conf" | sponge "$conf"
  else
    echo -e "${RED}Invalid port${cRES}"
    return 1
  fi
  rproxyScommit || return 1
  echo -e "${WHITE}[ ${GREEN}✓ ${WHITE}]\c" && echo -e "\t${WHITE}RproxyS mapping ${GREEN}Deleted${cRES}"
  return 0
fi
echo -e "${RED}Wrong number${cRES}"
return 1
}

rproxySuuidMenu(){
local conf op n uuid
conf=$(rproxySconf)
echo -e "${GREEN}================================ ${cRES}"
echo -e "${GREEN} Client UUID   [1]: Add   [2]: Delete   [0]: Back${cRES}"
echo -e "${GREEN}================================ ${cRES}"
read -s -n 1 op
echo
[[ $op = "0" || -z $op ]] && return 0
if [[ $op = "1" ]]; then
  uuid=$(rproxySgenuuid)
  [[ -n $uuid ]] || { echo -e "${RED}UUID generation failed${cRES}"; return 1; }
  jq --arg uuid "$uuid" '
    .FORWARD = (.FORWARD // {}) |
    .FORWARD.Rproxy = (.FORWARD.Rproxy // {}) |
    .FORWARD.Rproxy.server = (.FORWARD.Rproxy.server // {}) |
    .FORWARD.Rproxy.server.inUUID = ((.FORWARD.Rproxy.server.inUUID // []) + [{"RproxyS0uuid":$uuid}])
  ' "$conf" | sponge "$conf"
  rproxyScommit || return 1
  echo -e "${WHITE}[ ${GREEN}✓ ${WHITE}]\c" && echo -e "\t${WHITE}inUUID ${GREEN}$uuid${cRES}"
  return 0
fi
if [[ $op = "2" ]]; then
  n=$(jq -r '.FORWARD.Rproxy.server.inUUID // empty | length' "$conf" 2>/dev/null)
  if [[ ! $n =~ ^[0-9]+$ ]] || (( n == 0 )); then
    echo -e "${YELLOW}No inUUID to delete${cRES}"
    return 1
  fi
  jq -r '.FORWARD.Rproxy.server.inUUID | to_entries[] | "\(.key))  \(.value.RproxyS0uuid)"' "$conf" 2>/dev/null
  echo -e "${GREEN}-------------------------------- ${cRES}"
  echo -e "${GREEN}Delete inUUID (number)${cRES}"
  echo -e "${GREEN}-------------------------------- ${cRES}"
  read uuid
  if [[ -z $uuid || ! $uuid =~ ^[0-9]+$ ]]; then
    echo -e "${RED}Invalid number${cRES}"
    return 1
  fi
  if (( uuid >= n )); then
    echo -e "${RED}No such inUUID${cRES}"
    return 1
  fi
  jq "del(.FORWARD.Rproxy.server.inUUID[$uuid])" "$conf" | sponge "$conf"
  rproxyScommit || return 1
  echo -e "${WHITE}[ ${GREEN}✓ ${WHITE}]\c" && echo -e "\t${WHITE}inUUID ${GREEN}Deleted${cRES}"
  return 0
fi
echo -e "${RED}Wrong number${cRES}"
return 1
}

