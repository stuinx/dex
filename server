extra_validateSettings(){
local settings=$1
local enabled domain port uuid path flow dest serverName privateKey publicKey shortId user password
local ruleCount i target targetPort network p usedPorts=""
[[ -s $settings ]] || return 0
jq -e 'type == "object"' "$settings" >/dev/null 2>&1 || return 1

enabled=$(jq -r '.vless_ws.enabled // false' "$settings")
if [[ $enabled = "true" ]]; then
  domain=$(jq -r '.vless_ws.domain // empty' "$settings")
  port=$(jq -r '.vless_ws.port // empty' "$settings")
  uuid=$(jq -r '.vless_ws.uuid // empty' "$settings")
  path=$(jq -r '.vless_ws.path // empty' "$settings")
  extra_validHost "$domain" && extra_validPort "$port" && extra_validUUID "$uuid" || return 1
  [[ $path == /* && $path != *[[:space:]]* ]] || return 1
  usedPorts="$port"
  [[ $port != "9890" && $port != "9891" ]] || return 1
fi

enabled=$(jq -r '.reality.enabled // false' "$settings")
if [[ $enabled = "true" ]]; then
  domain=$(jq -r '.reality.domain // empty' "$settings")
  port=$(jq -r '.reality.port // empty' "$settings")
  uuid=$(jq -r '.reality.uuid // empty' "$settings")
  flow=$(jq -r '.reality.flow // empty' "$settings")
  dest=$(jq -r '.reality.dest // empty' "$settings")
  serverName=$(jq -r '.reality.serverName // empty' "$settings")
  privateKey=$(jq -r '.reality.privateKey // empty' "$settings")
  publicKey=$(jq -r '.reality.publicKey // empty' "$settings")
  shortId=$(jq -r '.reality.shortId // empty' "$settings")
  extra_validHost "$domain" && extra_validPort "$port" && extra_validUUID "$uuid" || return 1
  [[ -z $flow || $flow = "xtls-rprx-vision" ]] || return 1
  extra_parseDomainPort "$dest" >/dev/null || return 1
  extra_validHost "$serverName" || return 1
  [[ $privateKey =~ ^[A-Za-z0-9_-]+$ && $publicKey =~ ^[A-Za-z0-9_-]+$ ]] || return 1
  [[ $shortId =~ ^[0-9a-fA-F]{2,16}$ ]] || return 1
  [[ ",$usedPorts," != *",$port,"* ]] || return 1
  usedPorts="${usedPorts:+$usedPorts,}$port"
fi

enabled=$(jq -r '.socks5.enabled // false' "$settings")
if [[ $enabled = "true" ]]; then
  domain=$(jq -r '.socks5.domain // empty' "$settings")
  port=$(jq -r '.socks5.port // empty' "$settings")
  user=$(jq -r '.socks5.user // empty' "$settings")
  password=$(jq -r '.socks5.password // empty' "$settings")
  extra_validHost "$domain" && extra_validPort "$port" || return 1
  [[ $user =~ ^[A-Za-z0-9._~-]+$ && $password =~ ^[A-Za-z0-9._~-]+$ ]] || return 1
  [[ ",$usedPorts," != *",$port,"* ]] || return 1
  usedPorts="${usedPorts:+$usedPorts,}$port"
fi

enabled=$(jq -r '.dokodemo.enabled // false' "$settings")
ruleCount=$(jq -r 'if (.dokodemo.rules // []) | type == "array" then (.dokodemo.rules // [] | length) else -1 end' "$settings")
(( ruleCount >= 0 )) || return 1
if [[ $enabled = "true" && $ruleCount -eq 0 ]]; then
  return 1
fi
for (( i=0; i<ruleCount; i++ )); do
  p=$(jq -r --argjson i "$i" '.dokodemo.rules[$i].port // empty' "$settings")
  target=$(jq -r --argjson i "$i" '.dokodemo.rules[$i].target // empty' "$settings")
  targetPort=$(jq -r --argjson i "$i" '.dokodemo.rules[$i].targetPort // empty' "$settings")
  network=$(jq -r --argjson i "$i" '.dokodemo.rules[$i].network // empty' "$settings")
  extra_validPort "$p" && extra_validTargetHost "$target" && extra_validPort "$targetPort" || return 1
  [[ $network = "tcp" || $network = "udp" || $network = "tcp,udp" ]] || return 1
  [[ ",$usedPorts," != *",$p,"* ]] || return 1
  usedPorts="${usedPorts:+$usedPorts,}$p"
done

local mainPort
mainPort=$(extra_mainPort 2>/dev/null || true)
for p in $(printf '%s' "$usedPorts" | tr ',' ' '); do
  [[ -n $p ]] || continue
  [[ $p != "$mainPort" && $p != "9890" && $p != "9891" ]] || return 1
done

return 0
}



