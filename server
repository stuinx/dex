rproxyS_configureTunnel(){
local settings="/opt/de_GWD/RproxyS/settings.json"
local currentPort currentUUID newPort portInput
rproxyS_newSettings || return 1
currentPort=$(jq -r '.tunnel.port // empty' "$settings")
currentUUID=$(jq -r '.tunnel.uuid // empty' "$settings")
[[ -z $currentPort ]] && currentPort="2097"
if ! rproxyS_validUUID "$currentUUID"; then
  currentUUID=$(rproxyS_uuid)
fi

while true; do
  read -r -p "Tunnel port [$currentPort]: " portInput
  newPort="${portInput:-$currentPort}"
  if ! rproxyS_validPort "$newPort"; then
    echo -e "${WHITE}Port${RED} Invalid${cRES}"
    continue
  fi
  if [[ $newPort != "$(jq -r '.tunnel.port // empty' "$settings")" ]] && rproxyS_portInSettings "$newPort"; then
    echo -e "${WHITE}Port${RED} Conflicts with an RproxyS mapping${cRES}"
    continue
  fi
  if ! rproxyS_portAvailable "$newPort" "$currentPort"; then
    echo -e "${WHITE}Port${RED} Already in use${cRES}"
    continue
  fi
  break
done

echo -e "${WHITE}Tunnel UUID${cRES} ${YELLOW}$currentUUID${cRES} (auto-generated or preserved)"
rproxyS_updateSettings --argjson port "$newPort" --arg uuid "$currentUUID" '.tunnel.port=$port | .tunnel.uuid=$uuid' || return 1
rproxyS_apply
}



rproxyS_prepareTunnel(){
local settings="/opt/de_GWD/RproxyS/settings.json"
local tunnelPort tunnelUUID defaultPort=2097
rproxyS_newSettings || return 1
tunnelPort=$(jq -r '.tunnel.port // empty' "$settings")
tunnelUUID=$(jq -r '.tunnel.uuid // empty' "$settings")
if [[ -z $tunnelPort && -z $tunnelUUID ]]; then
  rproxyS_portAvailable "$defaultPort" "" || {
    echo -e "${WHITE}RproxyS${RED} Default tunnel port $defaultPort is unavailable; configure the tunnel first${cRES}"
    return 1
  }
  tunnelUUID=$(rproxyS_uuid)
  rproxyS_updateSettings --argjson port "$defaultPort" --arg uuid "$tunnelUUID" '.tunnel.port=$port | .tunnel.uuid=$uuid' || return 1
fi
}



rproxyS_mappingMenu(){
local settings="/opt/de_GWD/RproxyS/settings.json"
local choice mappingPort mappingProtocol mappingInput mappingNum mappingIndex mappingCount
while true; do
  echo -e "${BLUE}------------------------------------------------ ${cRES}"
  echo -e "${GREEN}RproxyS Port Mapping${cRES}"
  rproxyS_mappingStatus
  echo -e "${GREEN}1. Add mapping${cRES}"
  echo -e "${GREEN}2. List mappings${cRES}"
  echo -e "${GREEN}3. Delete mapping${cRES}"
  echo -e "${GREEN}4. Enable/disable${cRES}"
  echo -e "${GREEN}0. Back${cRES}"
  read -r -p "Select: " choice || return
  case "$choice" in
    2)
      rproxyS_mappingStatus
      ;;
    1)
      rproxyS_prepareTunnel || continue
      rproxyS_requireTunnel || continue
      read -r -p "Public port: " mappingInput
      mappingPort="$mappingInput"
      if ! rproxyS_validPort "$mappingPort"; then
        echo -e "${WHITE}Port${RED} Invalid${cRES}"
        continue
      fi
      if rproxyS_portInSettings "$mappingPort" || ! rproxyS_portAvailable "$mappingPort" ""; then
        echo -e "${WHITE}Port${RED} Already in use${cRES}"
        continue
      fi
      read -r -p "Protocol [tcp,udp] (tcp/udp/tcp,udp): " mappingProtocol
      [[ -z $mappingProtocol ]] && mappingProtocol="tcp,udp"
      if ! rproxyS_validProtocol "$mappingProtocol"; then
        echo -e "${WHITE}Protocol${RED} Invalid${cRES}"
        continue
      fi
      rproxyS_updateSettings --argjson port "$mappingPort" --arg protocol "$mappingProtocol" '.mapping += [{port:$port,protocol:$protocol}] | .mappingStatus="on"' && rproxyS_apply
      ;;
    3)
      rproxyS_requireTunnel || continue
      mappingCount=$(jq -r '.mapping | length' "$settings")
      [[ $mappingCount -gt 0 ]] || { echo -e "${WHITE}Mapping${YELLOW} List is empty${cRES}"; continue; }
      read -r -p "Mapping number: " mappingNum
      [[ $mappingNum =~ ^[0-9]+$ ]] || { echo -e "${WHITE}Number${RED} Invalid${cRES}"; continue; }
      mappingIndex=$((10#$mappingNum - 1))
      (( mappingIndex >= 0 && mappingIndex < mappingCount )) || { echo -e "${WHITE}Number${RED} Invalid${cRES}"; continue; }
      rproxyS_updateSettings --argjson i "$mappingIndex" 'del(.mapping[$i]) | if (.mapping|length)==0 then .mappingStatus="off" else . end' && rproxyS_apply
      ;;
    4)
      rproxyS_requireTunnel || continue
      mappingCount=$(jq -r '.mapping | length' "$settings")
      [[ $mappingCount -gt 0 ]] || { echo -e "${WHITE}Mapping${YELLOW} List is empty${cRES}"; continue; }
      rproxyS_updateSettings '.mappingStatus = (if .mappingStatus == "on" then "off" else "on" end)' && rproxyS_apply
      ;;
    0) return ;;
    *) echo -e "${RED}Wrong number${cRES}" ;;
  esac
done
}



RproxyS(){
if [[ ! -x /opt/de_GWD/vtrui/vtrui ]]; then
  echo -e "${WHITE}RproxyS${RED} Install de_GWD first${cRES}"
  return
fi
while true; do
  rproxyS_show
  echo -e "${GREEN}1. Configure tunnel${cRES}"
  echo -e "${GREEN}2. Manage mappings${cRES}"
  echo -e "${GREEN}3. Apply and start${cRES}"
  echo -e "${GREEN}4. View status${cRES}"
  echo -e "${GREEN}5. Stop service${cRES}"
  echo -e "${GREEN}0. Back${cRES}"
  read -r -p "Select: " num || return
  case "$num" in
    1) rproxyS_configureTunnel ;;
    2) rproxyS_mappingMenu ;;
    3) rproxyS_apply ;;
    4) rproxyS_show ;;
    5) rproxyS_stop ;;
    0) return ;;
    *) echo -e "${RED}Wrong number${cRES}" ;
  esac
done
}



