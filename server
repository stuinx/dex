wireguard_node_removePeer(){
wireguard_node_stateValid || return 1
if systemctl is-active --quiet wg-quick@wgnode 2>/dev/null; then
  echo -e "${WHITE}WireGuard node${YELLOW} Stop the node before removing a peer${cRES}"
  return 1
fi
local count number index peerName peerFile tempState confirm
count=$(jq -r '.peers | length' "$wireguardNodeState")
(( count > 0 )) || { echo -e "${WHITE}WireGuard node${YELLOW} Peer list is empty${cRES}"; return 0; }
wireguard_node_listPeers
read -r -p "Peer number to delete: " number
[[ $number =~ ^[0-9]+$ ]] || return 1
index=$((10#$number - 1))
(( index >= 0 && index < count )) || return 1
peerName=$(jq -r ".peers[$index].name" "$wireguardNodeState")
peerFile=$(jq -r ".peers[$index].config" "$wireguardNodeState")
read -r -p "Type DELETE to confirm removing $peerName: " confirm
[[ $confirm = "DELETE" ]] || return 0
tempState=$(mktemp /tmp/de_GWD-wgnode-state.XXXXXX) || return 1
jq --arg name "$peerName" 'del(.peers[] | select(.name == $name))' "$wireguardNodeState" > "$tempState" || {
  rm -f "$tempState"
  return 1
}
mv -f "$tempState" "$wireguardNodeState" || { rm -f "$tempState"; return 1; }
rm -f "$peerFile"
wireguard_node_writeConfig || return 1
