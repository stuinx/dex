jq -c '.rules' /opt/de_GWD/tcppf.json > /opt/de_GWD/tcppf.json.tmp && mv -f /opt/de_GWD/tcppf.json.tmp /opt/de_GWD/tcppf.json
else
printf '[]\n' > /opt/de_GWD/tcppf.json
fi
fi
chmod 600 /opt/de_GWD/tcppf.json 2>/dev/null
}

tcppf_apply(){
tcppf_ensure_array
unset aptPKG
[[ -z $(dpkg -l | awk '{print$2}' | grep '^haproxy$') ]] && aptPKG+=(haproxy)
[[ -n $aptPKG ]] && apt update && apt install $(echo ${aptPKG[@]})

cat << EOF >/etc/haproxy/haproxy.cfg
# [de_GWD] Managed
global
  ulimit-n              500000
  maxconn               200000

defaults
  mode                  tcp
  option                dontlognull
  timeout connect       10s
  timeout client        1m
  timeout server        1m
  timeout check         10s

resolvers local
  nameserver            dns 127.0.0.1:53
  resolve_retries       3
  timeout retry         3s
  hold valid            10s
  accepted_payload_size 8192
EOF

len=0
[[ -f /opt/de_GWD/tcppf.json ]] && len=$(jq -r 'length' /opt/de_GWD/tcppf.json 2>/dev/null | grep -v '^null$')
for (( i=0; i<$len; i++ )); do
tag=$(jq -r --argjson i $i '.[$i].tag' /opt/de_GWD/tcppf.json | grep -v '^null$')
localPort=$(jq -r --argjson i $i '.[$i].localPort' /opt/de_GWD/tcppf.json | grep -v '^null$')
upDomain=$(jq -r --argjson i $i '.[$i].upDomain' /opt/de_GWD/tcppf.json | grep -v '^null$')
upPort=$(jq -r --argjson i $i '.[$i].upPort' /opt/de_GWD/tcppf.json | grep -v '^null$')
cat << EOF >>/etc/haproxy/haproxy.cfg

frontend $tag
  bind                  :$localPort
  default_backend       $tag

backend $tag
  server endpoint $upDomain:$upPort check resolvers local init-addr none
EOF
done

if /usr/sbin/haproxy -f /etc/haproxy/haproxy.cfg -c -q >/dev/null 2>&1; then
rm -rf /lib/systemd/system/haproxy.service
cat << "EOF" >/etc/systemd/system/haproxy.service
[Unit]
Description=HAProxy
After=network.target rsyslog.service

[Service]
User=root
Type=notify
EnvironmentFile=-/etc/default/haproxy
Environment="CONFIG=/etc/haproxy/haproxy.cfg" "PIDFILE=/run/haproxy.pid"
ExecStartPre=/usr/sbin/haproxy -f $CONFIG -c -q $EXTRAOPTS
ExecStart=/usr/sbin/haproxy -Ws -f $CONFIG -p $PIDFILE $EXTRAOPTS
ExecReload=/usr/sbin/haproxy -f $CONFIG -c -q $EXTRAOPTS
ExecReload=$(which kill) -USR2 $MAINPID
KillMode=mixed
Restart=always
RestartSec=2
TimeoutStopSec=5

[Install]
WantedBy=multi-user.target
EOF
systemctl daemon-reload >/dev/null
systemctl enable haproxy >/dev/null 2>&1
systemctl restart haproxy
echo -e "${WHITE}[ ${GREEN}✓ ${WHITE}]\c" && echo -e "\t${WHITE}TCP Port Forward ${GREEN}Deployed${cRES}"
else
echo -e "${WHITE}[ ${RED}✕ ${WHITE}]\c" && echo -e "\t${WHITE}Invalid HAProxy config, not applied${cRES}"
fi
}

tcppf_add(){
tcppf_ensure_array
if ! tcppf_config_is_managed; then
echo -e "${RED}Refuse: /etc/haproxy/haproxy.cfg is not managed by de_GWD${cRES}"
return
fi

echo -e "${GREEN}======================= ${cRES}"
echo -e "${GREEN}Upstream Domain & Port${cRES}"
echo -e "${GREEN}======================= ${cRES}"
read upDomainP

echo -e "${GREEN}======================= ${cRES}"
echo -e "${GREEN}Local Port${cRES}"
echo -e "${GREEN}======================= ${cRES}"
read localP

upDomain=$(echo $upDomainP | cut -d: -f1)
upPort=$(echo $upDomainP | cut -d: -f2 | grep '^[[:digit:]]*$')
[[ -z $upPort ]] && upPort="443"

if [[ -z $localP ]] || [[ -z $(echo $localP | grep '^[[:digit:]]*$') ]]; then
echo -e "${RED}Invalid local port: $localP${cRES}"
return
fi

if ss -ltn 2>/dev/null | grep -q ":$localP "; then
echo -e "${RED}Local port $localP already in use${cRES}"
return
fi

if [[ -f /opt/de_GWD/tcppf.json ]]; then
if jq -e --arg localP $localP '[.[] | select(.localPort == ($localP|tonumber))] | length > 0' /opt/de_GWD/tcppf.json >/dev/null 2>&1; then
echo -e "${RED}Local port $localP already forwarded${cRES}"
return
fi
tag=$upDomain
if jq -e --arg tag $tag '[.[] | select(.tag == $tag)] | length > 0' /opt/de_GWD/tcppf.json >/dev/null 2>&1; then
tag="$upDomain-$localP"
fi
jq --arg tag $tag --arg localP $localP --arg upDomain $upDomain --arg upPort $upPort '. + [{"tag":$tag,"localPort":($localP|tonumber),"upDomain":$upDomain,"upPort":($upPort|tonumber)}]' /opt/de_GWD/tcppf.json | sponge /opt/de_GWD/tcppf.json
else
tag=$upDomain
jq -n --arg tag $tag --arg localP $localP --arg upDomain $upDomain --arg upPort $upPort '[{"tag":$tag,"localPort":($localP|tonumber),"upDomain":$upDomain,"upPort":($upPort|tonumber)}]' | sponge /opt/de_GWD/tcppf.json
fi
chmod 600 /opt/de_GWD/tcppf.json

tcppf_apply
}

tcppf_del(){
tcppf_ensure_array
if ! tcppf_config_is_managed; then
echo -e "${RED}Refuse: /etc/haproxy/haproxy.cfg is not managed by de_GWD${cRES}"
return
fi
if [[ ! -f /opt/de_GWD/tcppf.json ]] || [[ $(jq -r 'length' /opt/de_GWD/tcppf.json) = "0" ]]; then
echo -e "${RED}No TCP Port Forward rules${cRES}"
return
fi

jq -r 'to_entries[] | "\(.key))  Local :\(.value.localPort|tostring) \t=> \(.value.upDomain):\(.value.upPort|tostring)"' /opt/de_GWD/tcppf.json

echo -e "${GREEN}======================= ${cRES}"
echo -e "${GREEN}Delete rule (number)${cRES}"
echo -e "${GREEN}======================= ${cRES}"
read pfdelnum

if [[ -z $(echo $pfdelnum | grep '^[[:digit:]]*$') ]]; then
echo -e "${RED}Invalid number${cRES}"
return
fi
if [[ $pfdelnum -ge $(jq -r 'length' /opt/de_GWD/tcppf.json) ]]; then
echo -e "${RED}No such rule${cRES}"
return
fi

jq "del(.[$pfdelnum])" /opt/de_GWD/tcppf.json | sponge /opt/de_GWD/tcppf.json

if [[ $(jq -r 'length' /opt/de_GWD/tcppf.json) = "0" ]]; then
rm -rf /opt/de_GWD/tcppf.json
systemctl stop haproxy >/dev/null 2>&1
systemctl disable haproxy >/dev/null 2>&1
rm -rf /etc/haproxy/haproxy.cfg >/dev/null 2>&1
echo -e "${WHITE}[ ${GREEN}✓ ${WHITE}]\c" && echo -e "\t${WHITE}TCP Port Forward ${GREEN}Deleted${cRES}"
else
tcppf_apply
fi
}

