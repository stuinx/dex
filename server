}



changeTCPPF(){
local action listenPort upstreamInput upstream upstreamHost upstreamPort candidate rules shouldRun
while true; do
  haproxy_checkOwnership || return 1
  haproxy_listRules
  echo -e "${GREEN}1. Add forward${cRES}"
  echo -e "${GREEN}2. List rules${cRES}"
  echo -e "${GREEN}3. Delete rule${cRES}"
  echo -e "${GREEN}4. Delete all${cRES}"
  echo -e "${GREEN}0. Back${cRES}"
  read -r -p "Select: " action || return
  case "$action" in
    1)
      read -r -p "Local listen port: " listenPort
      haproxy_validPort "$listenPort" || { echo -e "${WHITE}Port${RED} Invalid${cRES}"; continue; }
      haproxy_ruleExists "$listenPort" && { echo -e "${WHITE}Port${YELLOW} Rule already exists${cRES}"; continue; }
      haproxy_portAvailable "$listenPort" || { echo -e "${WHITE}Port${YELLOW} Already in use${cRES}"; continue; }
      read -r -p "Upstream host:port (IPv6 uses [address]:port): " upstreamInput
      upstream=$(haproxy_parseUpstream "$upstreamInput") || { echo -e "${WHITE}Upstream${RED} Invalid${cRES}"; continue; }
      read -r upstreamHost upstreamPort <<< "$upstream"
      upstream=$(haproxy_formatUpstream "$upstreamHost" "$upstreamPort")
      candidate=$(mktemp /tmp/de_GWD-haproxy-candidate.XXXXXX) || return 1
      if ! haproxy_buildCandidate "" "$listenPort" "$upstream" "$candidate"; then
        rm -f "$candidate"
        echo -e "${WHITE}HAProxy${RED} Existing configuration is not managed by de_GWD${cRES}"
        continue
      fi
      if ! haproxy_ensureInstalled || ! haproxy_applyCandidate "$candidate" 1; then
        rm -f "$candidate"
        continue
      fi
      rm -f "$candidate"
      echo -e "${WHITE}[ ${GREEN}✓ ${WHITE}]\t${WHITE}TCP Port Forward ${GREEN}Deployed${cRES}"
      ;;
    3)
      rules=$(haproxy_extractRules)
      [[ -n $rules ]] || { echo -e "${WHITE}HAProxy${YELLOW} No de_GWD forwarding rules${cRES}"; continue; }
      read -r -p "Local listen port to delete: " listenPort
      haproxy_ruleExists "$listenPort" || { echo -e "${WHITE}Port${YELLOW} Rule not found${cRES}"; continue; }
      candidate=$(mktemp /tmp/de_GWD-haproxy-candidate.XXXXXX) || return 1
      if ! haproxy_buildCandidate "$listenPort" "" "" "$candidate"; then
        rm -f "$candidate"
        continue
      fi
      shouldRun=0
      haproxy_candidateHasListener "$candidate" && shouldRun=1
      if ! haproxy_applyCandidate "$candidate" "$shouldRun"; then
        rm -f "$candidate"
        continue
      fi
      rm -f "$candidate"
      echo -e "${WHITE}[ ${GREEN}✓ ${WHITE}]\t${WHITE}TCP Port Forward ${GREEN}Deleted${cRES}"
      ;;
    4)
      rules=$(haproxy_extractRules)
      [[ -n $rules ]] || { echo -e "${WHITE}HAProxy${YELLOW} No de_GWD forwarding rules${cRES}"; continue; }
      candidate=$(mktemp /tmp/de_GWD-haproxy-candidate.XXXXXX) || return 1
      if ! haproxy_buildCandidate all "" "" "$candidate"; then
        rm -f "$candidate"
        continue
      fi
      shouldRun=0
      haproxy_candidateHasListener "$candidate" && shouldRun=1
      if ! haproxy_applyCandidate "$candidate" "$shouldRun"; then
        rm -f "$candidate"
        continue
      fi
      rm -f "$candidate"
      echo -e "${WHITE}[ ${GREEN}✓ ${WHITE}]\t${WHITE}All de_GWD TCP Port Forwards ${GREEN}Deleted${cRES}"
      ;;
    2)
      haproxy_listRules
      ;;
    0)
      return 0
      ;;
    *)
      echo -e "${RED}Wrong number${cRES}"
      ;;
  esac
done
}
