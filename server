extraRproxyParseMapping(){
local line=$1 tunnelPort=$2 tok port proto mapping='[]'
line=${line//,/ }
for tok in $line; do
  [[ -z $tok ]] && continue
  port=${tok%%/*}
  proto=${tok#*/}
  [[ $proto = "$port" || -z $proto ]] && proto="tcp,udp"
  [[ $proto = "tcp+udp" ]] && proto="tcp,udp"
  [[ $port =~ ^[1-9][0-9]{0,4}$ ]] && (( port <= 65535 )) || continue
  [[ $port = "55443" || $port = "443" || $port = "80" || $port = "$tunnelPort" ]] && continue
  mapping=$(jq --arg p "$port" --arg n "$proto" '. + [{"port":$p,"protocol":$n}]' <<<"$mapping")
done
printf '%s\n' "$mapping"
}

rproxySconf(){
printf '%s\n' "${DE_GWD_DATA_DIR:-/opt/de_GWD}/0conf"
}

rproxyScommit(){
local conf
conf=$(rproxySconf)
[[ -f $conf ]] || echo '{}' >"$conf"
if [[ ${DE_GWD_TEST_MODE:-0} != 1 ]]; then
  chown root:www-data "$conf" 2>/dev/null || true
  chmod 0660 "$conf" 2>/dev/null || true
  rproxySsave || return 1
fi
return 0
}

rproxyStunnelPort(){
jq -r '.FORWARD.Rproxy.server.tunnel.port // empty' "$(rproxySconf)" 2>/dev/null | grep -v '^null$'
}

rproxySaddMapping(){
local conf tunnelPort mapLine add
conf=$(rproxySconf)
tunnelPort=$(rproxyStunnelPort)
[[ -n $tunnelPort ]] || { echo -e "${RED}Set tunnel first${cRES}"; return 1; }
echo -e "${GREEN} Mapping${cRES}"
read mapLine
[[ -n $mapLine ]] || return 1
add=$(extraRproxyParseMapping "$mapLine" "$tunnelPort")
[[ $(jq 'length' <<<"$add") -gt 0 ]] || { echo -e "${RED}Invalid mapping${cRES}"; return 1; }
jq --argjson add "$add" '
  .FORWARD = (.FORWARD // {}) |
  .FORWARD.Rproxy = (.FORWARD.Rproxy // {}) |
  .FORWARD.Rproxy.server.mapping = ((.FORWARD.Rproxy.server.mapping // []) + $add | unique_by(.port|tostring)) |
  .FORWARD.Rproxy.server.mappingStatus = (if (.FORWARD.Rproxy.server.mapping|length)>0 then "on" else "off" end)
' "$conf" | sponge "$conf"
rproxyScommit
}

rproxySdelMapping(){
local conf tunnelPort mapLine del
conf=$(rproxySconf)
tunnelPort=$(rproxyStunnelPort)
jq -r '.FORWARD.Rproxy.server.mapping[]? | "  "+(.port|tostring)+" "+(.protocol // "tcp,udp")' "$conf" 2>/dev/null
echo -e "${GREEN} Mapping to delete, or all${cRES}"
read mapLine
[[ -n $mapLine ]] || return 1
if [[ $mapLine = all ]]; then
  jq '.FORWARD.Rproxy.server.mapping=[] | .FORWARD.Rproxy.server.mappingStatus="off"' "$conf" | sponge "$conf"
else
  del=$(extraRproxyParseMapping "$mapLine" "$tunnelPort")
  jq --argjson del "$del" '
    .FORWARD.Rproxy.server.mapping = ((.FORWARD.Rproxy.server.mapping // []) | map(select((.port|tostring) as $p | ($del | map(.port|tostring) | index($p) | not)))) |
    .FORWARD.Rproxy.server.mappingStatus = (if (.FORWARD.Rproxy.server.mapping|length)>0 then "on" else "off" end)
  ' "$conf" | sponge "$conf"
fi
rproxyScommit
}

rproxySsetTunnel(){
local conf oldPort oldUUID tunnelPort tunnelUUID
conf=$(rproxySconf)
mkdir -p "$(dirname "$conf")"
[[ -f $conf ]] || echo '{}' >"$conf"
oldPort=$(jq -r '.FORWARD.Rproxy.server.tunnel.port // empty' "$conf" 2>/dev/null | grep -v '^null$')
oldUUID=$(jq -r '.FORWARD.Rproxy.server.tunnel.uuid // empty' "$conf" 2>/dev/null | grep -v '^null$')
if [[ -n $oldPort ]]; then
  echo -e "${GREEN} Tunnel port  (empty = $oldPort)${cRES}"
else
  echo -e "${GREEN} Tunnel port${cRES}"
fi
read tunnelPort
[[ -z $tunnelPort ]] && tunnelPort="$oldPort"
[[ -n $tunnelPort ]] || { echo -e "${RED}Invalid port${cRES}"; return 1; }
if [[ $tunnelPort = "55443" || $tunnelPort = "443" || $tunnelPort = "80" ]]; then
  echo -e "${RED}$tunnelPort is nginx${cRES}"
  return 1
fi
if [[ -n $oldUUID ]]; then
  echo -e "${GREEN} Tunnel UUID  (empty = $oldUUID)${cRES}"
else
  echo -e "${GREEN} Tunnel UUID  (empty = generate)${cRES}"
fi
read tunnelUUID
[[ -z $tunnelUUID ]] && tunnelUUID="${oldUUID:-$(cat /proc/sys/kernel/random/uuid)}"
[[ -n $tunnelUUID ]] || { echo -e "${RED}Invalid UUID${cRES}"; return 1; }
jq --arg port "$tunnelPort" --arg uuid "$tunnelUUID" '
  .FORWARD = (.FORWARD // {}) |
  .FORWARD.Rproxy = (.FORWARD.Rproxy // {}) |
  .FORWARD.Rproxy.server.inStatus = (.FORWARD.Rproxy.server.inStatus // "off") |
  .FORWARD.Rproxy.server.inUUID = (.FORWARD.Rproxy.server.inUUID // []) |
  .FORWARD.Rproxy.server.mapping = (.FORWARD.Rproxy.server.mapping // []) |
  .FORWARD.Rproxy.server.mappingStatus = (if (.FORWARD.Rproxy.server.mapping|length)>0 then "on" else "off" end) |
  .FORWARD.Rproxy.server.tunnel.port = $port |
  .FORWARD.Rproxy.server.tunnel.uuid = $uuid
' "$conf" | sponge "$conf"
rproxyScommit
}

installRproxyS(){
local rps domain
while true; do
echo -e "${GREEN}================================ ${cRES}"
echo -e "${GREEN} 22. RproxyS${cRES}"
echo -e "${GREEN}[1]: Status${cRES}"
echo -e "${GREEN}[2]: Tunnel${cRES}"
echo -e "${GREEN}[3]: Add mapping${cRES}"
echo -e "${GREEN}[4]: Delete mapping${cRES}"
echo -e "${GREEN}[5]: Stop${cRES}"
echo -e "${GREEN}[0]: Back${cRES}"
echo -e "${GREEN}================================ ${cRES}"
read -s -n 1 rps
echo
case "$rps" in
  0|"") return ;;
  1) rproxySstatus ;;
  2)
    rproxySsetTunnel || continue
    domain=$(awk '/server_name/ {print$2;exit}' /etc/nginx/conf.d/default.conf 2>/dev/null | sed 's/.$//')
    echo -e "${WHITE}[ ${GREEN}✓ ${WHITE}]\c" && echo -e "\t${WHITE}RproxyS ${GREEN}Tunnel${cRES}"
    echo -e "${GREEN} Client RproxyC: ${YELLOW}${domain}:$(rproxyStunnelPort)${cRES}"
    echo -e "${GREEN} UUID: ${YELLOW}$(jq -r '.FORWARD.Rproxy.server.tunnel.uuid' "$(rproxySconf)")${cRES}"
    ;;
  3)
    rproxySaddMapping || continue
    echo -e "${WHITE}[ ${GREEN}✓ ${WHITE}]\c" && echo -e "\t${WHITE}RproxyS mapping ${GREEN}Added${cRES}"
    ;;
  4)
    rproxySdelMapping || continue
    echo -e "${WHITE}[ ${GREEN}✓ ${WHITE}]\c" && echo -e "\t${WHITE}RproxyS mapping ${GREEN}Deleted${cRES}"
    ;;
  5) rproxySstop ;;
  *) echo -e "${RED}Wrong number${cRES}" ;;
esac
done
}


