if ! command -v sponge >/dev/null 2>&1; then
  sponge(){
    local out=$1 t
    t=$(mktemp) || return 1
    cat >"$t" || { rm -f "$t"; return 1; }
    cat "$t" >"$out"
    local rc=$?
    rm -f "$t"
    return $rc
  }
fi

# Same shape as main VMess: upstream sits next to `upstream xray` (outside server {}).
extraJsonEnabled(){
local f=$1
