[[ $(jq -r '.enabled // false' "$f" 2>/dev/null) = "true" ]]
}

extraVlessWsNginxUpstream(){
extraJsonEnabled "$DE_GWD_DATA_DIR/extra-vlessws.json" || return 0
[[ -n $(jq -r '.path // empty' "$DE_GWD_DATA_DIR/extra-vlessws.json") ]] || return 0
cat << EOF
upstream vlessws {
    server 127.0.0.1:9891;
    keepalive 32;
}
EOF
}

# Same as installGWD: `domain` or `domain:port` (no port => 443).
extraParseInstallAddr(){
local vpsdomainP=$1 d p
[[ -n $vpsdomainP ]] || return 1
d=$(echo "$vpsdomainP" | cut -d: -f1)
p=$(echo "$vpsdomainP" | cut -d: -f2 | grep '^[[:digit:]]*$')
[[ -n $d && -n $p && $vpsdomainP == *:* ]] || return 1
[[ $p =~ ^[1-9][0-9]{0,4}$ ]] && (( p <= 65535 )) || return 1
printf '%s %s\n' "$d" "$p"
}

extraVlessWsNginxLocation(){
local vlessPath=$1
cat << EOF
location $vlessPath {
  if (\$http_upgrade != "websocket") { return 404; }
  proxy_pass                  http://vlessws;
  proxy_http_version          1.1;
  proxy_set_header            Host \$host;
  proxy_set_header            Upgrade "websocket";
  proxy_set_header            Connection "upgrade";
  proxy_set_header            X-Real-IP \$remote_addr;
  proxy_set_header            X-Real-PORT \$remote_port;
  proxy_set_header            X-Forwarded-For \$proxy_add_x_forwarded_for;
  proxy_connect_timeout       600;
  proxy_read_timeout          600;
  proxy_send_timeout          600;
  chunked_transfer_encoding   off;
  proxy_redirect              off;
  proxy_store                 off;
  proxy_cache                 off;
  proxy_buffering             off;
  proxy_buffer_size           4k;
  proxy_busy_buffers_size     16k;
  proxy_buffers               4 16k;
  add_header Cache-Control no-cache;
}
EOF
}

# Standalone vhost: /etc/nginx/conf.d/vless-ws.conf (not mixed into default.conf).
extraVlessWsNginxConf(){
